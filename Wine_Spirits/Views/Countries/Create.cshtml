@model Wine_Spirits.Models.Country
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Yeni Ülke";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="card-title text-center mb-0">Yeni Ülke Oluştur</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:block;"></div>
                        
                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control" id="countryNameInput" placeholder="Ülke Adı" />
                            <label for="countryNameInput">Ülke Adı (Örn: Fransa, İtalya)</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2">
                                <i data-lucide="save" class="me-1" style="width: 18px; vertical-align: text-bottom;"></i>
                                Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                                Vazgeç ve Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
