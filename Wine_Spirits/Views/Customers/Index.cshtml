@using Wine_Spirits.Models.ViewModels
@model Wine_Spirits.Models.ViewModels.CustomersIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Müşteri Yönetimi (CRM)";
    Layout = "_Layout";
}

@section Styles {
    @* Sayfaya özel stiller *@
    <link rel="stylesheet" href="~/css/customer/customer.css" asp-append-version="true" />
}

<div class="ws-customer-container">
    @* 
        SAYFA BAŞLIĞI 
        Global .ws-page-header sınıfı kullanılarak ürünler ve siparişler sayfasıyla uyum sağlandı.
    *@
    <div class="ws-page-header mb-4">
        <div>
            <h2 class="ws-page-title">Müşteri Yönetimi</h2>
            <p class="ws-page-subtitle">Müşteri portföyünüzü ve ticari bilgileri yönetin.</p>
        </div>
        <button type="button" class="ws-btn-primary shadow-sm" id="btnCreateCustomer" data-bs-toggle="modal" data-bs-target="#createCustomerModal">
            <i data-lucide="user-plus" class="ws-icon-16"></i> Yeni Müşteri Ekle
        </button>
    </div>

    @* 
        STATCARD V2 PANELİ
        _StatCard.cshtml bileşeni ve site.css'deki .ws-stat-card-v2 sınıfları kullanıldı.
        Soft renkler ve Lucide ikonları Figma tasarımına (image_8aae41.png) uygun olarak eklendi.
    *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalCustomers", Label = "Toplam Müşteri", Value = Model.Stats.TotalCustomers.ToString(), Icon = "users", IconClass = "bg-gray-100 text-gray-900" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "activeCustomers", Label = "Aktif Müşteri", Value = Model.Stats.ActiveCustomers.ToString(), Icon = "user-check", IconClass = "bg-emerald-50 text-emerald-600" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalOrders", Label = "Toplam Sipariş", Value = Model.Stats.TotalOrders.ToString(), Icon = "package", IconClass = "bg-primary-50 text-primary-600" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalRevenue", Label = "Toplam Ciro", Value = Model.Stats.TotalRevenue, Icon = "trending-up", IconClass = "bg-violet-50 text-violet-600" }' />
        </div>
    </div>

    @* 
        GLOBAL: Siparişler sayfasındaki filtre ve buton modeli uygulandı 
        MODERN FİLTRELEME KONTEYNERİ (V3.0)
        Figma (image_8b8edf.png) tasarımına sadık kalınarak flex ve ikonlu yapı kuruldu.
    *@
    <div class="ws-filter-container">
        @* Arama *@
        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="search"></i></span>
            <input type="text" class="ws-input-control" placeholder="Müşteri ara..." id="customerSearch">
        </div>

        @* Durum Filtresi (İkonlu Dropdown) *@
        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="filter"></i></span>
            <select class="ws-input-control ws-select-control" id="filterStatus">
                <option value="">Tüm Durumlar...</option>
                <option value="active">Aktif</option>
                <option value="inactive">Pasif</option>
            </select>
        </div>

        @* Tarih Aralığı (Flatpickr - Range Mode) *@
        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="calendar"></i></span>
            <input type="text" class="ws-input-control flatpickr-date" id="filterDate" placeholder="Tarih Aralığı Seçin" readonly>
        </div>

        @* Filtrele / Sırala Butonu (Premium) *@
        <div class="ws-filter-item">
            <div class="dropdown">
                <button class="ws-btn-modern-filter dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="d-flex align-items-center gap-2">
                        <i data-lucide="sliders-horizontal" class="ws-icon-18"></i>
                        Filtrele / Sırala
                    </span>
                    <i data-lucide="chevron-down" class="ws-icon-16 opacity-50"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                    <li><h6 class="dropdown-header">Sıralama</h6></li>
                    <li><a class="dropdown-item active" href="#">A'dan Z'ye</a></li>
                    <li><a class="dropdown-item" href="#">Z'den A'ya</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">En Yüksek Ciro</a></li>
                    <li><a class="dropdown-item" href="#">Son Eklenenler</a></li>
                </ul>
            </div>
        </div>
    </div>

    @* MÜŞTERİ LİSTESİ TABLOSU *@
    <div class="ws-table-card">
        <div class="table-responsive">
            <table class="table ws-custom-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">MÜŞTERİ KODU</th>
                        <th>MÜŞTERİ ADI</th>
                        <th>İLETİŞİM</th>
                        <th>ADRES</th>
                        <th>VERGİ BİLGİLERİ</th>
                        <th>SİPARİŞ/HARCAMA</th>
                        <th>DURUM</th>
                        <th class="text-end pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody id="customersTableBody">
                    @foreach (var customer in Model.Customers)
                    {
                        @* BURADA: JS tarafında tarih aralığı filtresi için CreatedDate data attribute olarak ekleniyor *@
                        <tr data-date="@customer.CreatedDate.ToString("yyyy-MM-dd")">
                            <td class="ps-4">
                                <span class="text-muted small fw-medium">#@customer.Id.ToString().Substring(0, 8).ToUpper()</span>
                            </td>
                            <td>
                                <div class="fw-semibold">@customer.Name @customer.Lastname</div>
                            </td>
                            <td>
                                <span class="ws-info-main">@customer.Email</span>
                                <span class="ws-info-sub">@customer.Phone</span>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 200px;" title="@customer.Adress">
                                    @customer.Adress
                                </div>
                            </td>
                            <td>
                                <span class="ws-info-main">@customer.TaxOffice</span>
                                <span class="ws-info-sub">No: @customer.TaxNumber</span>
                            </td>
                            <td>
                                @{
                                    var orderCount = customer.Orders.Count;
                                    var totalSpent = customer.Orders.SelectMany(o => o.OrderDetails).Sum(od => od.TotalPrice);
                                }
                                <span class="ws-info-main">@orderCount Adet</span>
                                <span class="ws-info-sub text-primary fw-medium">@totalSpent.ToString("C2", new System.Globalization.CultureInfo("tr-TR"))</span>
                            </td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="ws-badge ws-badge-soft-green" id="badge-@customer.Id">
                                        <i data-lucide="check-circle" class="ws-icon-16"></i> Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="ws-badge ws-badge-soft-passive" id="badge-@customer.Id">
                                        <i data-lucide="minus-circle" class="ws-icon-16"></i> Pasif
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="ws-action-container">
                                    @* GLOBAL: Görüntüle kaldırıldı, yerine Aktif/Pasif Power ikonu eklendi *@
                                    <button class="ws-action-btn btn-toggle-status" data-id="@customer.Id" title="@(customer.IsActive ? "Pasife Al" : "Aktife Al")">
                                        <i data-lucide="power" class="ws-icon-16 @(customer.IsActive ? "btn-status-active" : "btn-status-passive")"></i>
                                    </button>
                                    <button class="ws-action-btn" title="Düzenle"><i data-lucide="edit-3" class="ws-icon-16"></i></button>
                                    <button class="ws-action-btn text-danger btn-delete-customer" data-id="@customer.Id" title="Sil"><i data-lucide="trash-2" class="ws-icon-16"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                    @if (!Model.Customers.Any())
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i data-lucide="users" class="mb-2" style="width: 48px; height: 48px; opacity: 0.1;"></i>
                                <p>Henüz kayıtlı müşteri bulunmuyor.</p>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* 
    YENİ MÜŞTERİ EKLE MODALI (image_8b7f61.png)
    Figma tasarımındaki 50-50 yerleşimli yapı pürüzsüzce uygulandı.
*@
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow-lg">
            <div class="modal-header border-bottom-0 pb-0 pe-4 pt-4">
                <h5 class="modal-title fw-bold">Yeni Müşteri Ekle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-4">
                <form id="createCustomerForm">
                    @* BURADA: CSRF güvenliği için token ekleniyor *@
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Müşteri Adı / Soyad / Firma</label>
                        <div class="ws-input-group">
                            <input type="text" name="Name" class="ws-input-control" placeholder="Müşteri adını girin" required>
                        </div>
                    </div>
                    @* GLOBAL: 50-50 Yan yana yerleşim (E-posta / Telefon) *@
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">E-posta</label>
                            <input type="email" name="Email" class="ws-input-control" placeholder="E-posta adresi">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Telefon</label>
                            <input type="tel" name="Phone" class="ws-input-control" placeholder="Telefon numarası">
                        </div>
                    </div>
                    @* GLOBAL: 50-50 Yan yana yerleşim (Vergi Bilgileri) *@
                    <div class="row g-3 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vergi Numarası</label>
                            <input type="number" name="TaxNumber" class="ws-input-control" placeholder="Vergi numarası">
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Vergi Dairesi</label>
                            <input type="text" name="TaxOffice" class="ws-input-control" placeholder="Vergi dairesi">
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label small fw-semibold">Adres</label>
                        <textarea name="Adress" class="ws-input-control" style="height: 100px; padding-top: 12px; white-space: normal;" placeholder="Tam adres bilgisini girin"></textarea>
                    </div>
                    <div class="ws-modal-footer">
                        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">İptal</button>
                        <button type="submit" class="ws-btn-primary">Müşteri Ekle</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Sayfaya özel scriptler için harici JS (Global Kural: Inline script yasak) *@
    <script src="~/js/customer/customer.js" asp-append-version="true"></script>
}
