@using Wine_Spirits.Models.ViewModels
@model Wine_Spirits.Models.ViewModels.CustomersIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Müşteri Yönetimi (CRM)";
    Layout = "_Layout";
    var culture = new System.Globalization.CultureInfo("tr-TR");
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/customer.css" asp-append-version="true" />
}

<div class="ws-customer-container">
    <div class="ws-page-header mb-4">
        <div>
            <h2 class="ws-page-title">Müşteri Yönetimi</h2>
            <p class="ws-page-subtitle">Müşteri portföyünüzü ve ticari bilgileri yönetin.</p>
        </div>
        <button type="button" class="ws-btn-primary shadow-sm" id="btnCreateCustomer">
            <i data-lucide="user-plus" class="ws-icon-16"></i> Yeni Müşteri Ekle
        </button>
    </div>

    @* İstatistik Kartları: Modern Grid Yapısı *@
    <div class="ws-stats-grid mb-4">
        <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalCustomers", Label = "Toplam Müşteri", Value = Model.Stats.TotalCustomers.ToString(), Icon = "users", IconClass = "bg-gray-100 text-gray-900" }' />
        <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "activeCustomers", Label = "Aktif Müşteri", Value = Model.Stats.ActiveCustomers.ToString(), Icon = "user-check", IconClass = "bg-emerald-50 text-emerald-600" }' />
        <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalOrders", Label = "Toplam Sipariş", Value = Model.Stats.TotalOrders.ToString(), Icon = "package", IconClass = "bg-primary-50 text-primary-600" }' />
        <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalRevenue", Label = "Toplam Ciro", Value = Model.Stats.TotalRevenue, Icon = "trending-up", IconClass = "bg-violet-50 text-violet-600" }' />
    </div>

    <div class="ws-filter-container">
        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="search"></i></span>
            <input type="text" class="ws-input-control" placeholder="Müşteri ara..." id="customerSearch">
        </div>

        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="filter"></i></span>
            <select class="ws-input-control ws-select-control" id="filterStatus">
                <option value="">Tüm Durumlar...</option>
                <option value="active">Aktif</option>
                <option value="inactive">Pasif</option>
            </select>
        </div>

        <div class="ws-input-group">
            <span class="ws-input-icon"><i data-lucide="calendar"></i></span>
            <input type="text" class="ws-input-control ws-datepicker" id="filterDate" placeholder="Tarih Aralığı Seçin" readonly>
        </div>

        <div class="ws-filter-item">
            <div class="dropdown">
                <button class="ws-btn-modern-filter dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <span class="d-flex align-items-center gap-2">
                        <i data-lucide="sliders-horizontal" class="ws-icon-18"></i>
                        Filtrele / Sırala
                    </span>
                    <i data-lucide="chevron-down" class="ws-icon-16 opacity-50"></i>
                </button>
                <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                    <li><h6 class="dropdown-header">Sıralama</h6></li>
                    <li><a class="dropdown-item active" href="#">A'dan Z'ye</a></li>
                    <li><a class="dropdown-item" href="#">Z'den A'ya</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="#">En Yüksek Ciro</a></li>
                    <li><a class="dropdown-item" href="#">Son Eklenenler</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="ws-table-card">
        <div class="table-responsive">
            <table class="table ws-custom-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">MÜŞTERİ KODU</th>
                        <th>MÜŞTERİ ADI</th>
                        <th>İLETİŞİM</th>
                        <th>ADRES</th>
                        <th>VERGİ BİLGİLERİ</th>
                        <th>SİPARİŞ/HARCAMA</th>
                        <th>DURUM</th>
                        <th class="text-end pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody id="customersTableBody">
                    @foreach (var customer in Model.Customers)
                    {
                        <tr data-date="@customer.CreatedDate.ToString("yyyy-MM-dd")">
                            <td class="ps-4">
                                <span class="text-muted small fw-medium">#@customer.Id.ToString().Substring(0, 8).ToUpper()</span>
                            </td>
                            <td><div class="fw-semibold">@customer.Name @customer.Lastname</div></td>
                            <td>
                                <span class="ws-info-main">@customer.Email</span>
                                <span class="ws-info-sub">@customer.Phone</span>
                            </td>
                            <td>
                                <div class="text-truncate" style="max-width: 200px;" title="@customer.Adress">@customer.Adress</div>
                            </td>
                            <td>
                                <span class="ws-info-main">@customer.TaxOffice</span>
                                <span class="ws-info-sub">No: @customer.TaxNumber</span>
                            </td>
                            <td>
                                @{
                                    var orderCount = customer.Orders?.Count ?? 0;
                                    var totalSpent = customer.Orders?.SelectMany(o => o.OrderDetails).Sum(od => (decimal?)od.TotalPrice) ?? 0;
                                }
                                <span class="ws-info-main">@orderCount Adet</span>
                                <span class="ws-info-sub text-primary fw-medium">@totalSpent.ToString("C2", culture)</span>
                            </td>
                            <td>
                                @if (customer.IsActive)
                                {
                                    <span class="ws-badge ws-badge-soft-green" id="badge-@customer.Id">
                                        <i data-lucide="check-circle" class="ws-icon-16"></i> Aktif
                                    </span>
                                }
                                else
                                {
                                    <span class="ws-badge ws-badge-soft-passive" id="badge-@customer.Id">
                                        <i data-lucide="minus-circle" class="ws-icon-16"></i> Pasif
                                    </span>
                                }
                            </td>
                            <td class="text-end pe-4">
                                <div class="ws-action-container">
                                    <button class="ws-action-btn btn-toggle-status" data-id="@customer.Id" title="@(customer.IsActive ? "Pasife Al" : "Aktife Al")">
                                        <i data-lucide="power" class="ws-icon-16 @(customer.IsActive ? "btn-status-active" : "btn-status-passive")"></i>
                                    </button>
                                    <button class="ws-action-btn" title="Düzenle"><i data-lucide="edit-3" class="ws-icon-16"></i></button>
                                    <button class="ws-action-btn text-danger btn-delete-customer" data-id="@customer.Id" title="Sil"><i data-lucide="trash-2" class="ws-icon-16"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@* Modal ve Script bölümleri aynı kalabilir *@
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ws-card border-0 shadow-lg"></div>
    </div>
</div> 

@section Scripts {
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/customer/customer.js" asp-append-version="true"></script>
}