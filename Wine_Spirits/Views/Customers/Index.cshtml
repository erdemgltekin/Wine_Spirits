@using Wine_Spirits.Models.ViewModels
@model Wine_Spirits.Models.ViewModels.CustomersIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Müşteri Yönetimi (CRM)";
    Layout = "_Layout";
    var culture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="ws-customers-container">
    @* --- ÜST BAŞLIK --- *@
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Müşteri Yönetimi</h2>
            <p class="ws-page-subtitle">Müşteri portföyünüzü ve ticari bilgileri yönetin.</p>
        </div>
        <div class="ws-header-actions">
            @* JS: closest('#btnCreateCustomer') bunu bekliyor *@
            <button type="button" class="ws-btn-main" id="btnCreateCustomer">
                <i data-lucide="user-plus"></i>
                <span>Yeni Müşteri Ekle</span>
            </button>
        </div>
    </header>

    @* --- İSTATİSTİK KARTLARI (ws-stat-card mimarisi) --- *@
    <div class="ws-stats-grid">
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo"><i data-lucide="users"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Müşteri</span>
                <span class="ws-stat-value">@Model.Stats.TotalCustomers</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald"><i data-lucide="user-check"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Müşteri</span>
                <span class="ws-stat-value">@Model.Stats.ActiveCustomers</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-blue"><i data-lucide="package"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Sipariş</span>
                <span class="ws-stat-value">@Model.Stats.TotalOrders</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose"><i data-lucide="trending-up"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Ciro</span>
                <span class="ws-stat-value">@Model.Stats.TotalRevenue</span>
            </div>
        </div>
    </div>

    @* --- FİLTRELEME BARI (_filters.scss uyumlu) --- *@
    <div class="ws-filter-container">
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" class="ws-filter-el" placeholder="Müşteri ara..." id="customerSearch">
        </div>

        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            <input type="text" class="ws-filter-el ws-datepicker" id="filterDate" data-mode="range" placeholder="Kayıt Tarihi" readonly>
        </div>

        @* Dropdown: _dropdowns.scss içindeki .ws-dropdown-premium yapısı *@
        <div class="dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="filter"></i>
                <div class="ws-filter-el">
                    <span id="selectedStatusText">Durum</span>
                    <i data-lucide="chevron-down" class="ws-filter-chevron"></i>
                </div>
            </div>
            <div class="dropdown-menu ws-dropdown-premium">
                <div class="ws-dropdown-option active" onclick="document.getElementById('filterStatus').value=''; filterTable();">
                    <i data-lucide="layers"></i> Tüm Durumlar
                </div>
                <div class="ws-dropdown-option" onclick="document.getElementById('filterStatus').value='active'; filterTable();">
                    <i data-lucide="user-check"></i> Aktifler
                </div>
                <div class="ws-dropdown-option" onclick="document.getElementById('filterStatus').value='inactive'; filterTable();">
                    <i data-lucide="user-minus"></i> Pasifler
                </div>
            </div>
            <input type="hidden" id="filterStatus" value="">
        </div>
    </div>

    @* --- TABLO (_tables.scss uyumlu) --- *@
    <div class="ws-table-wrapper">
        <table class="ws-table-premium" id="reportTable">
            <thead>
                <tr>
                    <th class="ps-4">MÜŞTERİ KODU</th>
                    <th>MÜŞTERİ BİLGİSİ</th>
                    <th>İLETİŞİM</th>
                    <th>VERGİ BİLGİLERİ</th>
                    <th class="text-center">DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody id="customersTableBody">
                @foreach (var customer in Model.Customers)
                {
                    @* HATA ÇÖZÜMÜ: Eğer modelinde tarih yoksa data-date="" olarak kalabilir *@
                    <tr data-date="">
                        <td class="ps-4">
                            <strong class="ws-td-id">#@customer.Id.ToString().Substring(0, 8).ToUpper()</strong>
                        </td>
                        <td>
                            <div class="ws-order-info-cell">
                                <div class="avatar-circle">@customer.Name[0]@customer.Lastname[0]</div>
                                <div class="ws-order-texts">
                                    <span class="ws-td-main-text">@customer.Name @customer.Lastname</span>
                                </div>
                            </div>
                        </td>
                        <td>
                            <div class="ws-info-stack">
                                <span class="ws-td-main-text">@customer.Email</span>
                                <small class="ws-td-sub-text">@customer.Phone</small>
                            </div>
                        </td>
                        <td>
                            <div class="ws-info-stack">
                                <span class="ws-td-main-text">@customer.TaxOffice</span>
                                <small class="ws-td-sub-text">No: @customer.TaxNumber</small>
                            </div>
                        </td>
                        <td class="text-center">
                            @* JS: badge-${id} üzerinden güncelleme yapar *@
                            <span id="badge-@customer.Id" class="ws-status-pill @(customer.IsActive ? "ws-status-success" : "ws-status-warning")">
                                <i data-lucide="@(customer.IsActive ? "check-circle" : "minus-circle")"></i>
                                @(customer.IsActive ? "Aktif" : "Pasif")
                            </span>
                        </td>
                        <td class="text-end pe-4">
                            <div class="ws-table-actions">
                                @* JS'deki .btn-toggle-status ve .btn-delete-customer sınıfları eklendi *@
                                <button class="ws-action-btn btn-toggle-status" data-id="@customer.Id">
                                    <i data-lucide="power" class="@(customer.IsActive ? "text-success" : "text-muted")"></i>
                                </button>
                                <button class="ws-action-btn btn-delete-customer" data-id="@customer.Id">
                                    <i data-lucide="trash-2" class="text-danger"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@* Modal Yapısı - _modals.scss ve JS uyumlu *@
<div class="modal fade" id="createCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        @* ws-modal-custom sınıfı _modals.scss içindeki premium tasarımı tetikler *@
        <div class="modal-content ws-modal-custom">
            @* AJAX ile yüklenecek *@
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/customer/customer.js" asp-append-version="true"></script>
}