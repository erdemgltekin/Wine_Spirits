@model IEnumerable<Wine_Spirits.Models.Customer>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Müşteri Yönetimi";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/customer/customers.css" asp-append-version="true" />
}

<div class="container-fluid py-4">

    @* Enterprise Tag Helper: Page Header *@
    <ws-page-header title="Müşteri Yönetimi" subtitle="Müşteri portföyünüzü yönetin, ilişkilerinizi güçlendirin. Toplam @Model.Count() kayıtlı müşteri ile büyümeye devam edin.">
        <a asp-action="Create" class="ws-btn ws-btn-primary shadow-sm" data-drawer="true" data-title="Yeni Müşteri Tanımla">
            <i data-lucide="user-plus"></i> Müşteri Ekle
        </a>
    </ws-page-header>

    @* Stats Grid *@
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <ws-stat-card 
                label="Toplam Müşteri" 
                value="@ViewData["TotalCustomers"]" 
                icon="users" 
                icon-class="bg-indigo-50 text-indigo-600" 
                info="Sistemde kayıtlı tüm müşterileriniz - her biri işletmenizin değerli bir parçası" />
        </div>
        <div class="col-md-4">
            <ws-stat-card 
                label="Aktif Müşteri" 
                value="@ViewData["ActiveCustomers"]" 
                icon="user-check" 
                icon-class="bg-emerald-50 text-emerald-600" 
                info="İletişim bilgileri eksiksiz müşteriler - pazarlama kampanyalarınız için hazır" />
        </div>
        <div class="col-md-4">
            <ws-stat-card 
                label="Yeni Müşteri (Bu Ay)" 
                value="0" 
                icon="trending-up" 
                icon-class="bg-blue-50 text-blue-600" 
                info="Bu ay sisteme eklenen yeni müşteriler - büyüme hızınızın göstergesi" />
        </div>
    </div>

    @* Search Box *@
    <div class="row g-4 mb-4">
        <div class="col-md-12">
            <div class="ws-card">
                <div class="card-body p-3">
                    <div class="input-group ws-search-box">
                        <span class="input-group-text">
                            <i data-lucide="search" class="ws-search-icon"></i>
                        </span>
                        <input type="text" id="customerSearchInput" class="form-control" placeholder="Müşteri adı, soyadı veya e-posta ara..." autocomplete="off">
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* Data Table *@
    <div class="ws-card">
        <div id="customersTableContainer">
            <div class="ws-table-container">
                <table class="table ws-customer-table" id="customersTable">
                    <thead>
                        <tr>
                            <th>Müşteri Bilgisi</th>
                            <th>İletişim</th>
                            <th>Adres</th>
                            <th>Vergi Bilgileri</th>
                            <th class="text-end">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="ws-user-avatar">
                                            <i data-lucide="user"></i>
                                        </div>
                                        <div class="ws-customer-info">
                                            <div class="customer-name">@item.Name @item.Lastname</div>
                                            <div class="customer-id">#@item.Id.ToString().Substring(0,8)</div>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="ws-contact-info">
                                        <div class="contact-primary">@item.Email</div>
                                        <div class="contact-secondary">@item.Phone</div>
                                    </div>
                                </td>
                                <td>
                                    <span class="text-muted small">@item.Adress</span>
                                </td>
                                <td>
                                    <div class="ws-contact-info">
                                        <div class="contact-primary">@item.TaxOffice</div>
                                        <div class="contact-secondary">No: @item.TaxNumber</div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="ws-action-btn" data-drawer="true" data-title="Müşteri Bilgilerini Düzenle" title="Müşteri bilgilerini güncelleyin (ad, iletişim, vergi bilgileri)">
                                            <i data-lucide="pencil"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="ws-action-btn btn-delete" title="Müşteriyi sistemden kalıcı olarak siler (geri alınamaz)">
                                            <i data-lucide="trash-2"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i data-lucide="user-x" class="text-muted opacity-25"></i>
                    </div>
                    <h5 class="text-dark">Henüz kayıtlı müşteri bulunmuyor.</h5>
                    <a asp-action="Create" class="ws-btn ws-btn-primary px-4" data-drawer="true" data-title="Yeni Müşteri Tanımla">
                        İlk Müşteriyi Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#customerSearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#customersTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });

            if (typeof lucide !== 'undefined') lucide.createIcons();
        });
    </script>
}
