@model Wine_Spirits.Models.Customer
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@* ─── MODAL HEADER ─── *@
<div class="ws-modal-header">
    <h5 class="ws-modal-title">Yeni Müşteri Ekle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
        <i data-lucide="x"></i>
    </button>
</div>

@* ─── FORM ─── *@
<form asp-action="Create" id="createCustomerForm" method="post" autocomplete="off">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="ModelOnly" class="ws-error-panel ws-error-panel--hidden"></div>

    <div class="ws-modal-body">

        @* Row 1 — Ad: full-width via :first-child SCSS rule *@
        <div class="ws-form-group">
            <label asp-for="Name" class="ws-form-label">Ad *</label>
            <input asp-for="Name"
                   class="ws-input-premium"
                   placeholder="Müşteri adı"
                   required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        @* Row 2: Sol — Soyad *@
        <div class="ws-form-group">
            <label asp-for="Lastname" class="ws-form-label">Soyad *</label>
            <input asp-for="Lastname"
                   class="ws-input-premium"
                   placeholder="Müşteri soyadı"
                   required />
            <span asp-validation-for="Lastname" class="text-danger"></span>
        </div>

        @* Row 2: Sağ — E-Posta *@
        <div class="ws-form-group">
            <label asp-for="Email" class="ws-form-label">E-Posta</label>
            <input asp-for="Email"
                   type="email"
                   class="ws-input-premium"
                   placeholder="kurum@mail.com" />
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        @* Row 3: Sol — Telefon *@
        <div class="ws-form-group">
            <label asp-for="Phone" class="ws-form-label">Telefon *</label>
            <input asp-for="Phone"
                   class="ws-input-premium"
                   placeholder="05XX XXX XX XX"
                   required />
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        @* Row 3: Sağ — Vergi Dairesi *@
        <div class="ws-form-group">
            <label asp-for="TaxOffice" class="ws-form-label">Vergi Dairesi</label>
            <input asp-for="TaxOffice"
                   class="ws-input-premium"
                   placeholder="Vergi Dairesi" />
        </div>

        @* Row 4: Sol — Vergi No *@
        <div class="ws-form-group">
            <label asp-for="TaxNumber" class="ws-form-label">Vergi No</label>
            <input asp-for="TaxNumber"
                   type="number"
                   class="ws-input-premium"
                   placeholder="000000" />
        </div>

        @* Row 4: Sağ — blank (Adres will span below) *@
        <div class="ws-form-group ws-form-group--full">
            <label asp-for="Adress" class="ws-form-label">Adres Detayları *</label>
            <textarea asp-for="Adress"
                      class="ws-input-premium ws-textarea"
                      rows="2"
                      placeholder="Açık adres bilgilerini buraya giriniz..."
                      required></textarea>
            <span asp-validation-for="Adress" class="text-danger"></span>
        </div>

    </div>@* /.ws-modal-body *@

    @* ─── FOOTER ACTIONS ─── *@
    <div class="ws-form-actions">
        <button type="button" class="ws-btn-secondary" id="closeSidePanel">Vazgeç</button>
        <button type="submit" class="ws-btn-main">
            <i data-lucide="check"></i>
            Müşteriyi Kaydet
        </button>
    </div>

</form>
