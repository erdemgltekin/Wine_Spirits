@model Wine_Spirits.Models.Customer

<div class="ws-modal-header">
    <h5 class="ws-modal-title">@(Model.Id == Guid.Empty ? "Yeni Müşteri Oluştur" : "Müşteri Bilgilerini Düzenle")</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form id="createCustomerForm" class="ws-modal-form-container">
    @Html.AntiForgeryToken()
    @if (Model.Id != Guid.Empty)
    {
        <input type="hidden" asp-for="Id" />
    }

    <div class="ws-modal-body">
        <div class="ws-form-group">
            <label class="ws-form-label">Müşteri Adı / Firma *</label>
            <div class="ws-input-group">
                <span class="ws-input-icon"><i data-lucide="building"></i></span>
                <input asp-for="Name" class="form-control ws-input-premium" placeholder="Müşteri adını girin" required>
            </div>
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">E-posta</label>
            <div class="ws-input-group">
                <span class="ws-input-icon"><i data-lucide="mail"></i></span>
                <input asp-for="Email" type="email" class="form-control ws-input-premium" placeholder="E-posta adresi">
            </div>
            <span asp-validation-for="Email" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Telefon</label>
            <div class="ws-input-group">
                <span class="ws-input-icon"><i data-lucide="phone"></i></span>
                <input asp-for="Phone" class="form-control ws-input-premium" placeholder="Telefon numarası">
            </div>
            <span asp-validation-for="Phone" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Vergi Dairesi</label>
            <div class="ws-input-group">
                <span class="ws-input-icon"><i data-lucide="landmark"></i></span>
                <input asp-for="TaxOffice" class="form-control ws-input-premium" placeholder="Vergi dairesi">
            </div>
            <span asp-validation-for="TaxOffice" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Vergi Numarası</label>
            <div class="ws-input-group">
                <span class="ws-input-icon"><i data-lucide="hash"></i></span>
                <input asp-for="TaxNumber" class="form-control ws-input-premium" placeholder="Vergi numarası">
            </div>
            <span asp-validation-for="TaxNumber" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Adres</label>
            <div class="ws-input-group align-items-start">
                <span class="ws-input-icon mt-2"><i data-lucide="map-pin"></i></span>
                <textarea asp-for="Adress" class="form-control ws-input-premium" rows="2" placeholder="Adres bilgisini girin"></textarea>
            </div>
            <span asp-validation-for="Adress" class="text-danger"></span>
        </div>

        <div class="ws-info-alert mt-4 d-flex align-items-center gap-2 p-3 rounded-3 bg-primary-subtle text-primary border border-primary-subtle">
            <i data-lucide="info" class="ws-icon-18"></i>
            <span class="fs-xs fw-medium">
                Yeni müşteri kayıtları varsayılan olarak <strong>aktif</strong> durumdadır. Müşteri bilgilerini dilediğiniz zaman güncelleyebilirsiniz.
            </span>
        </div>
    </div>

    <div class="ws-form-actions">
        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="ws-btn-main">
            <i data-lucide="save" class="me-1"></i>
            @(Model.Id == Guid.Empty ? "Müşteri Ekle" : "Değişiklikleri Kaydet")
        </button>
    </div>
</form>