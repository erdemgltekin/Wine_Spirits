@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Stok Raporu";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/report/report.css" asp-append-version="true" />
}

<div class="ws-report-container">

    @* ── Sayfa Başlığı ── *@
    <div class="ws-page-header mb-4">
        <div>
            <h2 class="ws-page-title">Stok Raporu</h2>
            <p class="ws-page-subtitle">Anlık stok durumu, değer analizi ve kritik seviye takibi.</p>
        </div>
        <button type="button" class="ws-btn-secondary ws-btn-download d-flex align-items-center gap-2" id="btnDownloadReport">
            <i data-lucide="download" class="ws-icon-16"></i> Rapor İndir
        </button>
    </div>

    @* ── İstatistik Kartları (V2 Global Standard) ── *@
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel {
                StatKey  = "totalStock",
                Label    = "Toplam Stok Miktarı",
                Value    = "12.480",
                Icon     = "boxes",
                IconClass = "bg-indigo-50 text-indigo-600"
            }' />
        </div>
        <div class="col-xl-4 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel {
                StatKey  = "totalValue",
                Label    = "Toplam Stok Değeri",
                Value    = "₺2.847.650",
                Icon     = "banknote",
                IconClass = "bg-emerald-50 text-emerald-600"
            }' />
        </div>
        <div class="col-xl-4 col-sm-12">
            <partial name="Partials/_StatCard" model='new StatCardViewModel {
                StatKey  = "criticalLevel",
                Label    = "Kritik Seviye",
                Value    = "14 Ürün",
                Icon     = "alert-triangle",
                IconClass = "bg-rose-50 text-rose-600"
            }' />
        </div>
    </div>

    @* ── Modern Filtreleme Konteyneri (V3.0 Global Standard) ── *@
    <div class="ws-filter-container">
        <div class="row g-3 align-items-center">

            @* Ürün Arama *@
            <div class="col-lg-3 col-md-12">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="search"></i></span>
                    <input type="text" class="ws-input-control" placeholder="Ürün ara..." id="reportSearch">
                </div>
            </div>

            @* Depo Seçimi *@
            <div class="col-lg-3 col-md-4">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="warehouse"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterWarehouse">
                        <option value="">Tüm Depolar</option>
                        <option value="ana">Ana Depo</option>
                        <option value="sube-a">Şube Depo A</option>
                        <option value="santiye">Şantiye Depo</option>
                    </select>
                </div>
            </div>

            @* Tarih Aralığı (Flatpickr) *@
            <div class="col-lg-3 col-md-4">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="calendar-range"></i></span>
                    <input type="text" class="ws-input-control ws-datepicker" id="reportDateRange" placeholder="Tarih Aralığı Seçin" readonly>
                </div>
            </div>

            @* Filtrele / Sırala *@
            <div class="col-lg-3 col-md-4">
                <div class="dropdown">
                    <button class="ws-btn-modern-filter dropdown-toggle" type="button"
                            data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="d-flex align-items-center gap-2">
                            <i data-lucide="sliders-horizontal" class="ws-icon-18"></i>
                            Filtrele / Sırala
                        </span>
                        <i data-lucide="chevron-down" class="ws-icon-16 opacity-50"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li><h6 class="dropdown-header">Stok Durumu</h6></li>
                        <li><a class="dropdown-item active" href="#" data-sort="all">Tümü</a></li>
                        <li><a class="dropdown-item" href="#" data-sort="critical">Kritik Stoklar</a></li>
                        <li><a class="dropdown-item" href="#" data-sort="low">Düşük Stoklar</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">Değer Sıralaması</h6></li>
                        <li><a class="dropdown-item" href="#" data-sort="value-desc">Değer: Yüksekten Düşüğe</a></li>
                        <li><a class="dropdown-item" href="#" data-sort="value-asc">Değer: Düşükten Yükseğe</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><h6 class="dropdown-header">İsim Sıralaması</h6></li>
                        <li><a class="dropdown-item" href="#" data-sort="name-asc">A'dan Z'ye</a></li>
                        <li><a class="dropdown-item" href="#" data-sort="name-desc">Z'den A'ya</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    @* ── Rapor Tablosu ── *@
    <div class="ws-table-card">
        <div class="table-responsive">
            <table class="table ws-custom-table align-middle" id="reportTable">
                <thead>
                    <tr>
                        <th class="ps-4">ÜRÜN ID</th>
                        <th>ÜRÜN ADI</th>
                        <th>KATEGORİ</th>
                        <th>DEPO</th>
                        <th>STOK</th>
                        <th>BİRİM FİYAT</th>
                        <th>TOPLAM DEĞER</th>
                        <th class="text-center">DURUM</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td class="ps-4"><span class="ws-report-product-id">#PRD-001</span></td>
                        <td><span class="ws-report-product-name">Chardonnay Reserve 2022</span></td>
                        <td>Beyaz Şarap</td>
                        <td>Ana Depo</td>
                        <td><span class="fw-bold text-danger">8</span></td>
                        <td><span class="ws-report-price">₺485,00</span></td>
                        <td><span class="ws-report-total">₺3.880,00</span></td>
                        <td class="text-center">
                            <span class="ws-badge ws-badge-stock-critical">
                                <i data-lucide="alert-circle" class="ws-icon-16"></i> Kritik
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4"><span class="ws-report-product-id">#PRD-002</span></td>
                        <td><span class="ws-report-product-name">Merlot Special Selection</span></td>
                        <td>Kırmızı Şarap</td>
                        <td>Ana Depo</td>
                        <td><span class="fw-bold text-warning">18</span></td>
                        <td><span class="ws-report-price">₺620,00</span></td>
                        <td><span class="ws-report-total">₺11.160,00</span></td>
                        <td class="text-center">
                            <span class="ws-badge ws-badge-stock-low">
                                <i data-lucide="minus-circle" class="ws-icon-16"></i> Düşük
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4"><span class="ws-report-product-id">#PRD-003</span></td>
                        <td><span class="ws-report-product-name">Vintage Cognac 50cl</span></td>
                        <td>Sert Alkol</td>
                        <td>Şube Depo A</td>
                        <td><span class="fw-bold text-dark">124</span></td>
                        <td><span class="ws-report-price">₺1.250,00</span></td>
                        <td><span class="ws-report-total">₺155.000,00</span></td>
                        <td class="text-center">
                            <span class="ws-badge ws-badge-stock-ok">
                                <i data-lucide="check-circle" class="ws-icon-16"></i> Yeterli
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4"><span class="ws-report-product-id">#PRD-004</span></td>
                        <td><span class="ws-report-product-name">Rosé Provence 2023</span></td>
                        <td>Rosé Şarap</td>
                        <td>Ana Depo</td>
                        <td><span class="fw-bold text-dark">56</span></td>
                        <td><span class="ws-report-price">₺340,00</span></td>
                        <td><span class="ws-report-total">₺19.040,00</span></td>
                        <td class="text-center">
                            <span class="ws-badge ws-badge-stock-ok">
                                <i data-lucide="check-circle" class="ws-icon-16"></i> Yeterli
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="ps-4"><span class="ws-report-product-id">#PRD-005</span></td>
                        <td><span class="ws-report-product-name">Scotch Whisky 12Y</span></td>
                        <td>Viski</td>
                        <td>Şantiye Depo</td>
                        <td><span class="fw-bold text-danger">5</span></td>
                        <td><span class="ws-report-price">₺2.100,00</span></td>
                        <td><span class="ws-report-total">₺10.500,00</span></td>
                        <td class="text-center">
                            <span class="ws-badge ws-badge-stock-critical">
                                <i data-lucide="alert-circle" class="ws-icon-16"></i> Kritik
                            </span>
                        </td>
                    </tr>
                    @* ── Özet Satırı ── *@
                    <tr class="ws-report-summary-row">
                        <td class="ps-4" colspan="4">GENEL TOPLAM</td>
                        <td><span class="fw-bold">211 Adet</span></td>
                        <td>—</td>
                        <td><span class="ws-report-total">₺199.580,00</span></td>
                        <td></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

</div>

@section Scripts {
    <script src="~/js/report/report.js" asp-append-version="true"></script>
}
