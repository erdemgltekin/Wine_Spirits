@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Stok Raporu";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    @* --- SAYFA BAŞLIĞI --- *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--gray-900); letter-spacing: -0.02em;">Stok Raporu</h2>
            <p class="text-muted mb-0 small">Anlık stok durumu, değer analizi ve kritik seviye takibi.</p>
        </div>
        <button type="button" class="ws-btn-secondary" id="btnDownloadReport">
            <i data-lucide="download"></i>
            <span>Excel Olarak İndir</span>
        </button>
    </div>

    @* --- İSTATİSTİK KARTLARI (Global StatCard Yapısı) --- *@
    <div class="row g-4 mb-4">
        <div class="col-xl-4 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-indigo-50">
                    <i data-lucide="boxes"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Toplam Stok Miktarı</div>
                    <div class="fs-4 fw-bold text-dark">12.480 <small class="fs-6 fw-normal text-muted">Adet</small></div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-emerald-50">
                    <i data-lucide="banknote"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Toplam Stok Değeri</div>
                    <div class="fs-4 fw-bold text-dark">₺2.847.650</div>
                </div>
            </div>
        </div>
        <div class="col-xl-4 col-sm-12">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-rose-50">
                    <i data-lucide="alert-triangle"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Kritik Seviyedeki Ürünler</div>
                    <div class="fs-4 fw-bold text-dark">14 <small class="fs-6 fw-normal text-muted">Kalem</small></div>
                </div>
            </div>
        </div>
    </div>

    @* --- FİLTRELEME BAR --- *@
    
    <div class="ws-filter-container d-flex align-items-stretch gap-3 shadow-sm mb-4 p-2">

        @* 1. Ürün Arama *@
        <div class="ws-filter-item flex-fill">
            <i data-lucide="search" class="ws-icon-18 text-muted"></i>
            <input type="text" class="ws-filter-el w-100" placeholder="Ürün veya Kod ara..." id="reportSearch">
        </div>

        @* 2. Depo Seçimi (Custom Dropdown) *@
        <div class="dropdown flex-fill">
            <div class="ws-filter-item d-flex align-items-center justify-content-between h-100"
                 data-bs-toggle="dropdown"
                 aria-expanded="false"
                 role="button">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="warehouse" class="ws-icon-18 text-muted"></i>
                    <span id="selectedWarehouse" class="ws-filter-label text-truncate">Tüm Depolar</span>
                </div>
                <i data-lucide="chevron-down" class="ws-icon-14 opacity-50 ms-2"></i>
            </div>
            <ul class="dropdown-menu shadow-lg border-0 w-100 mt-2">
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="updateWarehouse('Tüm Depolar')">Tüm Depolar</a></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="updateWarehouse('Ana Depo')">Ana Depo</a></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="updateWarehouse('Şube Depo A')">Şube Depo A</a></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="updateWarehouse('Şantiye Deposu')">Şantiye Deposu</a></li>
            </ul>
        </div>

        @* 3. Tarih Aralığı *@
        <div class="ws-filter-item flex-fill">
            <i data-lucide="calendar-range" class="ws-icon-18 text-muted"></i>
            <input type="text" class="ws-filter-el ws-datepicker w-100" id="reportDateRange" placeholder="Tarih Aralığı" readonly>
        </div>

        @* 4. Filtrele / Sırala *@
        <div class="dropdown">
            <button class="ws-btn-filter-action dropdown-toggle h-100 border-0 d-flex align-items-center gap-2"
                    type="button"
                    data-bs-toggle="dropdown"
                    style="white-space: nowrap;">
                <i data-lucide="sliders-horizontal" class="ws-icon-18"></i>
                <span>Filtrele</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="min-width: 220px;">
                <li><h6 class="dropdown-header text-primary fw-bold">Stok Durumu</h6></li>
                <li><a class="dropdown-item active d-flex align-items-center justify-content-between" href="#" data-sort="all">Tümü <i data-lucide="check" class="ws-icon-14"></i></a></li>
                <li><a class="dropdown-item" href="#" data-sort="critical">Kritik Stoklar</a></li>
                <li><a class="dropdown-item" href="#" data-sort="low">Düşük Stoklar</a></li>
                <li><hr class="dropdown-divider opacity-50"></li>
                <li><h6 class="dropdown-header text-primary fw-bold">Değer Sıralaması</h6></li>
                <li><a class="dropdown-item" href="#" data-sort="value-desc">Değer: Yüksekten Düşüğe</a></li>
                <li><a class="dropdown-item" href="#" data-sort="value-asc">Değer: Düşükten Yükseğe</a></li>
            </ul>
        </div>
    </div>

    @* --- RAPOR TABLOSU --- *@
    <div class="ws-table-wrapper">
        <table class="ws-table-premium" id="reportTable">
            <thead>
                <tr>
                    <th class="ps-4">ÜRÜN BİLGİSİ</th>
                    <th>KATEGORİ</th>
                    <th>DEPO</th>
                    <th>STOK MİKTARI</th>
                    <th>BİRİM FİYAT</th>
                    <th>TOPLAM DEĞER</th>
                    <th class="text-center">DURUM</th>
                </tr>
            </thead>
            <tbody>
                @* Örnek Satır 1 *@
                <tr>
                    <td class="ps-4">
                        <div class="fw-bold text-dark">Chardonnay Reserve 2022</div>
                        <div class="text-muted extra-small">ID: #PRD-001</div>
                    </td>
                    <td><span class="badge bg-light text-dark fw-medium border">Beyaz Şarap</span></td>
                    <td>Ana Depo</td>
                    <td><span class="fw-bold text-danger">8 Adet</span></td>
                    <td>₺485,00</td>
                    <td class="fw-bold text-dark">₺3.880,00</td>
                    <td class="text-center">
                        <span class="status-pill status-danger">
                            <i data-lucide="alert-circle" style="width:14px; height:14px;"></i> Kritik
                        </span>
                    </td>
                </tr>
                @* Örnek Satır 2 *@
                <tr>
                    <td class="ps-4">
                        <div class="fw-bold text-dark">Vintage Cognac 50cl</div>
                        <div class="text-muted extra-small">ID: #PRD-003</div>
                    </td>
                    <td><span class="badge bg-light text-dark fw-medium border">Sert Alkol</span></td>
                    <td>Şube Depo A</td>
                    <td><span class="fw-bold text-dark">124 Adet</span></td>
                    <td>₺1.250,00</td>
                    <td class="fw-bold text-dark">₺155.000,00</td>
                    <td class="text-center">
                        <span class="status-pill status-success">
                            <i data-lucide="check-circle" style="width:14px; height:14px;"></i> Yeterli
                        </span>
                    </td>
                </tr>
            </tbody>
            @* Özet Satırı *@
            <tfoot style="background-color: var(--gray-50);">
                <tr class="fw-bold" style="border-top: 2px solid var(--gray-200);">
                    <td class="ps-4" colspan="3">GENEL TOPLAM</td>
                    <td class="text-primary">132 Adet</td>
                    <td>—</td>
                    <td class="text-primary">₺158.880,00</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/report/report.js" asp-append-version="true"></script>

}