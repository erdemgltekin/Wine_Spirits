@using Wine_Spirits.Models.ViewModels
@model IEnumerable<dynamic>

@{
    ViewData["Title"] = "Stok Raporu";
    Layout = "_Layout";
}

<div class="ws-page-container">
    @* --- SAYFA BAŞLIĞI --- *@
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Stok Raporu</h2>
            <p class="ws-page-subtitle">Anlık stok durumu, değer analizi ve kritik seviye takibi.</p>
        </div>
        <div class="ws-header-actions">
            @* Global ikincil buton sınıfımız *@
            <button type="button" class="ws-btn-secondary" id="btnDownloadReport">
                <i data-lucide="download"></i>
                <span>Excel Olarak İndir</span>
            </button>
        </div>
    </header>

    @* --- 1. İSTATİSTİK KARTLARI (3'lü Grid + ws-card Glow Efekti) --- *@
    <div class="ws-summary-grid">
        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="boxes"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Stok Miktarı</span>
                <span class="ws-stat-value">12.480 <small class="ws-unit">Adet</small></span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="banknote"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Stok Değeri</span>
                <span class="ws-stat-value">₺2.847.650</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="alert-triangle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Kritik Seviye</span>
                <span class="ws-stat-value">14 <small class="ws-unit">Kalem</small></span>
            </div>
        </div>
    </div>

    @* --- 2. FİLTRELEME BARI (Dinamik & Responsive) --- *@
    <div class="ws-filter-container">
        @* Ürün Arama *@
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" class="ws-filter-el" placeholder="Ürün veya Kod ara..." id="reportSearch">
        </div>

        <div class="ws-filter-group-right">
            @* Depo Seçimi *@
            <div class="ws-custom-dropdown dropdown">
                <div class="ws-filter-item" data-bs-toggle="dropdown" id="warehouseFilterTrigger">
                    <i data-lucide="warehouse"></i>
                    <span id="selectedWarehouse" class="ws-filter-el">Tüm Depolar</span>
                    <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
                </div>
                <ul class="dropdown-menu ws-dropdown-premium">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="ReportManager.updateWarehouse('all')"><i data-lucide="layers"></i> Tüm Depolar</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="ReportManager.updateWarehouse('Ana Depo')"><i data-lucide="database"></i> Ana Depo</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="ReportManager.updateWarehouse('Şube Depo A')"><i data-lucide="building"></i> Şube Depo A</a></li>
                </ul>
            </div>

            @* Tarih Aralığı *@
            <div class="ws-filter-item">
                <i data-lucide="calendar-range"></i>
                <input type="text" class="ws-filter-el ws-datepicker" id="reportDateRange" data-mode="range" placeholder="Tarih Aralığı" readonly>
            </div>

            @* Filtrele / Sırala *@
            <div class="ws-custom-dropdown dropdown">
                <div class="ws-filter-item" data-bs-toggle="dropdown">
                    <i data-lucide="sliders-horizontal"></i>
                    <span class="ws-filter-el">Sırala</span>
                    <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
                </div>
                <ul class="dropdown-menu ws-dropdown-premium">
                    <li><h6 class="dropdown-header">Stok Durumu</h6></li>
                    <li><a class="dropdown-item" href="#" data-sort="all"><i data-lucide="check-square"></i> Tümü</a></li>
                    <li><a class="dropdown-item" href="#" data-sort="critical"><i data-lucide="alert-circle"></i> Kritik Stoklar</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li><h6 class="dropdown-header">Sıralama</h6></li>
                    <li><a class="dropdown-item" href="#" data-sort="value-desc"><i data-lucide="arrow-down-narrow-wide"></i> Değer: Yüksek</a></li>
                </ul>
            </div>
        </div>
    </div>

    @* --- 3. PREMIUM RAPOR TABLOSU (table.scss Uyumlu) --- *@
    <div class="ws-table-wrapper">
        <table class="ws-table-premium" id="reportTable">
            <thead>
                <tr>
                    <th>ÜRÜN BİLGİSİ</th>
                    <th>KATEGORİ</th>
                    <th>DEPO</th>
                    <th>STOK MİKTARI</th>
                    <th>BİRİM FİYAT</th>
                    <th>TOPLAM DEĞER</th>
                    <th class="ws-text-center">DURUM</th>
                </tr>
            </thead>
            <tbody>
                @* Örnek dinamik satır yapısı *@
                <tr>
                    <td>
                        <div class="ws-td-main-text">Chardonnay Reserve 2022</div>
                        <div class="ws-td-sub-text">ID: #PRD-001</div>
                    </td>
                    <td><span class="ws-tag">Beyaz Şarap</span></td>
                    <td>Ana Depo</td>
                    <td><span class="ws-td-bold ws-text-danger">8 Adet</span></td>
                    <td>₺485,00</td>
                    <td class="ws-td-bold">₺3.880,00</td>
                    <td class="ws-text-center">
                        <span class="ws-status-pill ws-status-danger">
                            <i data-lucide="alert-circle"></i> KRİTİK
                        </span>
                    </td>
                </tr>
            </tbody>
            <tfoot class="ws-table-footer">
                <tr>
                    <td colspan="3" class="ws-footer-label">GENEL TOPLAM</td>
                    <td class="ws-text-primary ws-td-bold">132 Adet</td>
                    <td>—</td>
                    <td class="ws-text-primary ws-td-bold">₺158.880,00</td>
                    <td></td>
                </tr>
            </tfoot>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/stock-reports/stockreport-manager.js" asp-append-version="true"></script>
}