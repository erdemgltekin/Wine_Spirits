@model Wine_Spirits.Models.Unit
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers


@{
    ViewData["Title"] = "Birim Düzenle";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <!-- [Card Design]: Düzenleme formu için merkezi kart yapısı. -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="card-title text-center mb-0">Birim Düzenle</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert" style="display:none;"></div>
                        
                        <!-- [Hidden Input]: Düzenleme işleminde ID bilgisini saklamamız gerekir. -->
                        <input type="hidden" asp-for="Id" />

                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control" id="unitNameInput" placeholder="Birim Adı" />
                            <label for="unitNameInput">Birim Adı</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2">
                                <i data-lucide="save" class="me-1" style="width: 18px; vertical-align: text-bottom;"></i>
                                Güncelle
                            </button>
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                                Vazgeç ve Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

