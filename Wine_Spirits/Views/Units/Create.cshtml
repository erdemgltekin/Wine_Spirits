@model Wine_Spirits.Models.Unit
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Yeni Birim";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-5">
            <!-- [Card Design]: Formu merkeze odaklı, temiz bir kart içinde sunuyoruz. -->
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white border-bottom-0 pt-4 pb-0">
                    <h5 class="card-title text-center mb-0">Yeni Birim Oluştur</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <!-- [Modern Input]: Floating Labels kullanarak modern bir form görünümü elde ediyoruz. -->
                        <div class="form-floating mb-4">
                            <input asp-for="Name" class="form-control" id="unitNameInput" placeholder="Birim Adı" />
                            <label for="unitNameInput">Birim Adı (Örn: Adet, Koli)</label>
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>
                        
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-primary py-2">
                                <i data-lucide="save" class="me-1" style="width: 18px; vertical-align: text-bottom;"></i>
                                Kaydet
                            </button>
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                                Vazgeç ve Listeye Dön
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        lucide.createIcons();
        // Validation hatası olursa summary'i göster (Opsiyonel JS kontrolü eklenebilir)
    </script>
}
