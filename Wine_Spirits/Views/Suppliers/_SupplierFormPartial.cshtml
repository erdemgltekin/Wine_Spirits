@model Wine_Spirits.Models.Supplier

@{
    bool isEdit      = Model != null && Model.Id != Guid.Empty;
    string title     = isEdit ? "Tedarikçi Düzenle" : "Yeni Tedarikçi Ekle";
    string buttonText = isEdit ? "Güncelle" : "Tedarikçiyi Kaydet";
}

@* ─── MODAL HEADER ─── *@
<div class="ws-modal-header">
    <h5 class="ws-modal-title">@title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
        <i data-lucide="x"></i>
    </button>
</div>

@* ─── FORM ─── *@
<form id="supplierForm">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="CreatedDate" />

    <div class="ws-modal-body">

        @* Row 1 — Tedarikçi Adı: full-width via :first-child SCSS rule *@
        <div class="ws-form-group">
            <label asp-for="Name" class="ws-form-label">Tedarikçi Adı / Firma *</label>
            <input asp-for="Name"
                   class="ws-input-premium"
                   placeholder="Örn: Global Lojistik A.Ş."
                   required />
        </div>

        @* Row 2: Sol — E-Posta *@
        <div class="ws-form-group">
            <label asp-for="Email" class="ws-form-label">E-Posta</label>
            <input asp-for="Email"
                   type="email"
                   class="ws-input-premium"
                   placeholder="destek@firma.com" />
        </div>

        @* Row 2: Sağ — Telefon *@
        <div class="ws-form-group">
            <label asp-for="Phone" class="ws-form-label">Telefon</label>
            <input asp-for="Phone"
                   class="ws-input-premium"
                   placeholder="05xx xxx xx xx" />
        </div>

        @* Row 3: Sol — Menşei Ülke *@
        <div class="ws-form-group">
            <label asp-for="CountryId" class="ws-form-label">Menşei Ülke</label>
            <select asp-for="CountryId"
                    class="ws-input-premium"
                    asp-items="ViewBag.CountryId">
                <option value="">-- Ülke Seçin --</option>
            </select>
        </div>

        @* Row 3: Sağ — Bağlı Depo *@
        <div class="ws-form-group">
            <label asp-for="WarehouseId" class="ws-form-label">Bağlı Depo</label>
            <select asp-for="WarehouseId"
                    class="ws-input-premium"
                    asp-items="ViewBag.WarehouseId">
                <option value="">Depo Seçin (Opsiyonel)</option>
            </select>
        </div>

        @* Info alert — full width *@
        <div class="ws-info-alert">
            <i data-lucide="info"></i>
            <span>Tedarikçi eklendiğinde sistem üzerinden satın alma operasyonları başlatılabilir.</span>
        </div>

    </div>@* /.ws-modal-body *@

    @* ─── FOOTER ACTIONS ─── *@
    <div class="ws-form-actions">
        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
        <button type="submit" class="ws-btn-main">
            <i data-lucide="@(isEdit ? "save" : "check")"></i>
            @buttonText
        </button>
    </div>

</form>