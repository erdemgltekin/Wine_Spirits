@model IEnumerable<Wine_Spirits.Models.Supplier>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tedarikçi Yönetimi";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border">
        <div>
            <h1 class="h3 mb-1 fw-bold text-dark">Tedarikçi Yönetimi</h1>
            <p class="text-muted small mb-0">
                <i data-lucide="truck" class="me-1" style="width: 14px;"></i>
                Toplam @Model.Count() kayıtlı tedarikçi listeleniyor.
            </p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Create" class="btn btn-indigo px-4 shadow-sm d-flex align-items-center" data-drawer="true" data-title="Yeni Tedarikçi Ekle">
                <i data-lucide="plus-circle" class="me-2" style="width: 18px;"></i>
                Tedarikçi Ekle
            </a>
        </div>
    </div>

    <!-- Stats & Filters -->
    <div class="row g-4 mb-4">
        <div class="col-md-12">
            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-3">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 ps-3">
                            <i data-lucide="search" class="text-muted" style="width: 18px;"></i>
                        </span>
                        <input type="text" id="supplierSearchInput" class="form-control border-start-0 ps-0" placeholder="Tedarikçi adı veya e-posta ara..." autocomplete="off">
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Table Card -->
    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div id="suppliersTableContainer">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="suppliersTable">
                    <thead>
                        <tr class="bg-light">
                            <th class="ps-4 py-3">Tedarikçi Adı</th>
                            <th class="py-3">İletişim</th>
                            <th class="py-3">Ülke</th>
                            <th class="text-end pe-4 py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="fw-bold text-dark">@item.Name</div>
                                    <div class="small text-muted" style="font-size: 11px;">#@item.Id.ToString().Substring(0,8)</div>
                                </td>
                                <td>
                                    <div class="small text-dark">@item.Email</div>
                                    <div class="small text-muted">@item.Phone</div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <i data-lucide="globe" class="me-2 text-muted" style="width: 14px;"></i>
                                        <span class="small">@item.Country?.Name</span>
                                    </div>
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" data-drawer="true" data-title="Tedarikçi Bilgilerini Düzenle" title="Düzenle">
                                            <i data-lucide="pencil" style="width: 18px;"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Sil">
                                            <i data-lucide="trash-2" style="width: 18px;"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            
            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="mb-3">
                        <i data-lucide="truck" class="text-muted opacity-25" style="width: 48px; height: 48px;"></i>
                    </div>
                    <h5 class="text-dark">Henüz kayıtlı tedarikçi bulunmuyor.</h5>
                    <a asp-action="Create" class="btn btn-indigo px-4" data-drawer="true" data-title="Yeni Tedarikçi Ekle">
                        İlk Tedarikçiyi Ekle
                    </a>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            $('#supplierSearchInput').on('keyup', function() {
                var value = $(this).val().toLowerCase();
                $("#suppliersTable tbody tr").filter(function() {
                    $(this).toggle($(this).text().toLowerCase().indexOf(value) > -1)
                });
            });
        });
    </script>
}
