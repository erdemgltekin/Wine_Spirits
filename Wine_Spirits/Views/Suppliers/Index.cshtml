@using Wine_Spirits.Models.ViewModels
@model SuppliersIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tedarikçi Yönetimi";
    Layout = "_Layout";
}

<div class="ws-suppliers-container">
    @* --- SAYFA BAŞLIĞI --- *@
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Tedarikçi Yönetimi</h2>
            <p class="ws-page-subtitle">Global tedarik ağınızı ve alım performansınızı izleyin.</p>
        </div>
        <div class="ws-header-actions">
            @* JS: closest('#btnCreateSupplier') üzerinden yakalar *@
            <button type="button" class="ws-btn-main" id="btnCreateSupplier">
                <i data-lucide="truck"></i>
                <span>Yeni Tedarikçi Ekle</span>
            </button>
        </div>
    </header>

    @* --- İSTATİSTİK KARTLARI --- *@
    <div class="ws-stats-grid">
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo"><i data-lucide="truck"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Tedarikçi</span>
                <span class="ws-stat-value">@Model.Stats.TotalSuppliers</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald"><i data-lucide="check-circle"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Tedarikçi</span>
                <span class="ws-stat-value">@Model.Stats.ActiveSuppliers</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-blue"><i data-lucide="package"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Ürün</span>
                <span class="ws-stat-value">@Model.Stats.TotalProducts</span>
            </div>
        </div>
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose"><i data-lucide="shopping-cart"></i></div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Alım</span>
                <span class="ws-stat-value">@Model.Stats.TotalPurchase</span>
            </div>
        </div>
    </div>

    @* --- FİLTRELEME BARI (_filters.scss & _dropdowns.scss uyumlu) --- *@
    <div class="ws-filter-container">
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" id="supplierSearch" class="ws-filter-el" placeholder="Tedarikçi ara...">
        </div>

        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            @* data-mode="range" Flatpickr tarafında yakalanır *@
            <input type="text" id="dateFilter" class="ws-filter-el ws-datepicker" data-mode="range" placeholder="Kayıt Tarihi" readonly>
        </div>

        @* Durum Filtresi (Premium Dropdown Yapısı) *@
        <div class="dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown">
                <i data-lucide="activity"></i>
                <div class="ws-filter-el"><span id="selectedStatusText">Durum</span></div>
                <i data-lucide="chevron-down" class="ws-filter-chevron"></i>
            </div>
            <div class="dropdown-menu ws-dropdown-premium">
                <div class="ws-dropdown-option active" onclick="SupplierManager.filterStatus('', 'Tüm Durumlar')">
                    <i data-lucide="layers"></i> Tüm Durumlar
                </div>
                <div class="ws-dropdown-option" onclick="SupplierManager.filterStatus('active', 'Aktif')">
                    <i data-lucide="user-check"></i> Aktif
                </div>
                <div class="ws-dropdown-option" onclick="SupplierManager.filterStatus('passive', 'Pasif')">
                    <i data-lucide="user-minus"></i> Pasif
                </div>
            </div>
        </div>

        @* Sıralama *@
        <div class="dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown">
                <i data-lucide="sliders-horizontal"></i>
                <div class="ws-filter-el"><span>Sırala</span></div>
                <i data-lucide="chevron-down" class="ws-filter-chevron"></i>
            </div>
            <div class="dropdown-menu ws-dropdown-premium dropdown-menu-end">
                <div class="ws-dropdown-option" onclick="SupplierManager.sort('name-asc')">
                    <i data-lucide="sort-asc"></i> İsim (A-Z)
                </div>
                <div class="ws-dropdown-option" onclick="SupplierManager.sort('date-desc')">
                    <i data-lucide="calendar"></i> Yeni Kayıt
                </div>
            </div>
        </div>

        @* <button type="button" class="ws-btn-filter-action" onclick="location.reload()">
            <i data-lucide="refresh-cw"></i>Yenile
        </button> *@
    </div>

    @* --- TEDARİKÇİ KART GRİDİ --- *@
    <div class="ws-supplier-grid">
        @foreach (var supplier in Model.Suppliers)
        {
            @* Hata Çözümü: CreatedAt yerine CreatedDate kullanıldı *@
            <div class="ws-supplier-card" data-status="@(supplier.IsActive ? "active" : "passive")" data-date="@supplier.CreatedDate.ToString("yyyy-MM-dd")">
                
                <header class="ws-supplier-header">
                    <div class="ws-supplier-profile">
                        <div class="ws-supplier-avatar">
                            <i data-lucide="building-2"></i>
                        </div>
                        <div class="ws-supplier-meta">
                            <h3 class="ws-supplier-name">@supplier.Name</h3>
                            <span class="ws-supplier-id">TDR-@supplier.Id.ToString().Substring(0, 4).ToUpper()</span>
                        </div>
                    </div>
                    <div class="ws-supplier-actions">
                        @* JS: btn-edit-supplier ve btn-toggle-status sınıflarını arar *@
                        <button class="ws-action-btn btn-edit-supplier" data-id="@supplier.Id">
                            <i data-lucide="edit-3"></i>
                        </button>
                        <button class="ws-action-btn btn-toggle-status" data-id="@supplier.Id">
                            <i data-lucide="power" class="@(supplier.IsActive ? "text-success" : "text-muted")"></i>
                        </button>
                    </div>
                </header>

                <div class="ws-supplier-body">
                    <div class="ws-info-row">
                        <i data-lucide="mail"></i>
                        <span>@supplier.Email</span>
                    </div>
                    <div class="ws-info-row">
                        <i data-lucide="phone"></i>
                        <span>@supplier.Phone</span>
                    </div>
                    <div class="ws-info-row">
                        <i data-lucide="calendar"></i>
                        <span>@supplier.CreatedDate.ToString("dd MMM yyyy")</span>
                    </div>
                </div>

                <footer class="ws-supplier-footer">
                    <div class="ws-kpi-group">
                        <div class="ws-kpi-item">
                            <span class="ws-kpi-label">ÜRÜN</span>
                            <span class="ws-kpi-value">@supplier.Products?.Count</span>
                        </div>
                        <div class="ws-kpi-item align-end">
                            <span class="ws-kpi-label">DURUM</span>
                            <span class="ws-status-text @(supplier.IsActive ? "success" : "danger")">
                                @(supplier.IsActive ? "AKTİF" : "PASİF")
                            </span>
                        </div>
                    </div>
                    <div class="ws-progress-wrapper">
                        <div class="ws-progress-labels">
                            <span>GÜVENİLİRLİK</span>
                            <span>90%</span>
                        </div>
                        <div class="ws-progress-bar">
                            <div class="ws-progress-fill" style="width: 90%"></div>
                        </div>
                    </div>
                </footer>
            </div>
        }
    </div>
</div>

@* --- MODAL --- *@
<div class="modal fade" id="supplierModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        @* ws-modal-custom: _modals.scss içindeki premium tasarımı tetikler *@
        <div class="modal-content ws-modal-custom" id="supplierModalContent">
            @* İçerik AJAX (SupplierManager) ile yüklenecektir *@
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/supplier/supplier.js" asp-append-version="true"></script>
}