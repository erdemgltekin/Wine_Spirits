@using Wine_Spirits.Models.ViewModels
@model Wine_Spirits.Models.ViewModels.SuppliersIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Tedarikçi Yönetimi";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/supplier.css" asp-append-version="true" />
}

<div class="ws-page-container px-4 py-4">
    @* SAYFA BAŞLIĞI *@
    <div class="ws-page-header mb-4">
        <div>
            <h2 class="ws-page-title">Tedarikçi Yönetimi</h2>
            <p class="ws-page-subtitle">Global ağdaki tedarikçi ortaklarınızı ve ürün portföylerini izleyin.</p>
        </div>
        <a asp-action="Create" class="ws-btn-primary shadow-sm" data-drawer="true" data-title="Yeni Tedarikçi Ekle">
            <i data-lucide="plus" class="ws-icon-18"></i> Yeni Tedarikçi Ekle
        </a>
    </div>

    @* STATCARD PANELİ *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalSuppliers", Label = "Toplam Tedarikçi", Value = Model.Stats.TotalSuppliers.ToString(), Icon = "truck", IconClass = "bg-gray-100 text-gray-900", HideIcon = true }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "activeSuppliers", Label = "Aktif Tedarikçi", Value = Model.Stats.ActiveSuppliers.ToString(), Icon = "check-circle", IconClass = "bg-emerald-50 text-emerald-600", HideIcon = true }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalProducts", Label = "Toplam Ürün", Value = Model.Stats.TotalProducts.ToString(), Icon = "package", IconClass = "bg-primary-50 text-primary-600", HideIcon = true }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalPurchase", Label = "Toplam Alım", Value = Model.Stats.TotalPurchase, Icon = "banknote", IconClass = "bg-violet-50 text-violet-600", HideIcon = true }' />
        </div>
    </div>

    @* MODERN FİLTRELEME KONTEYNERİ *@
    <div class="ws-filter-container mb-4">
        <div class="row g-3 w-100 m-0">
            <div class="col-md-4 ps-0">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="search"></i></span>
                    <input type="text" class="ws-input-control" placeholder="Tedarikçi ismi veya kod ile ara..." id="supplierSearch">
                </div>
            </div>
            <div class="col-md-3">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="globe"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterCountry">
                        <option value="">Tüm Ülkeler</option>
                        @foreach (var country in Model.Suppliers.Select(s => s.Country?.Name).Where(x => !string.IsNullOrEmpty(x)).Distinct())
                        {
                            <option value="@country">@country</option>
                        }
                    </select>
                </div>
            </div>
            <div class="col-md-2">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="filter"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterStatus">
                        <option value="">Tüm Durumlar</option>
                        <option value="active">Aktif</option>
                        <option value="inactive">Pasif</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3 pe-0">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="calendar"></i></span>
                    <input type="text" class="ws-input-control flatpickr-date" id="filterDate" placeholder="Kayıt Tarihi Aralığı" readonly>
                </div>
            </div>
        </div>
    </div>

    @* PREMIUM TEDARİKÇİ GRID ALANI *@
    <div class="ws-supplier-grid" id="suppliersCardContainer">
        @foreach (var supplier in Model.Suppliers)
        {
            var shortCode = supplier.Id.ToString().Substring(0, 4).ToUpper();
            
            <div class="ws-supplier-card-wrapper" data-date="@supplier.CreatedDate.ToString("yyyy-MM-dd")">
                <div class="ws-supplier-card">
                    <div class="supplier-status-indicator">
                        @if (supplier.IsActive)
                        {
                            <span class="ws-status-dot bg-success" id="dot-@supplier.Id"></span>
                            <span class="ws-status-text text-success" id="badge-@supplier.Id">Aktif</span>
                        }
                        else
                        {
                            <span class="ws-status-dot bg-secondary" id="dot-@supplier.Id"></span>
                            <span class="ws-status-text text-muted" id="badge-@supplier.Id">Pasif</span>
                        }
                    </div>

                    <div class="card-header-v3">
                        <div class="supplier-avatar-box">
                            <i data-lucide="building-2"></i>
                        </div>
                        <div class="supplier-info-v3">
                            <h3 class="supplier-name-v3">@supplier.Name</h3>
                            <span class="supplier-code-v3">#TDR-@shortCode</span>
                        </div>
                        <div class="card-actions-v3">
                            <button class="ws-btn-icon-v3 btn-toggle-status" data-id="@supplier.Id" title="@(supplier.IsActive ? "Durdur" : "Başlat")">
                                <i data-lucide="power" class="@(supplier.IsActive ? "text-success" : "text-muted")"></i>
                            </button>
                            <a asp-action="Edit" asp-route-id="@supplier.Id" class="ws-btn-icon-v3" title="Düzenle">
                                <i data-lucide="pencil" class="text-primary"></i>
                            </a>
                        </div>
                    </div>

                    <div class="supplier-details-v3">
                        <div class="detail-row">
                            <i data-lucide="mail"></i>
                            <span>@supplier.Email</span>
                        </div>
                        <div class="detail-row">
                            <i data-lucide="phone"></i>
                            <span>@supplier.Phone</span>
                        </div>
                        <div class="detail-row">
                            <i data-lucide="map-pin"></i>
                            <span class="ws-detail-country">@(supplier.Country?.Name ?? "Uluslararası")</span>
                        </div>
                    </div>

                    <div class="supplier-footer-v3">
                        <div class="kpi-box">
                            <span class="kpi-label">Ürünler</span>
                            <span class="kpi-value">@supplier.Products.Count</span>
                        </div>
                        <div class="kpi-box text-end">
                            <span class="kpi-label">Toplam Hacim</span>
                            @{
                                decimal total = 0;
                                foreach(var p in supplier.Products) {
                                    total += p.StockMovements.Where(sm => sm.MovementType == "IN").Sum(sm => sm.Quantity) * p.Price;
                                }
                                string formatted = total >= 1000000 ? $"₺{(total/1000000):0.##}M" : (total >= 1000 ? $"₺{(total/1000):0.##}K" : $"₺{total:N0}");
                            }
                            <span class="kpi-value">@formatted</span>
                        </div>
                        <button class="ws-btn-delete-v3 btn-delete-supplier" data-id="@supplier.Id" title="Tedarikçiyi Arşivle">
                            <i data-lucide="archive"></i>
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Suppliers.Any())
    {
        <div class="ws-empty-state-v3">
            <div class="empty-icon-box">
                <i data-lucide="truck"></i>
            </div>
            <h4>Tedarikçi Bulunamadı</h4>
            <p>Sistemde kayıtlı tedarikçi bulunmamaktadır.</p>
        </div>
    }
</div>

@Html.AntiForgeryToken()

@section Scripts {
    <script src="~/js/pages/supplier.js" asp-append-version="true"></script>
}
