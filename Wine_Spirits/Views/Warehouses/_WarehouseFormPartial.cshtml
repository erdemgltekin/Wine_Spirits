@model Wine_Spirits.Models.WareHouse

@{
    bool isEdit = Model != null && Model.Id != Guid.Empty;
    string actionName = isEdit ? "Edit" : "Create";
    string title      = isEdit ? "Depo Bilgilerini Düzenle" : "Yeni Depo Ekle";
    string buttonText = isEdit ? "Güncelle" : "Depoyu Kaydet";
}

@* ─── MODAL HEADER ─── *@
<div class="ws-modal-header">
    <h5 class="ws-modal-title">@title</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
        <i data-lucide="x"></i>
    </button>
</div>

@* ─── FORM ─── *@
<form asp-action="@actionName" method="post" id="warehouseForm">
    @Html.AntiForgeryToken()

    <div class="ws-modal-body">

        @if (isEdit)
        {
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="CreatedDate" />
        }

        @* Validation summary *@
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

        @* Row 1 — Depo Adı: full-width via SCSS :first-child rule *@
        <div class="ws-form-group">
            <label class="ws-form-label">Depo Tanımı / Adı *</label>
            <input asp-for="Name"
                   class="ws-input-premium"
                   placeholder="Örn: Merkez Lojistik Deposu"
                   required />
            <span asp-validation-for="Name" class="text-danger"></span>
        </div>

        @* Row 2 — Konum / Adres: full-width (only 2 fields, both span 2) *@
        <div class="ws-form-group">
            <label class="ws-form-label">Depo Konumu / Adres *</label>
            <textarea asp-for="Location"
                      class="ws-input-premium ws-textarea"
                      rows="3"
                      placeholder="Şehir, İlçe ve açık adres bilgisi..."
                      required></textarea>
            <span asp-validation-for="Location" class="text-danger"></span>
        </div>

        @* Info alert — full width *@
        <div class="ws-info-alert">
            <i data-lucide="info"></i>
            <span>
                @(isEdit
                    ? "Yapılan değişiklikler tüm stok kayıtlarını etkileyecektir."
                    : "Yeni oluşturulan depolar varsayılan olarak aktif durumdadır.")
            </span>
        </div>

    </div>@* /.ws-modal-body *@

    @* ─── FOOTER ACTIONS ─── *@
    <div class="ws-form-actions">
        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
        <button type="submit" class="ws-btn-main">
            <i data-lucide="@(isEdit ? "save" : "check")"></i>
            @buttonText
        </button>
    </div>

</form>