@model IEnumerable<Wine_Spirits.Models.WareHouse>

@{
    ViewData["Title"] = "Depo Yönetimi";
    Layout = "_Layout";
    // Türkçe tarih formatı için CultureInfo tanımlıyoruz
    var turkishCulture = new System.Globalization.CultureInfo("tr-TR");
}


<div class="ws-main-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Depo Yönetimi</h2>
            <p class="text-muted small mb-0">Depo lokasyonlarını ve kapasite durumlarını yönetin.</p>
        </div>
        <button type="button" class="ws-btn-main shadow-sm" onclick="GlobalUI.openModal('/Warehouses/Create')">
            Yeni Depo Ekle
        </button>
    </div>

    <div class="ws-summary-grid-4 mb-4">
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="building-2"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Depo</span>
                <span class="ws-stat-value">@Model.Count()</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="navigation"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Lokasyon</span>
                <span class="ws-stat-value">@Model.Select(x => x.Location).Distinct().Count()</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="package-check"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Kapasite</span>
                <span class="ws-stat-value">94%</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="alert-circle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Kritik Doluluk</span>
                <span class="ws-stat-value">2</span>
            </div>
        </div>
    </div>

    <div class="ws-filter-container shadow-sm mb-4">
        <div class="ws-filter-item flex-grow-1">
            <i data-lucide="search"></i>
            <input type="text" id="warehouseSearch" class="ws-filter-el" placeholder="Depo adı veya lokasyon ara...">
        </div>
        <div class="d-flex gap-2">
            <div class="dropdown">
                <button class="ws-btn-filter-action" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i data-lucide="map-pin"></i> <span id="selectedRegionText">Bölge Seçin</span>
                </button>
                <ul class="dropdown-menu border-0 shadow-lg">
                    <li><a class="dropdown-item" href="javascript:void(0)" onclick="WarehouseManager.filterByValue('all')">Tüm Bölgeler</a></li>
                    <li><hr class="dropdown-divider"></li>
                    @foreach (var loc in Model.Select(x => x.Location).Distinct())
                    {
                        <li><a class="dropdown-item" href="javascript:void(0)" onclick="WarehouseManager.filterByValue('@loc')">@loc</a></li>
                    }
                </ul>
            </div>
            <div class="dropdown">
                <button class="ws-btn-filter-action" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                    <i data-lucide="bar-chart-3"></i> Durum
                </button>
                <ul class="dropdown-menu border-0 shadow-lg">
                    <li><a class="dropdown-item" href="javascript:void(0)">Aktif</a></li>
                    <li><a class="dropdown-item" href="javascript:void(0)">Kritik Doluluk</a></li>
                </ul>
            </div>
        </div>
    </div>

    <div class="ws-warehouse-grid">
        @foreach (var item in Model)
        {
            var shortCode = item.Id.ToString().Substring(0, 4).ToUpper();
            var fillRate = 75;

            <div class="ws-warehouse-card-wrapper" data-location-filter="@item.Location">
                <div class="ws-warehouse-card shadow-sm" data-name="@item.Name" data-location="@item.Location">
                    <div class="card-header-flex d-flex justify-content-between align-items-start mb-3">
                        <div class="d-flex align-items-center gap-3">
                            <div class="ws-stat-icon-box ws-warehouse-icon bg-indigo-50 text-primary">
                                <i data-lucide="warehouse"></i>
                            </div>
                            <div>
                                <h6 class="fw-bold m-0 text-dark">@item.Name</h6>
                                <span class="text-muted small">DPO-@shortCode</span>
                            </div>
                        </div>
                        <div class="d-flex gap-1">
                            <button type="button" onclick="GlobalUI.openModal('/Warehouses/Edit/@item.Id')" class="ws-action-btn" title="Düzenle">
                                <i data-lucide="edit-3"></i>
                            </button>
                            <button type="button" onclick="WarehouseManager.deleteWarehouse('@item.Id')" class="ws-action-btn" title="Sil">
                                <i data-lucide="trash-2" class="text-danger"></i>
                            </button>
                        </div>
                    </div>

                    <div class="warehouse-info-list mb-4">
                        <div class="d-flex align-items-center gap-2 mb-2 text-muted small">
                            <i data-lucide="map-pin" class="size-14"></i>
                            <span class="text-truncate">@item.Location</span>
                        </div>
                        <div class="d-flex align-items-center gap-2 text-muted small">
                            <i data-lucide="clock" class="size-14"></i>
                            <span>Kayıt: @item.CreatedDate.ToString("dd MMMM yyyy", turkishCulture)</span>
                        </div>
                    </div>

                    <div class="row g-2 mt-auto">
                        <div class="col-6"><div class="ws-info-badge"><small class="ws-badge-label">ÜRÜN TİPİ</small><span class="fw-bold">124</span></div></div>
                        <div class="col-6"><div class="ws-info-badge"><small class="ws-badge-label">TOPLAM STOK</small><span class="fw-bold">1.250</span></div></div>
                    </div>

                    <div class="mt-3">
                        <div class="d-flex justify-content-between small mb-1">
                            <span class="text-muted">Doluluk</span>
                            <span class="fw-bold">@fillRate%</span>
                        </div>
                        <div class="progress ws-warehouse-progress">
                            <div class="progress-bar bg-primary shadow-none"
                                 role="progressbar"
                                 style="--fill-rate: @(fillRate)%;"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/warehouse/warehouse-manager.js" asp-append-version="true"></script>
}