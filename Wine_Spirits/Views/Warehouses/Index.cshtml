@model IEnumerable<Wine_Spirits.Models.WareHouse>

@{
    ViewData["Title"] = "Depo Yönetimi";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/warehouse/warehouse-styles.css" asp-append-version="true" />
}

<div class="container-fluid px-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="h4 fw-bold text-dark mb-1">Depo Yönetimi</h2>
            <p class="text-muted small mb-0">Depolarınızı yönetin ve stok durumunu görüntüleyin.</p>
        </div>
        <a asp-action="Create" class="btn ws-btn-primary d-flex align-items-center gap-2 btn-warehouse-add">
            <i data-lucide="plus" class="btn-icon-plus"></i> Yeni Depo Ekle
        </a>
    </div>

    <div class="ws-search-container">
        <i data-lucide="search" class="ws-search-icon"></i>
        <input type="text" id="warehouseSearch" class="form-control border-0 shadow-sm ws-search-input" placeholder="Depo ara (Ad, konum)...">
    </div>

    <div class="ws-warehouse-grid">
        @foreach (var item in Model)
        {
            var displayId = item.Id.ToString();
            var shortCode = displayId.Length >= 4 ? displayId.Substring(0, 4).ToUpper() : displayId.ToUpper();

            <div class="ws-warehouse-card-wrapper">
                <div class="ws-warehouse-card" data-name="@item.Name" data-code="DPO-@shortCode" data-location="@item.Location">
                    
                    <div class="card-header-flex">
                        <div class="card-header-row">
                            <div class="warehouse-icon-box">
                                <i data-lucide="box"></i>
                            </div>
                            <div class="warehouse-header-info">
                                <div class="warehouse-title">@item.Name</div>
                                <div class="warehouse-code">DPO-@shortCode</div>
                            </div>
                        </div>

                        <div class="card-actions">
                            <a asp-action="Edit" asp-route-id="@item.Id" class="ws-action-btn ws-edit-icon" title="Düzenle">
                                <i data-lucide="pencil"></i>
                            </a>
                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" class="ws-delete-form">
                                <button type="button" class="ws-action-btn ws-delete-icon btn-delete-warehouse" title="Sil">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </form>
                        </div>
                    </div>

                    <div class="warehouse-meta">
                        <div class="meta-item">
                            <i data-lucide="map-pin"></i>
                            <span>@item.Location</span>
                        </div>
                        <div class="meta-item">
                            <i data-lucide="calendar"></i>
                            <span>@item.CreatedDate.ToString("dd.MM.yyyy")</span>
                        </div>
                    </div>

                    <div class="warehouse-stats">
                        <div class="stat-box purple">
                            <span class="stat-label">Ürün Çeşidi</span>
                            <span class="stat-value">0</span>
                        </div>
                        <div class="stat-box blue">
                            <span class="stat-label">Toplam Stok</span>
                            <span class="stat-value">0</span>
                        </div>
                    </div>

                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/warehouse.js" asp-append-version="true"></script>
}