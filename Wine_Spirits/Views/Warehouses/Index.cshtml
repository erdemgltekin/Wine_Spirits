@model IEnumerable<Wine_Spirits.Models.WareHouse>

@{
    ViewData["Title"] = "Depo Yönetimi";
    Layout = "_Layout";
    var turkishCulture = new System.Globalization.CultureInfo("tr-TR");
}

<div class="ws-page-container">
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Depo Yönetimi</h2>
            <p class="ws-page-subtitle">Depo lokasyonlarını ve kapasite durumlarını yönetin.</p>
        </div>
        <div class="ws-header-actions">
            <button type="button" class="ws-btn-main" onclick="GlobalUI.openModal('/Warehouses/Create')">
                <i data-lucide="warehouse"></i>
                <span>Yeni Depo Ekle</span>
            </button>
        </div>
    </header>

    @* 1. ÖZET İSTATİSTİK KARTLARI (card.scss hover uyumlu) *@
    <div class="ws-summary-grid">
        @* .ws-card sınıfı hover efektini tetiklemek için eklendi *@
        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="building-2"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Depo</span>
                <span class="ws-stat-value">@Model.Count()</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="navigation"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Lokasyon</span>
                <span class="ws-stat-value">@Model.Select(x => x.Location).Distinct().Count()</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-blue">
                <i data-lucide="package-check"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Kapasite</span>
                <span class="ws-stat-value">94%</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="alert-circle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Kritik Doluluk</span>
                <span class="ws-stat-value">2</span>
            </div>
        </div>
    </div>

    @* 2. GLOBAL FİLTRE VE DROP DOWN SİSTEMİ (filter.scss & dropdown.scss uyumlu) *@
    <div class="ws-filter-container">
        @* Arama Alanı *@
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" id="warehouseSearch" class="ws-filter-el" placeholder="Depo veya lokasyon ara...">
        </div>
        
        @* Bölge Filtresi (Hizalaması Düzeltildi) *@
        <div class="ws-custom-dropdown dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown" aria-expanded="false" id="regionFilterTrigger">
                <i data-lucide="map-pin"></i>
                <span class="ws-filter-el" id="selectedRegionText">Bölge Seçin</span>
                <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
            </div>
            <ul class="dropdown-menu ws-dropdown-premium">
                <li>
                    <a class="dropdown-item" href="javascript:void(0)" onclick="WarehouseManager.filterByValue('all')">
                        <i data-lucide="layers"></i> Tüm Bölgeler
                    </a>
                </li>
                <li><hr class="dropdown-divider"></li>
                @foreach (var loc in Model.Select(x => x.Location).Distinct())
                {
                    <li>
                        <a class="dropdown-item" href="javascript:void(0)" onclick="WarehouseManager.filterByValue('@loc')">
                            <i data-lucide="map-pin"></i> @loc
                        </a>
                    </li>
                }
            </ul>
        </div>

        @* Durum Filtresi *@
        <div class="ws-custom-dropdown dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown" aria-expanded="false">
                <i data-lucide="bar-chart-3"></i>
                <span class="ws-filter-el">Durum</span>
                <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
            </div>
            <ul class="dropdown-menu ws-dropdown-premium">
                <li><a class="dropdown-item" href="javascript:void(0)"><i data-lucide="check-circle"></i> Aktif</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)"><i data-lucide="alert-triangle"></i> Kritik Doluluk</a></li>
            </ul>
        </div>
    </div>

    @* 3. DEPO KARTLARI (card.scss hover uyumlu) *@
    <div class="ws-warehouse-grid">
        @foreach (var item in Model)
        {
            var shortCode = item.Id.ToString().Substring(0, 4).ToUpper();
            var fillRate = 75;
            @* .ws-card ve .ws-warehouse-card birlikte kullanıldı *@
            <div class="ws-card ws-warehouse-card" data-location="@item.Location" data-name="@item.Name">
                <div class="ws-card-header">
                    <div class="ws-card-info">
                        <div class="ws-card-icon-box">
                            <i data-lucide="warehouse"></i>
                        </div>
                        <div class="ws-card-texts">
                            <h6 class="ws-card-title">@item.Name</h6>
                            <span class="ws-card-subtitle">DPO-@shortCode</span>
                        </div>
                    </div>
                    <div class="ws-card-actions">
                        <button onclick="GlobalUI.openModal('/Warehouses/Edit/@item.Id')" class="ws-btn-icon" title="Düzenle">
                            <i data-lucide="edit-3"></i>
                        </button>
                        <button onclick="WarehouseManager.deleteWarehouse('@item.Id')" class="ws-btn-icon text-danger" title="Sil">
                            <i data-lucide="trash-2"></i>
                        </button>
                    </div>
                </div>

                <div class="ws-card-body">
                    <div class="ws-info-row">
                        <i data-lucide="map-pin"></i>
                        <span>@item.Location</span>
                    </div>
                    <div class="ws-info-row">
                        <i data-lucide="clock"></i>
                        <span>Kayıt: @item.CreatedDate.ToString("dd MMMM yyyy", turkishCulture)</span>
                    </div>

                    <div class="ws-badge-container">
                        <div class="ws-info-badge">
                            <label>ÜRÜN TİPİ</label>
                            <span>124</span>
                        </div>
                        <div class="ws-info-badge">
                            <label>TOPLAM STOK</label>
                            <span>1.250</span>
                        </div>
                    </div>

                    <div class="ws-progress-section">
                        <div class="ws-progress-label">
                            <span>Doluluk Oranı</span>
                            <span class="ws-progress-percent">@fillRate%</span>
                        </div>
                        <div class="ws-progress-bar-container">
                            <div class="ws-progress-bar" style="width: @(fillRate)%"></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script src="~/js/warehouse/warehouse-manager.js" asp-append-version="true"></script>
}