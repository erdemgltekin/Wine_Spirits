@model IEnumerable<Wine_Spirits.Models.WareHouse>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Depo Yönetimi";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="page-header d-flex justify-content-between align-items-center">
    <div>
        <h1 class="h3 mb-1 text-gray-800 fw-bold">Depolar</h1>
        <p class="text-muted small mb-0">Sistemdeki tüm depolama birimlerini buradan yönetebilirsiniz.</p>
    </div>
    <a asp-action="Create" class="btn btn-indigo shadow-sm px-4">
        <i data-lucide="plus" class="me-2"></i> Yeni Depo Ekle
    </a>
</div>

<div class="container-fluid">
    <div class="card shadow-sm border-0">
        <div class="card-header bg-white py-3 border-bottom">
            <h6 class="m-0 font-weight-bold text-primary d-flex align-items-center">
                <i data-lucide="list" class="me-2" style="width: 18px;"></i> Kayıtlı Depolar
            </h6>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Depo Adı</th>
                        <th>Lokasyon</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center">
                                    <div class="bg-light p-2 rounded-circle me-3">
                                        <i data-lucide="warehouse" class="text-primary" style="width: 18px; height: 18px;"></i>
                                    </div>
                                    <span class="fw-bold text-dark">@item.Name</span>
                                </div>
                            </td>
                            <td class="text-muted">
                                <i data-lucide="map-pin" class="me-1 text-secondary" style="width: 14px;"></i>
                                @item.Location
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="action-btn btn-edit" title="Düzenle">
                                        <i data-lucide="pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="action-btn btn-delete" title="Sil">
                                        <i data-lucide="trash-2"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function() {
            lucide.createIcons();
        });
    </script>
}
