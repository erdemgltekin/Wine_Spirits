@model Wine_Spirits.Models.WareHouse
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Depo Sil";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-danger text-white py-3">
                    <h6 class="m-0 font-weight-bold">Depo Silme Onayı</h6>
                </div>
                <div class="card-body">
                    <div class="alert alert-warning">
                        <i data-lucide="alert-triangle" class="me-2"></i>
                        <strong>Dikkat!</strong> Bu depoyu silmek üzeresiniz. Bu işlem geri alınamaz.
                    </div>
                    
                    <dl class="row">
                        <dt class="col-sm-4">Depo Adı:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Name)</dd>

                        <dt class="col-sm-4">Konum:</dt>
                        <dd class="col-sm-8">@Html.DisplayFor(model => model.Location)</dd>
                    </dl>
                    
                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-flex justify-content-end gap-2 mt-4">
                            <a asp-action="Index" class="btn btn-outline-secondary">İptal</a>
                            <button type="submit" class="btn btn-danger">Evet, Sil</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
