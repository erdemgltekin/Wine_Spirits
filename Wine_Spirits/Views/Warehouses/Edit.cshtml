@model Wine_Spirits.Models.WareHouse

@{
    Layout = "_Layout";
    ViewData["Title"] = "Depo Bilgilerini Düzenle";
}

<div class="ws-standalone-form-wrap">
    <div class="ws-standalone-form-card">
        @* 
           _WarehouseFormPartial contains:
           - ws-modal-header
           - ws-modal-body
           - ws-form-actions
           This ensures perfect visual consistency between modals and full pages.
        *@
        <partial name="_WarehouseFormPartial" model="Model" />

        <div class="text-center pb-4">
            <a asp-action="Index" class="text-muted small text-decoration-none">
                <i data-lucide="chevron-left" class="size-14"></i> Listeye Geri Dön
            </a>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}