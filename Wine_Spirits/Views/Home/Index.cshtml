@model Wine_Spirits.Models.ViewModels.DashboardViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Dashboard";
    Layout = "_Layout";
}

<!-- Page Header -->
<div class="d-flex justify-content-between align-items-center mb-5">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Dashboard</h1>
        <p class="text-muted small mb-0">İşletme performansı ve stok durumunu buradan takip edebilirsiniz.</p>
    </div>
    <a asp-controller="Products" asp-action="Create" class="btn btn-primary shadow-sm px-4" data-drawer="true" data-title="Yeni Ürün Ekle">
        <i data-lucide="plus" class="me-2 text-white-50"></i> Hızlı Ürün Ekle
    </a>
</div>

<!-- Wide Metric Cards -->
<div class="row g-4 mb-5">
    
    <!-- Total Products -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="stat-label mb-1">Toplam Ürün</div>
                        <div class="stat-value">@Model.TotalProducts</div>
                        <div class="text-xs text-success mt-2 d-flex align-items-center" style="font-size: 12px;">
                            <i data-lucide="trending-up" style="width: 14px; margin-right: 4px;"></i> Aktif Envanter
                        </div>
                    </div>
                    <div class="stat-icon-wrapper bg-indigo-50 text-indigo-600" style="background-color: #e0e7ff; color: #4338ca;">
                        <i data-lucide="package"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Critical Stock -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="stat-label mb-1">Kritik Stok</div>
                        <div class="stat-value text-danger">@Model.CriticalStockCount</div>
                        <div class="text-xs text-danger mt-2 d-flex align-items-center" style="font-size: 12px;">
                            <i data-lucide="alert-circle" style="width: 14px; margin-right: 4px;"></i> Aksiyon Gerekiyor
                        </div>
                    </div>
                    <div class="stat-icon-wrapper bg-red-50 text-red-600" style="background-color: #fef2f2; color: #dc2626;">
                        <i data-lucide="alert-triangle"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Monthly Sales -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="stat-label mb-1">Aylık Satış</div>
                        <div class="stat-value">@Model.MonthlySales.ToString("C0")</div>
                        <div class="text-xs text-muted mt-2 d-flex align-items-center" style="font-size: 12px;">
                            <i data-lucide="calendar" style="width: 14px; margin-right: 4px;"></i> Bu Ay
                        </div>
                    </div>
                    <div class="stat-icon-wrapper bg-emerald-50 text-emerald-600" style="background-color: #ecfdf5; color: #059669;">
                        <i data-lucide="banknote"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Total Suppliers -->
    <div class="col-xl-3 col-md-6">
        <div class="card stat-card shadow-sm border-0">
            <div class="card-body">
                <div class="d-flex align-items-start justify-content-between">
                    <div>
                        <div class="stat-label mb-1">Tedarikçiler</div>
                        <div class="stat-value">@Model.TotalSuppliers</div>
                        <div class="text-xs text-muted mt-2 d-flex align-items-center" style="font-size: 12px;">
                            <i data-lucide="users" style="width: 14px; margin-right: 4px;"></i> Aktif Partnerler
                        </div>
                    </div>
                    <div class="stat-icon-wrapper bg-amber-50 text-amber-600" style="background-color: #fffbeb; color: #d97706;">
                        <i data-lucide="truck"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Recent Products Section -->
<div class="card border-0 shadow-sm">
    <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
        <h5 class="card-title mb-0 fw-bold text-dark h6">Son Eklenen Ürünler</h5>
        <a asp-controller="Products" asp-action="Index" class="btn btn-sm btn-light text-muted border-0">
            Tümünü Gör <i data-lucide="arrow-right" style="width: 16px; margin-left: 4px; vertical-align: text-bottom;"></i>
        </a>
    </div>
    <div class="table-responsive border-0">
        <table class="table table-hover align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4 text-xs font-uppercase text-muted">Ürün Adı</th>
                    <th class="text-xs font-uppercase text-muted">Kategori</th>
                    <th class="text-xs font-uppercase text-muted">Birim</th>
                    <th class="text-xs font-uppercase text-muted text-end pe-4">Fiyat</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.RecentProducts)
                {
                    <tr>
                        <td class="ps-4">
                            <div class="d-flex align-items-center">
                                <div class="bg-light rounded p-2 me-3 text-secondary">
                                    <i data-lucide="wine" style="width: 20px;"></i>
                                </div>
                                <div>
                                    <div class="fw-medium text-dark">@(item.ProductDefinition?.Name ?? "Tanımsız Ürün")</div>
                                    <div class="text-xs text-muted" style="font-size: 12px;">Kodu: #@item.Id.ToString().Substring(0, 8)</div>
                                </div>
                            </div>
                        </td>
                        <td>
                            <span class="badge bg-light text-dark fw-normal border">@item.ProductCategory?.Name</span>
                        </td>
                        <td class="text-muted small">
                            @item.Unit?.Name
                        </td>
                        <td class="text-end pe-4 fw-bold text-dark">
                            @item.Price.ToString("C2")
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if (!Model.RecentProducts.Any())
    {
        <div class="p-5 text-center text-muted">
            <i data-lucide="package-open" class="mb-3 opacity-50" style="width: 48px; height: 48px;"></i>
            <p>Henüz görüntülenecek ürün yok.</p>
            <a asp-controller="Products" asp-action="Create" class="btn btn-primary btn-sm mt-2">İlk Ürünü Ekle</a>
        </div>
    }
</div>

@section Scripts {
    <script>
        lucide.createIcons();
    </script>
}
