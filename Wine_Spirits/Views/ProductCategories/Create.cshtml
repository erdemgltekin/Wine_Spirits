@model Wine_Spirits.Models.ProductCategory
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Yeni Kategori";
    Layout = "_Layout";
}

<div class="ws-standalone-form-wrap">
    <div class="ws-standalone-form-card">

        <div class="ws-modal-header">
            <h5 class="ws-modal-title">Yeni Kategori Oluştur</h5>
        </div>

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()
            <div asp-validation-summary="ModelOnly" class="ws-error-panel" style="margin: 1.5rem 2rem 0;"></div>

            <div class="ws-modal-body ws-modal-body--single">
                <div class="ws-form-group">
                    <label asp-for="Name" class="ws-form-label">Kategori Adı</label>
                    <input asp-for="Name"
                           id="categoryNameInput"
                           class="ws-input-premium"
                           placeholder="Örn: Şarap, Viski, Rakı" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
            </div>

            <div class="ws-form-actions">
                <a asp-action="Index" class="ws-btn-secondary">Vazgeç</a>
                <button type="submit" class="ws-btn-main">
                    <i data-lucide="save"></i>
                    Kaydet
                </button>
            </div>
        </form>

    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
