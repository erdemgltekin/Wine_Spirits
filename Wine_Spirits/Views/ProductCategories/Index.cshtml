@model IEnumerable<Wine_Spirits.Models.ProductCategory>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Kategoriler";
    Layout = "_Layout";
}

<div class="container-fluid py-4">
    <!-- Header Area -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 mb-0 text-gray-800">Kategori Yönetimi</h1>
            <p class="text-muted small mb-0">Ürün kategorilerini ve gruplandırmalarını buradan yönetebilirsiniz.</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i data-lucide="plus-circle" class="me-1"></i> Yeni Kategori
        </a>
    </div>

    <!-- Content Card -->
    <div class="card shadow-sm border-0">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-light">
                        <tr>
                            <th class="ps-4 py-3" style="width: 70%;">Kategori Adı</th>
                            <th class="text-end pe-4 py-3">İşlemler</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-medium text-dark">
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td class="text-end pe-4">
                                    <div class="btn-group gap-2">
                                        <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-light text-primary border-0" title="Düzenle">
                                            <i data-lucide="edit-3" style="width: 18px"></i>
                                        </a>
                                        <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-light text-danger border-0" title="Sil">
                                            <i data-lucide="trash-2" style="width: 18px"></i>
                                        </a>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center py-5">
                    <div class="text-muted mb-2">Henüz kayıtlı kategori bulunmuyor.</div>
                    <a asp-action="Create" class="btn btn-sm btn-outline-primary">İlk kaydı oluştur</a>
                </div>
            }
        </div>
    </div>
</div>


