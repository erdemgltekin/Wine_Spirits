@model Wine_Spirits.Models.Order
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var customers = ViewBag.Customers as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var warehouses = ViewBag.Warehouses as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="ws-modal-header">
    <h5 class="ws-modal-title">Yeni Sipariş Oluştur</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create" id="createOrderModalForm" class="ws-modal-form-container">
    @Html.AntiForgeryToken()
    <div class="ws-modal-body">
        
        <div class="ws-master-grid">
            <div class="ws-form-group">
                <label class="ws-form-label">Müşteri *</label>
                <select asp-for="CustomerId" class="ws-input-premium select2-enable" asp-items="customers">
                    <option value="">Müşteri seçiniz...</option>
                </select>
                <span asp-validation-for="CustomerId" class="text-danger"></span>
            </div>

            <div class="ws-form-group">
                <label class="ws-form-label">Depo *</label>
                <select asp-for="WarehouseId" class="ws-input-premium select2-enable" asp-items="warehouses">
                    <option value="">Depo seçiniz...</option>
                </select>
                <span asp-validation-for="WarehouseId" class="text-danger"></span>
            </div>

            <div class="ws-form-group">
                <label class="ws-form-label">Sipariş Tarihi *</label>
                <input asp-for="OrderDate" class="ws-input-premium flatpickr" type="text" placeholder="Tarih seçiniz..." readonly>
                    <span asp-validation-for="OrderDate" class="text-danger"></span>
                </div>
            </div>

            <div class="ws-order-section">
                <div class="ws-section-header">
                    <h6 class="ws-section-title">Sipariş Kalemleri</h6>
                    <button type="button" class="ws-btn-main ws-btn-sm" id="btnAddOrderItem">
                        <i data-lucide="plus"></i> Ürün Ekle
                    </button>
                </div>

                <div class="ws-order-item-header">
                    <div class="col-product ws-order-header-cell">Ürün Adı</div>
                    <div class="col-qty ws-order-header-cell text-center">Miktar</div>
                    <div class="col-price ws-order-header-cell text-center">Birim Fiyat</div>
                    <div class="col-action ws-order-header-cell"></div>
                </div>

                <div class="ws-order-items-container" id="orderItemsContainer">
                    <div class="ws-order-item-row" data-item-index="0">
                        <div class="col-product">
                            <select name="OrderItems[0].ProductId" class="ws-input-premium product-select" data-index="0">
                                <option value="">Ürün seçiniz...</option>
                            </select>
                        </div>
    
                        <div class="col-qty">
                            <input type="number" name="OrderItems[0].Quantity" class="ws-input-premium quantity-input text-center" value="1">
                        </div>
    
                        <div class="col-price">
                            <input type="number" name="OrderItems[0].UnitPrice" class="ws-input-premium price-input text-end" step="0.01">
                        </div>
    
                        <div class="col-action">
                            <button type="button" class="remove-item-btn"><i data-lucide="trash-2"></i></button>
                        </div>
                    </div>
                </div>
            </div>

            <div class="ws-order-summary">
                <div class="ws-summary-grid">
                    <div class="ws-form-group">
                        <label class="ws-form-label">Sipariş Notu / Açıklama</label>
                        <textarea asp-for="Description" class="ws-textarea" rows="2" placeholder="Siparişle ilgili açıklama giriniz..."></textarea>
                    </div>
            
                    <div class="ws-total-card">
                        <div class="ws-total-label">Ödenecek Toplam</div>
                        <div class="ws-total-amount" id="totalAmount">₺0.00</div>
                    </div>
                </div>
            </div>
        </div>

        <div class="ws-modal-footer">
            <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="ws-btn-main">Siparişi Onayla ve Kaydet</button>
        </div>
    </form>