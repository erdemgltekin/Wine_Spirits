@model Wine_Spirits.Models.Order
@using Microsoft.AspNetCore.Mvc.Rendering

@{
    var customers = ViewBag.Customers as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
    var warehouses = ViewBag.Warehouses as SelectList ?? new SelectList(Enumerable.Empty<SelectListItem>());
}

<div class="ws-modal-header">
    <h5 class="ws-modal-title">Yeni Sipariş Oluştur</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create" id="createOrderModalForm" class="ws-modal-form-container">
    @Html.AntiForgeryToken()
    <div class="ws-modal-body" style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px;">
        <!-- Master Bölüm: Müşteri, Depo, Tarih -->
        <div class="ws-form-group" style="grid-column: span 1 !important;">
            <label class="ws-form-label">Müşteri *</label>
            <div class="ws-filter-item">
                <i data-lucide="user"></i>
                <select asp-for="CustomerId" class="ws-filter-el select2-enable" asp-items="customers">
                    <option value="">Müşteri seçiniz...</option>
                </select>
            </div>
            <span asp-validation-for="CustomerId" class="text-danger"></span>
        </div>

        <div class="ws-form-group" style="grid-column: span 1 !important;">
            <label class="ws-form-label">Depo *</label>
            <div class="ws-filter-item">
                <i data-lucide="warehouse"></i>
                <select asp-for="WarehouseId" class="ws-filter-el select2-enable" asp-items="warehouses">
                    <option value="">Depo seçiniz...</option>
                </select>
            </div>
            <span asp-validation-for="WarehouseId" class="text-danger"></span>
        </div>

        <div class="ws-form-group" style="grid-column: span 1 !important;">
            <label class="ws-form-label">Sipariş Tarihi *</label>
            <div class="ws-filter-item">
                <i data-lucide="calendar"></i>
                <input asp-for="OrderDate" class="ws-filter-el flatpickr" type="text" placeholder="Tarih seçiniz...">
            </div>
            <span asp-validation-for="OrderDate" class="text-danger"></span>
        </div>

        <!-- Items Bölüm: Ürün Satırları -->
        <div class="ws-order-section" style="grid-column: span 3;">
            <div class="d-flex justify-content-between align-items-center">
                <h6 class="ws-section-title">Sipariş Kalemleri</h6>
                <button type="button" class="ws-btn-main ws-btn-sm" id="btnAddOrderItem">
                    <i data-lucide="plus"></i> Ürün Ekle
                </button>
            </div>

            <!-- Header Row (Statik Başlıklar) -->
            <div class="ws-order-item-header" style="display: grid; grid-template-columns: 3fr 1fr 1.2fr 45px; gap: 10px; align-items: center; font-weight: 600; color: #6b7280; font-size: 0.875rem; padding: 8px 0; border-bottom: 2px solid #e5e7eb; margin-bottom: 8px;">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="package" style="width: 16px; height: 16px;"></i>
                    Ürün
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="hash" style="width: 16px; height: 16px;"></i>
                    Miktar
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                    <i data-lucide="banknote" style="width: 16px; height: 16px;"></i>
                    Birim Fiyat
                </div>
                <div>
                    <!-- Silme butonu için boşluk -->
                </div>
            </div>

            <div class="ws-order-items-container" id="orderItemsContainer">
                <!-- İlk ürün satırı (varsayılan) -->
                <div class="ws-order-item-row" data-item-index="0">
                    <div class="ws-filter-item">
                        <i data-lucide="package"></i>
                        <select name="OrderItems[0].ProductId" class="ws-filter-el select2-enable product-select" data-index="0">
                            <option value="">Ürün seçiniz...</option>
                        </select>
                    </div>
                    <div class="ws-filter-item">
                        <i data-lucide="hash"></i>
                        <input type="number" name="OrderItems[0].Quantity" class="ws-filter-el quantity-input ws-input-premium" data-index="0" min="1" value="1" placeholder="0">
                    </div>
                    <div class="ws-filter-item">
                        <i data-lucide="banknote"></i>
                        <input type="number" name="OrderItems[0].UnitPrice" class="ws-filter-el price-input ws-input-premium" data-index="0" step="0.01" min="0" placeholder="0.00">
                    </div>
                    <button type="button" class="ws-btn-icon ws-btn-icon-danger remove-item-btn" data-index="0">
                        <i data-lucide="trash-2"></i>
                    </button>
                </div>
            </div>
        </div>

        <!-- Toplam Tutar Bölüm -->
        <div class="ws-order-summary" style="grid-column: span 3;">
            <div style="display: grid; grid-template-columns: 2fr 1fr; gap: 20px;">
                <div class="ws-form-group">
                    <label class="ws-form-label">Açıklama</label>
                    <textarea asp-for="Description" class="ws-textarea" rows="2" placeholder="Siparişle ilgili açıklama..."></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="ws-total-section">
                    <div class="ws-total-label">Genel Toplam</div>
                    <div class="ws-total-amount" id="totalAmount">₺0.00</div>
                </div>
            </div>
        </div>
    </div>

    <div class="ws-form-actions" style="grid-column: span 3;">
        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="ws-btn-main">Siparişi Tamamla</button>
    </div>
</form>
