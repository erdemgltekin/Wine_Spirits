@model IEnumerable<Wine_Spirits.Models.Order>
@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_Layout";

    int totalOrders = Model?.Count() ?? 0;
    int activeOrders = Model?.Count(o => o.IsActive) ?? 0;
}

@section Styles {
    @* Sayfaya özel ek CSS gerekirse buraya, ama main.css her şeyi çözüyor *@
}

<div class="ws-orders-container">
    <div class="ws-page-header">
        <div>
            <h2 class="ws-page-title">Sipariş Yönetimi</h2>
            <p class="ws-page-subtitle">Sipariş akışını izleyin ve durumları güncelleyin.</p>
        </div>
        <button type="button" class="ws-btn-main shadow-sm" id="btnCreateOrder">
             Yeni Sipariş Oluştur
        </button>
    </div>

    <div class="ws-summary-grid-4 mb-4">
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="shopping-bag"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Sipariş</span>
                <span class="ws-stat-value">@totalOrders</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="clock"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Sipariş</span>
                <span class="ws-stat-value">@activeOrders</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="check-circle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Tamamlanan</span>
                <span class="ws-stat-value">0</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="x-octagon"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">İptal Edilen</span>
                <span class="ws-stat-value">0</span>
            </div>
        </div>
    </div>

    <div class="ws-filter-container d-flex align-items-stretch">
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" id="orderSearch" class="ws-filter-el" placeholder="Sipariş No veya Müşteri ara...">
        </div>
        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            <input type="text" id="orderDateFilter" class="ws-filter-el ws-datepicker" placeholder="Tarih Aralığı" readonly>
        </div>
        <div class="ws-dropdown">
            <button class="ws-dropdown-trigger" type="button">
                <i data-lucide="activity"></i>
                <span id="selectedStatusText">Tüm Durumlar</span>
                <i data-lucide="chevron-down"></i>
            </button>
            <div class="ws-dropdown-menu">
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="filterOrders('', 'Tüm Durumlar')">Tüm Durumlar</a>
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="filterOrders('Pending', 'Beklemede')">Beklemede</a>
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="filterOrders('Completed', 'Tamamlandı')">Tamamlandı</a>
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="filterOrders('Cancelled', 'İptal Edildi')">İptal Edildi</a>
            </div>
        </div>
        <div class="ws-dropdown">
            <button class="ws-dropdown-trigger" type="button">
                <i data-lucide="sliders-horizontal"></i>
                <span>Sırala</span>
            </button>
            <div class="ws-dropdown-menu px-2 py-2">
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="sortOrders('date-desc')"><i data-lucide="calendar"></i> Yeniden Eskiye</a>
                <a class="ws-dropdown-item" href="javascript:void(0)" onclick="sortOrders('amount-desc')"><i data-lucide="trending-up"></i> Tutar (Yüksek)</a>
            </div>
        </div>
    </div>

    <div class="ws-table-wrapper">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th class="ps-4">SİPARİŞ BİLGİSİ</th>
                    <th>MÜŞTERİ</th>
                    <th>DEPO</th>
                    <th>TARİH</th>
                    <th>TUTAR</th>
                    <th>DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="ws-order-info">
                                    <div class="ws-order-icon">
                                        <i data-lucide="package"></i>
                                    </div>
                                    <div class="ws-order-details">
                                        <strong>#ORD-@item.Id.ToString().Substring(0, 6).ToUpper()</strong>
                                        <small>@item.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">@item.Customer?.Name @item.Customer?.Lastname</div>
                            </td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <i data-lucide="warehouse" class="text-muted" style="width:14px;"></i>
                                    @(item.Warehouse?.Name ?? "Merkez")
                                </div>
                            </td>
                            <td>
                                <div class="text-dark">@item.OrderDate.ToString("dd.MM.yyyy")</div>
                                <small class="text-muted">@item.OrderDate.ToString("HH:mm")</small>
                            </td>
                            <td>
                                <div class="fw-bold text-dark">₺@((item.OrderDetails?.Sum(od => od.TotalPrice) ?? 0).ToString("N2"))</div>
                            </td>
                            <td>
                                <span class="status-pill @(item.IsActive ? "status-success" : "status-warning")">
                                    <i data-lucide="@(item.IsActive ? "check-circle" : "clock")" style="width:14px;"></i>
                                    @(item.IsActive ? "Aktif" : "Beklemede")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="ws-action-btn" title="Detay"><i data-lucide="eye"></i></button>
                                    <button class="ws-action-btn" title="Sil"><i data-lucide="trash-2" class="text-danger"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/order/order.js" asp-append-version="true"></script>
}