@model IEnumerable<Wine_Spirits.Models.Order>
@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_Layout";

    int totalOrders = Model?.Count() ?? 0;
    int activeOrders = Model?.Count(o => o.IsActive) ?? 0;
}

@section Styles {
    @* Sayfaya özel ek CSS gerekirse buraya, ama main.css her şeyi çözüyor *@
}

<div class="ws-page-container p-4">
    @* --- Üst Başlık --- *@
    <div class="ws-page-header d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="ws-page-title fs-4 fw-bold text-dark mb-1">Sipariş Yönetimi</h2>
            <p class="ws-page-subtitle text-muted mb-0 opacity-75">Sipariş akışını izleyin ve durumları güncelleyin.</p>
        </div>
        <button type="button" class="ws-btn-main shadow-sm" id="btnNewOrder">
            <i data-lucide="plus-circle"></i> Yeni Sipariş Oluştur
        </button>
    </div>

    @* --- İstatistik Kartları (main.css: .ws-stat-card-v2 uyumlu) --- *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "total", Label = "Toplam Sipariş", Value = totalOrders.ToString(), Icon = "shopping-bag", IconClass = "bg-indigo-50" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "active", Label = "Aktif Sipariş", Value = activeOrders.ToString(), Icon = "clock", IconClass = "bg-amber-50" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "done", Label = "Tamamlanan", Value = "0", Icon = "check-circle", IconClass = "bg-emerald-50" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "cancel", Label = "İptal Edilen", Value = "0", Icon = "x-octagon", IconClass = "bg-rose-50" }' />
        </div>
    </div>

    @* --- Filtre Alanı (main.css: .ws-filter-container & .ws-filter-item uyumlu) --- *@
    <div class="ws-filter-container shadow-sm border-0 bg-transparent p-0 gap-3 mb-4">
        @* Arama *@
        <div class="ws-filter-item flex-grow-1 shadow-sm border-0 py-3">
            <i data-lucide="search"></i>
            <input type="text" class="ws-filter-el" placeholder="Sipariş No veya Müşteri ara..." id="orderSearch">
        </div>

        @* Durum Filtresi (Dropdown) *@
        <div class="dropdown flex-grow-1">
            <div class="ws-filter-item shadow-sm border-0 py-3 d-flex justify-content-between" data-bs-toggle="dropdown" role="button">
                <div class="d-flex align-items-center">
                    <i data-lucide="activity"></i>
                    <span id="selectedStatus" class="ws-filter-el opacity-75">Tüm Durumlar</span>
                </div>
                <i data-lucide="chevron-down" class="ms-auto opacity-50"></i>
            </div>
            <ul class="dropdown-menu border-0 shadow-lg w-100">
                <li><a class="dropdown-item active" href="#">Tüm Durumlar</a></li>
                <li><a class="dropdown-item" href="#">Aktif</a></li>
                <li><a class="dropdown-item" href="#">Tamamlandı</a></li>
            </ul>
        </div>

        @* Tarih *@
        @* Tarih Filtresi *@
        <div class="ws-filter-item flex-grow-1 shadow-sm border-0 py-3">
            <i data-lucide="calendar"></i>
            <input type="text" class="ws-filter-el" id="orderDateFilter" placeholder="Tarih Aralığı" readonly>
        </div>

        @* Sıralama *@
        <div class="dropdown">
            <button class="ws-btn-filter-action shadow-sm border-0 py-3 px-4 h-100" type="button" data-bs-toggle="dropdown">
                <i data-lucide="sliders-horizontal"></i> <span>Sırala</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end border-0 shadow-lg">
                <li><a class="dropdown-item" href="#">Yeniden Eskiye</a></li>
                <li><a class="dropdown-item" href="#">Tutar (Yüksek)</a></li>
            </ul>
        </div>
    </div>

    @* --- Tablo Yapısı  --- *@
    <div class="ws-table-wrapper border-0 shadow-sm rounded-4">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th class="ps-4">SİPARİŞ BİLGİSİ</th>
                    <th>MÜŞTERİ</th>
                    <th>DEPO</th>
                    <th>TARİH</th>
                    <th>TUTAR</th>
                    <th>DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null)
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="ws-stat-icon-box bg-light text-primary rounded-3" style="width: 40px; height: 40px;">
                                        <i data-lucide="package" style="width: 18px;"></i>
                                    </div>
                                    <div>
                                        <strong class="d-block text-dark">#ORD-@item.Id.ToString().Substring(0, 6).ToUpper()</strong>
                                        <small class="text-muted">@item.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="fw-semibold">@item.Customer?.Name @item.Customer?.Lastname</div>                             
                            </td>
                            <td>
                                <span class="status-pill bg-light text-secondary border">
                                    <i data-lucide="warehouse" style="width:12px"></i> @(item.Warehouse?.Name ?? "Merkez")
                                </span>
                            </td>
                            <td>
                                <div class="fw-medium">@item.OrderDate.ToString("dd.MM.yyyy")</div>
                                <div class="text-muted fs-xs">@item.OrderDate.ToString("HH:mm")</div>
                            </td>
                            <td>
                                <span class="fw-bold text-primary">₺@((item.OrderDetails?.Sum(od => od.TotalPrice) ?? 0).ToString("N2"))</span>
                            </td>
                            <td>                               
                                <div class="status-pill @(item.IsActive ? "status-success" : "status-warning")">
                                    <i data-lucide="@(item.IsActive ? "check" : "clock")" style="width:12px"></i>
                                    @(item.IsActive ? "Aktif" : "Beklemede")
                                </div>
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="ws-action-btn" title="Detay"><i data-lucide="eye"></i></button>
                                    <button class="ws-action-btn text-danger" title="Sil"><i data-lucide="trash-2"></i></button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/order/order.js" asp-append-version="true"></script>

}