@model IEnumerable<Wine_Spirits.Models.Order>
@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Sipariş Yönetimi";
    Layout = "_Layout";
    int totalOrders = Model?.Count() ?? 0;
    int activeOrders = Model?.Count(o => o.IsActive) ?? 0;
}

<div class="ws-page-container">
    @* --- SAYFA BAŞLIĞI --- *@
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Sipariş Yönetimi</h2>
            <p class="ws-page-subtitle">Sipariş akışını izleyin ve durumları güncelleyin.</p>
        </div>
        <div class="ws-header-actions">
            <button type="button" class="ws-btn-main shadow-sm" id="btnCreateOrder">
                <i data-lucide="shopping-cart"></i>
                <span>Yeni Sipariş</span>
            </button>
        </div>
    </header>

    @* --- 1. İSTATİSTİK KARTLARI (ws-summary-grid-4) --- *@
    <div class="ws-summary-grid-4">
        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="shopping-bag"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Sipariş</span>
                <span class="ws-stat-value">@totalOrders</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="clock"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Aktif Sipariş</span>
                <span class="ws-stat-value">@activeOrders</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="check-circle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Tamamlanan</span>
                <span class="ws-stat-value">0</span>
            </div>
        </div>

        <div class="ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="x-octagon"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">İptal Edilen</span>
                <span class="ws-stat-value">0</span>
            </div>
        </div>
    </div>

    @* --- 2. FİLTRELEME BARI (Mimarideki flex yapısına tam uyumlu) --- *@
    <div class="ws-filter-container">
        @* Arama (flex: 1) *@
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" id="orderSearch" class="ws-filter-el" placeholder="Sipariş No veya Müşteri ara...">
        </div>

        @* Tarih Aralığı (flex: 1) *@
        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            <input type="text" id="orderDateFilter" class="ws-filter-el ws-datepicker" data-mode="range" placeholder="Tarih Aralığı" readonly>
        </div>

        @* Durum Dropdown (flex: 1) *@
        <div class="ws-custom-dropdown">
            <div class="ws-filter-item">
                <i data-lucide="activity"></i>
                <div class="ws-filter-el">
                    <span id="selectedStatusText">Tüm Durumlar</span>
                </div>
                <i data-lucide="chevron-down" class="ws-dropdown-icon"></i>
            </div>
            <div class="ws-dropdown-content">
                <div class="ws-dropdown-option active" onclick="OrderManager.filter('all', 'Tüm Durumlar')">
                    <i data-lucide="layers"></i> Tüm Durumlar
                </div>
                <div class="ws-dropdown-option" onclick="OrderManager.filter('Pending', 'Beklemede')">
                    <i data-lucide="clock"></i> Beklemede
                </div>
                <div class="ws-dropdown-option" onclick="OrderManager.filter('Completed', 'Tamamlandı')">
                    <i data-lucide="check-circle"></i> Tamamlandı
                </div>
                <div class="ws-dropdown-option" onclick="OrderManager.filter('Cancelled', 'İptal Edildi')">
                    <i data-lucide="x-circle"></i> İptal Edildi
                </div>
            </div>
        </div>
    </div>

    @* --- 3. SİPARİŞ TABLOSU --- *@
    <div class="ws-table-wrapper" id="ordersTableContainer">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th class="ps-4">SİPARİŞ BİLGİSİ</th>
                    <th>MÜŞTERİ</th>
                    <th>DEPO</th>
                    <th>TARİH</th>
                    <th>TUTAR</th>
                    <th>DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4">
                                <div class="ws-order-info-cell">
                                    <div class="ws-order-icon-box">
                                        <i data-lucide="package"></i>
                                    </div>
                                    <div class="ws-order-texts">
                                        <strong class="ws-td-id">#ORD-@item.Id.ToString().Substring(0, 6).ToUpper()</strong>
                                        <small class="ws-td-sub-text">@item.Description</small>
                                    </div>
                                </div>
                            </td>
                            <td><div class="ws-td-main-text">@item.Customer?.Name @item.Customer?.Lastname</div></td>
                            <td>
                                <div class="ws-td-warehouse">
                                    <i data-lucide="warehouse"></i>
                                    <span>@(item.Warehouse?.Name ?? "Merkez")</span>
                                </div>
                            </td>
                            <td>
                                <div class="ws-td-main-text">@item.OrderDate.ToString("dd.MM.yyyy")</div>
                                <small class="ws-td-sub-text">@item.OrderDate.ToString("HH:mm")</small>
                            </td>
                            <td><div class="ws-td-bold">₺@((item.OrderDetails?.Sum(od => od.TotalPrice) ?? 0).ToString("N2"))</div></td>
                            <td>
                                <span class="ws-status-pill @(item.IsActive ? "ws-status-success" : "ws-status-warning")">
                                    <i data-lucide="@(item.IsActive ? "check-circle" : "clock")"></i>
                                    @(item.IsActive ? "Aktif" : "Beklemede")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                <div class="ws-table-actions">
                                    <button class="ws-action-btn" onclick="OrderManager.viewDetail('@item.Id')">
                                        <i data-lucide="eye"></i>
                                    </button>
                                    <button class="ws-action-btn text-danger" onclick="OrderManager.delete('@item.Id')">
                                        <i data-lucide="trash-2"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/order/order.js" asp-append-version="true"></script>
}