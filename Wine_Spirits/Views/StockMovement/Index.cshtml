@using Wine_Spirits.Models.ViewModels
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Stok Hareketleri";
    Layout = "_Layout";
}

@section Styles {   
    <link rel="stylesheet" href="~/css/stock-movement/stock-movement.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    @* --- SAYFA BAŞLIĞI --- *@
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h2 class="fw-bold mb-1" style="color: var(--gray-900); letter-spacing: -0.02em;">Stok Hareketleri</h2>
            <p class="text-muted mb-0 small">Tüm depo giriş, çıkış ve transfer süreçlerini buradan yönetin.</p>
        </div>
        <button type="button" class="ws-btn-primary" data-bs-toggle="modal" data-bs-target="#newMovementModal">
            <i data-lucide="plus-circle"></i>
            <span>Yeni Hareket Ekle</span>
        </button>
    </div>

    @* --- 8. GLOBAL STAT KARTLARI --- *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-indigo-50">
                    <i data-lucide="activity"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Toplam Hareket</div>
                    <div class="fs-4 fw-bold text-dark">1.248</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-emerald-50">
                    <i data-lucide="calendar"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Bugünkü Hareket</div>
                    <div class="fs-4 fw-bold text-dark">24</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-rose-50">
                    <i data-lucide="x-circle"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">İptal Edilen</div>
                    <div class="fs-4 fw-bold text-dark">7</div>
                </div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card-v2">
                <div class="ws-stat-icon-box bg-amber-50">
                    <i data-lucide="clock"></i>
                </div>
                <div>
                    <div class="text-muted small fw-medium">Onay Bekleyen</div>
                    <div class="fs-4 fw-bold text-dark">13</div>
                </div>
            </div>
        </div>
    </div>

    @* --- 10. GLOBAL FILTER BAR --- *@
    <div class="ws-filter-container shadow-sm d-flex align-items-stretch">
        @* Arama *@
        <div class="ws-filter-item flex-fill">
            <i data-lucide="search"></i>
            <input type="text" class="ws-filter-el w-100" placeholder="Hareket No veya Ürün ara..." id="movementSearch">
        </div>

        @* Hareket Tipi (Dropdown Yapıldı) *@
        <div class="dropdown flex-fill">
            <div class="ws-filter-item d-flex align-items-center justify-content-between h-100" data-bs-toggle="dropdown" role="button" aria-expanded="false" style="cursor: pointer;">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="layers"></i>
                    <span id="selectedMovementType" class="ws-filter-label">Tüm Tipler</span>
                </div>
                <i data-lucide="chevron-down" class="ws-icon-14 opacity-50"></i>
            </div>
            <ul class="dropdown-menu shadow-lg border-0 w-100">
                <li><a class="dropdown-item active" href="javascript:void(0)" onclick="updateFilter('MovementType', 'Tüm Tipler')">Tüm Tipler</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateFilter('MovementType', 'Giriş')">Giriş</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateFilter('MovementType', 'Çıkış')">Çıkış</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateFilter('MovementType', 'Transfer')">Transfer</a></li>
            </ul>
        </div>

        @* Depo (Dropdown Yapıldı) *@
        <div class="dropdown flex-fill">
            <div class="ws-filter-item d-flex align-items-center justify-content-between h-100" data-bs-toggle="dropdown" role="button" style="cursor: pointer;">
                <div class="d-flex align-items-center gap-2">
                    <i data-lucide="warehouse"></i>
                    <span id="selectedWarehouse" class="ws-filter-label">Tüm Depolar</span>
                </div>
                <i data-lucide="chevron-down" class="ws-icon-14 opacity-50"></i>
            </div>
            <ul class="dropdown-menu shadow-lg border-0 w-100">
                <li><a class="dropdown-item active" href="javascript:void(0)" onclick="updateFilter('Warehouse', 'Tüm Depolar')">Tüm Depolar</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateFilter('Warehouse', 'Ana Depo')">Ana Depo</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="updateFilter('Warehouse', 'Şube Depo A')">Şube Depo A</a></li>
            </ul>
        </div>

        @* Tarih *@
        <div class="ws-filter-item flex-fill">
            <i data-lucide="calendar"></i>
            <input type="text" class="ws-filter-el ws-datepicker w-100" id="dateFilter" placeholder="Tarih Seçin" readonly>
        </div>

        @* Sırala *@
        <div class="dropdown">
            <button class="ws-btn-filter-action dropdown-toggle border-0 h-100 d-flex align-items-center gap-2" type="button" data-bs-toggle="dropdown">
                <i data-lucide="sliders-horizontal"></i>
                <span>Sırala</span>
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0">
                <li><a class="dropdown-item active" href="#" data-sort="newest">Yeniden Eskiye</a></li>
                <li><a class="dropdown-item" href="#" data-sort="oldest">Eskiden Yeniye</a></li>
                <li><hr class="dropdown-divider opacity-50"></li>
                <li><a class="dropdown-item" href="#" data-sort="qty-desc">Miktar (Yüksek)</a></li>
            </ul>
        </div>
    </div>

    @* --- TABLO YAPISI --- *@
    <div class="ws-table-wrapper">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th class="ps-4">HAREKET NO</th>
                    <th>ÜRÜN / KOD</th>
                    <th>DEPO</th>
                    <th>TİP</th>
                    <th>MİKTAR</th>
                    <th>TARİH</th>
                    <th>DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="ps-4 text-primary fw-bold">#SH-8291</td>
                    <td>
                        <div class="fw-bold text-dark">Chardonnay Reserve 2022</div>
                        
                    </td>
                    <td>Ana Depo</td>
                    <td><span class="status-pill" style="background: #f1f5f9; color: #475569;"><i data-lucide="play-circle" class="ws-icon-14"></i> Açılış</span></td>
                    <td><span class="fw-bold text-dark">500</span></td>
                    <td>01.02.2026</td>
                    <td><span class="status-pill status-success">Tamamlandı</span></td>
                    <td class="text-end pe-4">
                        <div class="d-flex justify-content-end gap-2">
                            <button class="ws-action-btn" title="Detay"><i data-lucide="eye"></i></button>
                            <button class="ws-action-btn" title="Yazdır"><i data-lucide="printer"></i></button>
                        </div>
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="newMovementModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ws-modal-custom p-2">
            <div class="modal-header border-0 pb-0">
                <h5 class="fw-bold text-dark mb-0">Yeni Stok Hareketi</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-4">
                <form id="formNewMovement">
                    <div class="row g-3">
                        <div class="col-md-6">
                            <label class="ws-form-label">Ürün Seçimi</label>
                            <select class="ws-input-premium form-select" required>
                                <option value="" selected disabled>Ürün ara...</option>
                                <option>Merlot Special Selection</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="ws-form-label">Depo</label>
                            <select class="ws-input-premium form-select" required>
                                <option>Ana Depo</option>
                                <option>Şube Depo A</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="ws-form-label">Hareket Tipi</label>
                            <select class="ws-input-premium form-select" required>
                                <option>Giriş</option>
                                <option>Çıkış</option>
                                <option>Transfer</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="ws-form-label">Miktar</label>
                            <input type="number" class="ws-input-premium" placeholder="0" required>
                        </div>
                        <div class="col-12">
                            <label class="ws-form-label">Açıklama</label>
                            <textarea class="ws-input-premium py-2" rows="3" placeholder="Hareket notlarını buraya yazın..." style="height: auto;"></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-3 pb-4">
                <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">Vazgeç</button>
                <button type="submit" form="formNewMovement" class="ws-btn-primary">Hareketi Kaydet</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/stock-movement/stock-movement.js" asp-append-version="true"></script>

}