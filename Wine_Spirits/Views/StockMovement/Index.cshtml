@model IEnumerable<Wine_Spirits.Models.StockMovement>

@{
    ViewData["Title"] = "Stok Hareketleri";
    Layout = "_Layout";
}

<div class="ws-page-container">
    @* --- SAYFA BAŞLIĞI --- *@
    <header class="ws-page-header">
        <div class="ws-header-content">
            <h2 class="ws-page-title">Stok Hareketleri</h2>
            <p class="ws-page-subtitle">Tüm depo giriş, çıkış ve transfer süreçlerini buradan yönetin.</p>
        </div>
        <div class="ws-header-actions">
            <button type="button" class="ws-btn-main" onclick="GlobalUI.openModal('/StockMovement/Create')">
                <i data-lucide="trending-up"></i>
                <span>Yeni Hareket Ekle</span>
            </button>
        </div>
    </header>

    @* --- 1. İSTATİSTİK KARTLARI (card.scss uyumlu) --- *@
    <div class="ws-summary-grid">
        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-indigo">
                <i data-lucide="activity"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Toplam Hareket</span>
                <span class="ws-stat-value">@Model.Count()</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-emerald">
                <i data-lucide="calendar"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Bugünkü Hareket</span>
                <span class="ws-stat-value">24</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-rose">
                <i data-lucide="x-circle"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">İptal Edilen</span>
                <span class="ws-stat-value">7</span>
            </div>
        </div>

        <div class="ws-card ws-stat-card">
            <div class="ws-stat-icon-wrapper ws-icon-blue">
                <i data-lucide="clock"></i>
            </div>
            <div class="ws-stat-content">
                <span class="ws-stat-label">Onay Bekleyen</span>
                <span class="ws-stat-value">13</span>
            </div>
        </div>
    </div>

    @* --- 2. FİLTRELEME BARINDA RESPONSIVE YAPI (filter.scss & dropdown.scss uyumlu) --- *@
    <div class="ws-filter-container">
        @* Arama *@
        <div class="ws-filter-item">
            <i data-lucide="search"></i>
            <input type="text" class="ws-filter-el" placeholder="Hareket No veya Ürün ara..." id="movementSearch">
        </div>

        @* Hareket Tipi *@
        <div class="ws-custom-dropdown dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown" id="typeFilterTrigger">
                <i data-lucide="layers"></i>
                <span id="selectedMovementType" class="ws-filter-el">Tüm Tipler</span>
                <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
            </div>
            <ul class="dropdown-menu ws-dropdown-premium">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('MovementType', 'all')"><i data-lucide="layers"></i> Tüm Tipler</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('MovementType', 'Giriş')"><i data-lucide="log-in"></i> Giriş</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('MovementType', 'Çıkış')"><i data-lucide="log-out"></i> Çıkış</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('MovementType', 'Transfer')"><i data-lucide="shuffle"></i> Transfer</a></li>
            </ul>
        </div>

        @* Depo Seçimi *@
        <div class="ws-custom-dropdown dropdown">
            <div class="ws-filter-item" data-bs-toggle="dropdown" id="warehouseFilterTrigger">
                <i data-lucide="warehouse"></i>
                <span id="selectedWarehouse" class="ws-filter-el">Tüm Depolar</span>
                <i data-lucide="chevron-down" class="ws-filter-chevron ws-dropdown-icon"></i>
            </div>
            <ul class="dropdown-menu ws-dropdown-premium">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('Warehouse', 'all')"><i data-lucide="layers"></i> Tüm Depolar</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="StockMovementManager.updateFilter('Warehouse', 'Ana Depo')"><i data-lucide="database"></i> Ana Depo</a></li>
            </ul>
        </div>

        @* Tarih Filtresi *@
        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            <input type="text" class="ws-filter-el ws-datepicker" id="dateFilter" placeholder="Tarih Seçin" readonly>
        </div>
    </div>

    @* --- 3. PREMIUM TABLO YAPISI (table.scss uyumlu) --- *@
    <div class="ws-table-wrapper">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th>HAREKET NO</th>
                    <th>ÜRÜN / KOD</th>
                    <th>DEPO</th>
                    <th>TİP</th>
                    <th>MİKTAR</th>
                    <th>TARİH</th>
                    <th>DURUM</th>
                    <th class="ws-table-actions">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="ws-td-bold">#SH-@item.Id.ToString().Substring(0, 4).ToUpper()</td>
                        <td>
                            <div class="ws-td-main-text">@(item.Product?.ProductDefinition?.Name ?? "Belirsiz Ürün")</div>
                            <small class="text-muted">SKU-@item.ProductId</small>
                        </td>
                        <td>Ana Depo</td>
                        <td>
                            @{
                                string statusClass = item.MovementType == "Giriş" ? "ws-status-success" : (item.MovementType == "Çıkış" ? "ws-status-danger" : "ws-status-warning");
                                string moveIcon = item.MovementType == "Giriş" ? "trending-up" : (item.MovementType == "Çıkış" ? "trending-down" : "shuffle");
                            }
                            <span class="ws-status-pill @statusClass">
                                <i data-lucide="@moveIcon"></i> @item.MovementType
                            </span>
                        </td>
                        <td><span class="ws-td-bold" style="font-size: 15px;">@item.Quantity Adet</span></td>
                        <td>@item.CreatedDate?.ToString("dd.MM.yyyy")</td>
                        <td><span class="ws-status-pill ws-status-success">Tamamlandı</span></td>
                        <td>
                            <div class="ws-table-actions">
                                <button onclick="GlobalUI.openModal('/StockMovement/Edit/@item.Id')" class="ws-btn-icon ws-action-btn" title="Düzenle">
                                    <i data-lucide="edit-3"></i>
                                </button>
                                <button onclick="StockMovementManager.deleteMovement('@item.Id')" class="ws-btn-icon ws-action-btn text-danger" title="Sil">
                                    <i data-lucide="trash-2"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="~/js/stock-movement/stock-movement.js" asp-append-version="true"></script>
}