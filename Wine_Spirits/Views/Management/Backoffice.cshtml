@model IEnumerable<Wine_Spirits.Models.SupportRequest>
@{
    ViewData["Title"] = "Talep Yönetimi";
    Layout = "_Layout";
}

<div class="dashboard-v2-container mt-4 px-4">
    @* Kendi TagHelper'ını burada da kullanıyoruz *@
    <ws-page-header title="Backoffice" subtitle="Kullanıcılardan gelen yeni veri tanımlama taleplerini yönetin.">
        <div class="badge bg-primary bg-opacity-10 text-primary p-2 px-3 rounded-pill shadow-sm">
            <i data-lucide="bell" class="me-1" style="width:16px;"></i> @Model.Count() Bekleyen Talep
        </div>
    </ws-page-header>

    <div class="ws-card border-0 shadow-sm rounded-4 overflow-hidden bg-white mt-4">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4 py-3 text-muted small uppercase">Talep Tipi</th>
                        <th class="py-3 text-muted small uppercase">Önerilen İsim</th>
                        <th class="py-3 text-muted small uppercase">Tarih</th>
                        <th class="text-end pe-4 py-3 text-muted small uppercase">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id" class="border-bottom-0">
                            <td class="ps-4">
                                <span class="badge bg-indigo-50 text-indigo-600 border border-indigo-100 px-3 py-2">
                                    @item.RequestType
                                </span>
                            </td>
                            <td><span class="fw-bold text-dark">@item.SuggestedName</span></td>
                            <td class="text-muted small">
                                @(item.CreatedDate is DateTime dt ? dt.ToString("dd.MM.yyyy HH:mm") : item.CreatedDate)
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button onclick="processRequest('@item.Id', 'Approve')" class="btn btn-sm btn-success d-flex align-items-center gap-1 px-3 shadow-sm">
                                        <i data-lucide="check" style="width:14px;"></i> Onayla
                                    </button>
                                    <button onclick="processRequest('@item.Id', 'Reject')" class="btn btn-sm btn-outline-danger d-flex align-items-center gap-1 px-3">
                                        <i data-lucide="x" style="width:14px;"></i> Reddet
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <div class="bg-light d-inline-block p-4 rounded-circle mb-3">
                        <i data-lucide="check-circle" class="opacity-50 text-success" style="width:48px; height:48px;"></i>
                    </div>
                    <p class="fw-medium">Harika! Bekleyen hiçbir talep bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/management/backoffice.js" asp-append-version="true"></script>
}