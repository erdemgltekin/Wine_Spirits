@model IEnumerable<Wine_Spirits.Models.SupportRequest>
@{
    ViewData["Title"] = "Backoffice - Talep Yönetimi";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h3 fw-bold text-dark">Backoffice</h1>
            <p class="text-muted">Kullanıcılardan gelen yeni veri tanımlama talepleri.</p>
        </div>
        <div class="badge bg-indigo p-2 px-3 shadow-sm">
            <i data-lucide="bell" class="me-1" style="width:16px;"></i> @Model.Count() Bekleyen Talep
        </div>
    </div>

    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="bg-light">
                    <tr>
                        <th class="ps-4">Talep Tipi</th>
                        <th>Önerilen İsim</th>
                        <th>Tarih</th>
                        <th class="text-end pe-4">İşlemler</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr id="row-@item.Id">
                            <td class="ps-4">
                                <span class="badge bg-light text-indigo border">@item.RequestType</span>
                            </td>
                            <td class="fw-bold">@item.SuggestedName</td>
                            <td class="text-muted small">
                                @(item.CreatedDate is DateTime dt ? dt.ToString("dd.MM.yyyy HH:mm") : item.CreatedDate)
                            </td>
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">
                                    <button onclick="processRequest('@item.Id', 'Approve')" class="btn btn-sm btn-success px-3">
                                        <i data-lucide="check" style="width:14px;"></i> Onayla
                                    </button>
                                    <button onclick="processRequest('@item.Id', 'Reject')" class="btn btn-sm btn-outline-danger px-3">
                                        <i data-lucide="x" style="width:14px;"></i> Reddet
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @if (!Model.Any())
            {
                <div class="p-5 text-center text-muted">
                    <i data-lucide="check-circle" class="mb-3 opacity-50" style="width:48px; height:48px;"></i>
                    <p>Bekleyen yeni talep bulunmuyor.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function processRequest(id, action) {
            if (!confirm('Bu işlemi onaylıyor musunuz?')) return;

            $.ajax({
                url: `/Management/${action}Request`,
                type: 'POST',
                data: { id: id },
                success: function(response) {
                    if (response.success) {
                        $(`#row-${id}`).fadeOut(300, function() { $(this).remove(); });
                        showStatusToast(response.message, 'check-circle', true);
                    } else {
                        alert(response.message);
                    }
                }
            });
        }
        lucide.createIcons();
    </script>
}
