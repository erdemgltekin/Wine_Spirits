@model IEnumerable<Wine_Spirits.Models.AppUser>
@{
    Layout = "_Layout"; // Bu sayfanın ana temayı kullanmasını sağlar
    ViewData["Title"] = "Ayarlar";
    ViewData["Subtitle"] = "Sistem ayarlarınızı ve personel listesini yönetin";
}

<partial name="Partials/_PageHeader" />

<div class="ws-tabs-wrapper mb-4">
    <ul class="nav nav-tabs border-0" id="settingsTabs" role="tablist">
        <li class="nav-item">
            <button class="nav-link active" id="profile-tab" data-bs-toggle="tab" data-bs-target="#profileContent" type="button">
                <i data-lucide="user" class="me-2"></i>Profil
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link" id="users-tab" data-bs-toggle="tab" data-bs-target="#usersContent" type="button">
                <i data-lucide="users" class="me-2"></i>Kullanıcı Listesi
            </button>
        </li>
    </ul>
</div>

<div class="tab-content">
    @* Profil Sekmesi *@
    <div class="tab-pane fade show active" id="profileContent">
        <div class="ws-card p-4">
            @* Buraya daha önce verdiğim profil formu kodlarını ekleyebilirsin *@
            <p>Profil bilgileriniz burada listelenir.</p>
        </div>
    </div>

    @* Kullanıcı Listesi Sekmesi *@
    <div class="tab-pane fade" id="usersContent">
        <div class="ws-card p-4">
            <button class="btn btn-primary mb-3" data-drawer="true" data-url="/Management/CreateUser">Yeni Personel</button>
            @* Tablo kodların buraya gelecek *@
        </div>
    </div>
</div>