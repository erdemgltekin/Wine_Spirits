@{
    ViewData["Title"] = "Yetkisiz Erişim";
    Layout = "_Layout";
}

<div class="container-fluid d-flex align-items-center justify-content-center" style="min-height: 80vh;">
    <div class="text-center">
        <div class="mb-4">
            <i data-lucide="shield-alert" style="width: 100px; height: 100px; color: var(--rose);"></i>
        </div>
        <h1 class="display-5 fw-bold text-dark">Erişim Engellendi</h1>
        <p class="lead text-muted mb-4">Bu sayfayı görüntülemek için gerekli yetkilere sahip değilsiniz.</p>
        <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary px-5">
            <i data-lucide="arrow-left" class="me-2"></i> Ana Sayfaya Dön
        </a>
    </div>
</div>

