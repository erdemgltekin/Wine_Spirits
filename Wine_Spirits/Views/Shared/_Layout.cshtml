<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wine & Spirits</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Temel Layout Stilleri *@
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Flatpickr - Premium Tarih Seçici *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    @* Google Fonts - Inter *@
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ws-layout-body">

    @* --- TOPBAR (Figma Tasarımı: Beyaz, Sade ve Hizalı) --- *@
    <header class="ws-topbar shadow-sm">
        <div class="d-flex align-items-center">
            @* Minimal Hamburger Menu (Siyah kutu kaldırıldı, Figma stili gri tona çekildi) *@
            <button class="sidebar-toggler-btn me-3" id="sidebarToggle" type="button">
                <i data-lucide="menu"></i>
            </button>

            @* Logo Alanı (Başlık zaten Wine & Spirits olduğu için sadece ikon veya marka vurgusu yeterli) *@
            <div class="d-flex align-items-center">
                <i data-lucide="wine" class="text-primary me-2" style="width: 24px; height: 24px;"></i>
                <span class="fw-bold text-dark fs-5" style="letter-spacing: -0.5px;">Wine & Spirits</span>
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            @* Notifications *@
            <div class="dropdown">
                @{
                    int notificationCount = 0;
                }
                <a href="#" class="position-relative cursor-pointer text-decoration-none" id="notificationDropdown" data-bs-toggle="dropdown">
                    <i data-lucide="bell" class="text-muted" style="width: 20px;"></i>
                    @if (notificationCount > 0)
                    {
                        <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger border border-white p-1" style="font-size: 0.5rem;">
                            @notificationCount
                        </span>
                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-3 mt-2" style="border-radius: 16px; min-width: 300px;">
                    <li><h6 class="dropdown-header text-dark fw-bold px-0 pb-2 border-bottom">Bildirimler</h6></li>
                    <li class="py-4 text-center text-muted small">Henüz yeni bildirim yok</li>
                </ul>
            </div>

            @* User Profile *@
            <div class="dropdown ps-3 border-start">
                <div class="d-flex align-items-center gap-2 cursor-pointer" id="userDropdown" data-bs-toggle="dropdown">
                    <div class="text-end d-none d-sm-block line-height-sm">
                        <span class="d-block fw-bold text-dark" style="font-size: 0.85rem;">Admin Kullanıcı</span>
                        <span class="d-block text-muted" style="font-size: 0.75rem;">Yönetici</span>
                    </div>
                    <div class="bg-primary text-white rounded-circle d-flex align-items-center justify-content-center fw-bold shadow-sm" style="width: 38px; height: 38px; font-size: 0.9rem;">
                        A
                    </div>
                </div>
                <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 mt-2" style="border-radius: 12px; min-width: 200px;">
                    <li><a class="dropdown-item py-2" href="#"><i data-lucide="user" class="me-2" style="width:16px;"></i> Profilim</a></li>
                    <li><a class="dropdown-item py-2" href="#"><i data-lucide="settings" class="me-2" style="width:16px;"></i> Ayarlar</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger d-flex align-items-center gap-2 py-2" asp-controller="Auth" asp-action="Logout">
                            <i data-lucide="log-out" style="width: 16px;"></i> Çıkış Yap
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

    @* --- SIDEBAR --- *@
    <aside class="sidebar" id="sidebar">
        <div class="sidebar-header d-flex align-items-center justify-content-end p-3 d-md-none">
            <button class="btn-close" id="sidebarClose"></button>
        </div>
        <partial name="Partials/_Sidebar" />
    </aside>

    @* --- MAIN CONTENT --- *@
    <main class="main-content">
        <div class="container-fluid p-4">
            @RenderBody()
        </div>
    </main>

    @* --- SIDE PANEL OVERLAY & PANEL (Drawer) --- *@
    <div id="sidePanelOverlay"></div>
    <div id="sidePanel">
        <div class="drawer-header d-flex align-items-center justify-content-between p-3 border-bottom">
            <h5 id="sidePanelTitle" class="mb-0 fw-bold fs-6">Yükleniyor...</h5>
            <button type="button" class="btn-close" id="closeSidePanel" style="font-size: 0.7rem;"></button>
        </div>
        <div id="sidePanelContent"></div>
    </div>

    @* --- GLOBAL MODAL --- *@
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" id="globalModalDialog">
            <div class="modal-content border-0 shadow-lg" style="border-radius: 20px; overflow: hidden;">
                <div id="productModalBody"></div>
            </div>
        </div>
    </div>

    @* --- TOAST BİLDİRİMLERİ --- *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3" style="z-index: 9999;">
        <div id="statusToast" class="toast align-items-center text-white bg-dark border-0 shadow-lg" role="alert" aria-live="assertive" aria-atomic="true" style="border-radius: 12px;">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center">
                    <i id="toastIcon" data-lucide="check-circle" class="me-2" style="width: 18px;"></i>
                    <span id="toastMessage">İşlem başarıyla tamamlandı.</span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    @* --- SCRIPTS --- *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>