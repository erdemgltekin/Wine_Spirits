<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wine & Spirits</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* Select2 - Premium Dropdown *@
    <link href="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/css/select2.min.css" rel="stylesheet" />
    @* Temel Layout Stilleri *@
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @* Flatpickr - Premium Tarih Seçici *@
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    @* Google Fonts - Inter *@
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ws-layout-body">

    @* --- TOPBAR --- *@
    <header class="ws-topbar">
        <div class="ws-topbar-left">
            <button class="sidebar-toggler-btn" id="sidebarToggle" type="button">
                <i data-lucide="menu"></i>
            </button>

            <a href="/" class="ws-brand">
                <i data-lucide="wine" class="ws-brand-logo"></i>
                <span class="ws-brand-text">Wine & Spirits</span>
            </a>
        </div>

        <div class="ws-topbar-actions">
            @* Notifications *@
            <div class="dropdown">
                @{
                    int notificationCount = 0; // Test: Bildirim sayısı
                }
                <a href="#" class="ws-notification-trigger" id="notificationDropdown" data-bs-toggle="dropdown">
                    <i data-lucide="bell" class="ws-nav-icon"></i>
                    @if (notificationCount > 0)
                    {
                        <span class="ws-notification-badge">
                            @notificationCount
                        </span>
                    }
                </a>
                <ul class="dropdown-menu dropdown-menu-end ws-dropdown-notification">
                    <li><h6 class="dropdown-header">Bildirimler</h6></li>
                    <li class="ws-dropdown-empty">Henüz yeni bildirim yok</li>
                </ul>
            </div>

            @* User Profile *@
            <div class="dropdown ws-topbar-profile-wrapper">
                <div class="ws-user-profile" id="userDropdown" data-bs-toggle="dropdown">
                    <div class="ws-user-info">
                        <span class="ws-user-name">Admin Kullanıcı</span>
                        <span class="ws-user-role">Yönetici</span>
                    </div>
                    <div class="ws-user-avatar">A</div>
                </div>
                <ul class="dropdown-menu dropdown-menu-end ws-dropdown-profile">
                    <li><a class="dropdown-item" href="#"><i data-lucide="user" class="ws-item-icon"></i> Profilim</a></li>
                    <li><a class="dropdown-item" href="#"><i data-lucide="settings" class="ws-item-icon"></i> Ayarlar</a></li>
                    <li><hr class="dropdown-divider"></li>
                    <li>
                        <a class="dropdown-item text-danger" asp-controller="Auth" asp-action="Logout">
                            <i data-lucide="log-out" class="ws-item-icon"></i> Çıkış Yap
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </header>

   
    @* --- SIDEBAR --- *@
    <aside class="sidebar" id="sidebar">
        <partial name="Partials/_Sidebar" />
    </aside>

    @* --- MAIN CONTENT --- *@
    <main class="main-content">
        <div class="ws-content-container">
            @RenderBody()
        </div>
    </main>

    @* --- SIDE PANEL OVERLAY & PANEL --- *@
    <div id="sidePanelOverlay"></div>
    <div id="sidePanel">
        <div class="ws-drawer-header">
            <h5 id="sidePanelTitle" class="ws-drawer-title">Yükleniyor...</h5>
            <button type="button" class="btn-close ws-drawer-close" id="closeSidePanel"></button>
        </div>
        <div id="sidePanelContent"></div>
    </div>

    @* --- GLOBAL MODAL --- *@
    <div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered" id="globalModalDialog">
            <div class="modal-content ws-modal-custom">
                <div id="productModalBody"></div>
            </div>
        </div>
    </div>

    @* --- TOAST BİLDİRİMLERİ --- *@
    <div class="ws-toast-container">
        <div id="statusToast" class="toast ws-status-toast" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="toast-body">
                <i id="toastIcon" data-lucide="check-circle" class="ws-toast-icon"></i>
                <span id="toastMessage">İşlem başarıyla tamamlandı.</span>
                <button type="button" class="btn-close ws-toast-close" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    @* --- SCRIPTS --- *@
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    @* Select2 JS *@
    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    @* Lucide - İkonlar *@
    <script src="https://unpkg.com/lucide@latest"></script>

    @* Flatpickr Kütüphanesi ve TR Dil Desteği *@
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://npmcdn.com/flatpickr/dist/l10n/tr.js"></script>

    @* SweetAlert - Modern Uyarılar *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    @* Senin Global Scriptin *@
    <script src="https://unpkg.com/lucide@latest"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>