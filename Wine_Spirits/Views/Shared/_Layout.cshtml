<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Wine & Spirits</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    @* CSS dosyalarının sırası önemlidir, en son site.css yüklenmeli *@
    <link rel="stylesheet" href="~/css/main.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="ws-layout-body">

    @* Sidebar - Dosya yolunu Partials olarak güncelledik *@
    <div class="sidebar">
        <partial name="Partials/_Sidebar" />
    </div>

    @* Main Content - Sidebar genişliği kadar margin-left CSS ile verilmelidir *@
    <main class="main-content">
        @RenderBody()
    </main>

    @* Side Panel (Drawer) Yapısı *@
    <div id="sidePanelOverlay"></div>
    <div id="sidePanel">
        <div class="drawer-header">
            <h5 class="fw-bold mb-0 text-dark" id="sidePanelTitle">Yükleniyor...</h5>
            <button type="button" class="btn-close" id="closeSidePanel"></button>
        </div>
        <div id="sidePanelContent"></div>
    </div>

    @* Toast Bildirimleri *@
    <div class="toast-container position-fixed bottom-0 end-0 p-3">
        <div id="statusToast" class="toast align-items-center text-white bg-dark border-0" role="alert" aria-live="assertive" aria-atomic="true">
            <div class="d-flex">
                <div class="toast-body d-flex align-items-center">
                    <i id="toastIcon" data-lucide="check-circle" class="me-2"></i>
                    <span id="toastMessage"></span>
                </div>
                <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast"></button>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/side-panel.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
    <script>
        if (typeof lucide !== 'undefined') lucide.createIcons();
    </script>
</body>
</html>