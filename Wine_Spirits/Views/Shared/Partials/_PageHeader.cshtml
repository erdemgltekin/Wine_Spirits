@model dynamic

<div class="ws-page-header">
    <div>
        <h1 class="ws-page-title">@ViewData["Title"]</h1>
        @if (ViewData["Subtitle"] != null)
        {
            <p class="ws-page-subtitle mb-0">@ViewData["Subtitle"]</p>
        }
    </div>
    <div class="d-flex gap-3">
        @RenderSection("HeaderActions", required: false)
    </div>
</div>
