@model Wine_Spirits.Models.AppUser

<form id="createUserForm" asp-controller="Management" asp-action="CreateUser" method="post">
    @Html.AntiForgeryToken()
    <div class="row g-3 p-3">
        <div class="col-12">
            <label class="form-label fw-bold">Ad Soyad</label>
            <input asp-for="FullName" class="form-control" placeholder="Örn: Ahmet Yılmaz" required>
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Kullanıcı Adı</label>
            <input asp-for="Username" class="form-control" placeholder="Örn: ahmety" required>
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Şifre</label>
            <input type="password" name="plainPassword" class="form-control" required>
        </div>
        <div class="col-12">
            <label class="form-label fw-bold">Pozisyon</label>
            <select asp-for="Position" class="form-select">
                <option value="Personel">Personel</option>
                <option value="Müdür Yardımcısı">Müdür Yardımcısı</option>
                <option value="Müdür">Müdür</option>
                <option value="Sistem Yöneticisi">Sistem Yöneticisi</option>
            </select>
            <small class="text-muted small">Pozisyona göre sistem rolü otomatik atanır.</small>
        </div>
        <div class="col-12 mt-4">
            <button type="submit" class="btn btn-primary w-100 py-2">Kaydet ve Ekle</button>
        </div>
    </div>
</form>