@model Wine_Spirits.Models.ViewModels.StatCardViewModel

<div class="ws-card ws-stat-card" ws-stat="@Model.StatKey">
    <div class="d-flex align-items-center justify-content-between mb-3">
        <div class="ws-icon-box @Model.IconClass">
            <i data-lucide="@Model.Icon"></i>
        </div>
    </div>
    <div>
        <div class="text-muted small fw-medium mb-1">@Model.Label</div>
        <div class="h4 fw-bold mb-0">
            @* JS buradaki span'ı hedef alacak *@
            <span class="ws-stat-value">@Model.Value</span>
        </div>
    </div>
</div>