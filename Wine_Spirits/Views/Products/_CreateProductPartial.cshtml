@model Wine_Spirits.Models.Product

<div class="modal-header border-0 pb-0 pt-4 px-4">
    <h5 class="modal-title fw-bold text-dark" style="letter-spacing:-0.5px;">Yeni Ürün Ekle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>

<form asp-action="Create" id="createProductForm">
    @Html.AntiForgeryToken()
    <div class="modal-body p-4">
        <div class="mb-3">
            <label class="ws-form-label">Ürün Tanımı / Adı *</label>
            <select asp-for="ProductDefinitionId" class="form-select ws-input-premium select2-enable" asp-items="ViewBag.ProductDefinitionId">
                <option value="">Ürün seçiniz...</option>
            </select>
        </div>

        <div class="row g-3">
            <div class="col-12">
                <label class="ws-form-label">Kategori</label>
                <select asp-for="ProductCategoryId" class="form-select ws-input-premium" asp-items="ViewBag.ProductCategoryId"></select>
            </div>

            <div class="col-md-6">
                <label class="ws-form-label">Birim *</label>
                <select asp-for="UnitId" class="form-select ws-input-premium" asp-items="ViewBag.UnitId"></select>
            </div>

            <div class="col-md-6">
                <label class="ws-form-label">Stok Miktarı</label>
                <input asp-for="StockQuantity" class="form-control ws-input-premium" type="number" placeholder="0">
            </div>

            <div class="col-12">
                <label class="ws-form-label">Satış Fiyatı (₺)</label>
                <input asp-for="Price" class="form-control ws-input-premium" type="number" step="0.01" placeholder="0.00">
            </div>

            <div class="col-md-6">
                <label class="ws-form-label">Tedarikçi</label>
                <select asp-for="SupplierId" class="form-select ws-input-premium" asp-items="ViewBag.SupplierId"></select>
            </div>

            <div class="col-md-6">
                <label class="ws-form-label">Menşei Ülke</label>
                <select asp-for="CountryId" class="form-select ws-input-premium" asp-items="ViewBag.CountryId"></select>
            </div>
        </div>
    </div>

    <div class="modal-footer border-0 p-4 pt-0 d-flex gap-2">
        <button type="button" class="ws-btn-secondary flex-grow-1" data-bs-dismiss="modal">İptal</button>
        <button type="submit" class="ws-btn-main flex-grow-1 justify-content-center py-2" style="border-radius:14px;">Ürünü Kaydet</button>
    </div>
</form>