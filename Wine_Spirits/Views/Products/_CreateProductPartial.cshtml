@model Wine_Spirits.Models.Product

@* Formu en dışa alıyoruz ki içindeki Header-Body-Footer yapısı SCSS ile tam uyumlu olsun *@
<form asp-action="Create" id="createProductModalForm" class="modal-content">
    @Html.AntiForgeryToken()

    <div class="ws-modal-header">
        <h5 class="ws-modal-title">Yeni Ürün Ekle</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
    </div>

    <div class="ws-modal-body">
        <div class="ws-form-group">
            <label class="ws-form-label">Ürün Tanımı / Adı *</label>
            <div class="ws-filter-item">
                <i data-lucide="package"></i>
                <select asp-for="ProductDefinitionId" class="ws-filter-el ws-input-premium select2-enable" asp-items="ViewBag.ProductDefinitionId">
                    <option value="">Ürün seçiniz...</option>
                </select>
            </div>
            <span asp-validation-for="ProductDefinitionId" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Kategori</label>
            <div class="ws-filter-item">
                <i data-lucide="tag"></i>
                <select asp-for="ProductCategoryId" class="ws-filter-el ws-input-premium select2-enable" asp-items="ViewBag.ProductCategoryId"></select>
            </div>
            <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Birim *</label>
            <div class="ws-filter-item">
                <i data-lucide="box"></i>
                <select asp-for="UnitId" class="ws-filter-el ws-input-premium select2-enable" asp-items="ViewBag.UnitId"></select>
            </div>
            <span asp-validation-for="UnitId" class="text-danger"></span>
        </div>

        <div class="ws-form-group">
            <label class="ws-form-label">Stok Miktarı</label>
            <div class="ws-filter-item">
                <i data-lucide="database"></i>
                <input asp-for="StockQuantity" class="ws-filter-el ws-input-premium" type="number" placeholder="0">
                </div>
                <span asp-validation-for="StockQuantity" class="text-danger"></span>
            </div>

            <div class="ws-form-group">
                <label class="ws-form-label">Satış Fiyatı (₺)</label>
                <div class="ws-filter-item">
                    <i data-lucide="banknote"></i>
                    <input asp-for="Price" class="ws-filter-el ws-input-premium" type="number" step="0.01" placeholder="0.00">
                    </div>
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>

                <div class="ws-form-group">
                    <label class="ws-form-label">Tedarikçi</label>
                    <div class="ws-filter-item">
                        <i data-lucide="truck"></i>
                        <select asp-for="SupplierId" class="ws-filter-el ws-input-premium select2-enable" asp-items="ViewBag.SupplierId"></select>
                    </div>
                    <span asp-validation-for="SupplierId" class="text-danger"></span>
                </div>

                <div class="ws-form-group">
                    <label class="ws-form-label">Menşei Ülke</label>
                    <div class="ws-filter-item">
                        <i data-lucide="globe"></i>
                        <select asp-for="CountryId" class="ws-filter-el ws-input-premium select2-enable" asp-items="ViewBag.CountryId"></select>
                    </div>
                    <span asp-validation-for="CountryId" class="text-danger"></span>
                </div>
            </div>

            <div class="ws-form-actions">
                <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">İptal</button>
                <button type="submit" class="ws-btn-main">Ürünü Kaydet</button>
            </div>
        </form>