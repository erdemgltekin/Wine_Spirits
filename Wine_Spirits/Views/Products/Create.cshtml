@model Wine_Spirits.Models.Product
@{
    @* AJAX ile mi normal mi çağrıldığını kontrol eder *@
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
}

@* ─── MODAL HEADER ─── *@
<div class="ws-modal-header">
    <h5 class="ws-modal-title">Yeni Ürün Ekle</h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Kapat">
        <i data-lucide="x"></i>
    </button>
</div>

@* ─── ERROR BANNER ─── *@
<div id="formErrorPanel" class="ws-error-panel ws-error-panel--hidden">
    <i data-lucide="alert-circle"></i>
    <div id="errorText">Lütfen formdaki eksiklikleri kontrol edin.</div>
</div>

@* ─── FORM ─── *@
<form asp-action="Create" id="createProductForm" method="post" autocomplete="off">
    @Html.AntiForgeryToken()

    <div class="ws-modal-body">

        @* Row 1 — Ürün Tanımı: full-width via SCSS .ws-form-group:first-child { grid-column: span 2 } *@
        <div class="ws-form-group">
            <label asp-for="ProductDefinitionId" class="ws-form-label">Ürün Adı / Tanımı</label>
            <div class="ws-filter-item">
                <i data-lucide="package"></i>
                <select asp-for="ProductDefinitionId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.ProductDefinitionId"
                        required>
                    <option value="">-- Ürün Tanımı Seçin --</option>
                </select>
            </div>
            <span asp-validation-for="ProductDefinitionId" class="text-danger"></span>
        </div>

        @* Row 2: Sol — Kategori *@
        <div class="ws-form-group">
            <label asp-for="ProductCategoryId" class="ws-form-label">Kategori</label>
            <div class="ws-filter-item">
                <i data-lucide="tag"></i>
                <select asp-for="ProductCategoryId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.ProductCategoryId"
                        required>
                    <option value="">-- Kategori --</option>
                </select>
            </div>
            <span asp-validation-for="ProductCategoryId" class="text-danger"></span>
        </div>

        @* Row 2: Sağ — Ölçü Birimi *@
        <div class="ws-form-group">
            <label asp-for="UnitId" class="ws-form-label">Ölçü Birimi</label>
            <div class="ws-filter-item">
                <i data-lucide="box"></i>
                <select asp-for="UnitId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.UnitId"
                        required>
                    <option value="">-- Birim (Şişe, Adet vb.) --</option>
                </select>
            </div>
            <span asp-validation-for="UnitId" class="text-danger"></span>
        </div>

        @* Row 3: Sol — Tedarikçi *@
        <div class="ws-form-group">
            <label asp-for="SupplierId" class="ws-form-label">Tedarikçi</label>
            <div class="ws-filter-item">
                <i data-lucide="truck"></i>
                <select asp-for="SupplierId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.SupplierId"
                        required>
                    <option value="">-- Tedarikçi Seçin --</option>
                </select>
            </div>
            <span asp-validation-for="SupplierId" class="text-danger"></span>
        </div>

        @* Row 3: Sağ — Menşei Ülke *@
        <div class="ws-form-group">
            <label asp-for="CountryId" class="ws-form-label">Menşei Ülke</label>
            <div class="ws-filter-item">
                <i data-lucide="globe"></i>
                <select asp-for="CountryId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.CountryId"
                        required>
                    <option value="">-- Ülke --</option>
                </select>
            </div>
            <span asp-validation-for="CountryId" class="text-danger"></span>
        </div>

        @* Row 4: Sol — Mevcut Stok *@
        <div class="ws-form-group">
            <label asp-for="StockQuantity" class="ws-form-label">Mevcut Stok</label>
            <div class="ws-filter-item">
                <i data-lucide="database"></i>
                <input asp-for="StockQuantity"
                       type="number"
                       class="ws-filter-el"
                       value="0"
                       min="0" />
            </div>
            <span asp-validation-for="StockQuantity" class="text-danger"></span>
        </div>

        @* Row 4: Sağ — Birim Fiyat *@
        <div class="ws-form-group">
            <label asp-for="Price" class="ws-form-label">Birim Fiyat (₺)</label>
            <div class="ws-filter-item">
                <i data-lucide="banknote"></i>
                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       class="ws-filter-el"
                       placeholder="0.00"
                       required />
            </div>
            <span asp-validation-for="Price" class="text-danger"></span>
        </div>

        @* Row 5: Sol — Üretim Yılı *@
        <div class="ws-form-group">
            <label asp-for="Year" class="ws-form-label">Üretim Yılı / Rezerve</label>
            <div class="ws-filter-item">
                <i data-lucide="calendar"></i>
                <input asp-for="Year"
                       type="number"
                       class="ws-filter-el"
                       value="@DateTime.Now.Year" />
            </div>
            <span asp-validation-for="Year" class="text-danger"></span>
        </div>

        @* Row 5: Sağ — Hedef Depo *@
        <div class="ws-form-group">
            <label class="ws-form-label">Hedef Depo</label>
            <div class="ws-filter-item">
                <i data-lucide="warehouse"></i>
                <select asp-for="WarehouseId"
                        class="ws-filter-el select2-enable"
                        asp-items="ViewBag.WarehouseId">
                    <option value="">Varsayılan Depo (Otomatik)</option>
                </select>
            </div>
        </div>

    </div>@* /.ws-modal-body *@

    @* ─── FOOTER ACTIONS ─── *@
    <div class="ws-form-actions">
        <button type="button" class="ws-btn-secondary" data-bs-dismiss="modal">
            Vazgeç
        </button>
        <button type="submit" class="ws-btn-main">
            <i data-lucide="check"></i>
            Ürünü Envantere Ekle
        </button>
    </div>

</form>

@* Script silindi, site.js üzerinden global olarak yönetiliyor *@