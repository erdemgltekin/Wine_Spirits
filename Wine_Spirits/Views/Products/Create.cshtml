@model Wine_Spirits.Models.Product
@{
    Layout = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest" ? null : "_Layout";
}

<div class="p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h4 class="mb-0 fw-bold text-dark">Yeni Ürün Ekle</h4>
        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
    </div>

    <form asp-action="Create" id="createProductForm" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            @* Ürün Adı *@
            <div class="col-12">
                <label class="form-label fw-bold">Ürün Tanımı</label>
                <select asp-for="ProductDefinitionId" class="form-select shadow-sm" asp-items="ViewBag.ProductDefinitionId" required>
                    <option value="">-- Ürün Seçiniz --</option>
                </select>
            </div>

            @* Kategori ve Birim *@
            <div class="col-md-6">
                <label class="form-label fw-bold">Kategori</label>
                <select asp-for="ProductCategoryId" class="form-select shadow-sm" asp-items="ViewBag.ProductCategoryId" required>
                    <option value="">-- Kategori Seçiniz --</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Ölçü Birimi</label>
                <select asp-for="UnitId" class="form-select shadow-sm" asp-items="ViewBag.UnitId" required>
                    <option value="">-- Birim Seçiniz --</option>
                </select>
            </div>

            @* Tedarikçi ve Ülke *@
            <div class="col-md-6">
                <label class="form-label fw-bold">Tedarikçi</label>
                <select asp-for="SupplierId" class="form-select shadow-sm" asp-items="ViewBag.SupplierId" required>
                    <option value="">-- Tedarikçi Seçiniz --</option>
                </select>
            </div>

            <div class="col-md-6">
                <label class="form-label fw-bold">Menşei Ülke</label>
                <select asp-for="CountryId" class="form-select shadow-sm" asp-items="ViewBag.CountryId" required>
                    <option value="">-- Ülke Seçiniz --</option>
                </select>
            </div>

            @* Sayısal Alanlar *@
            <div class="col-md-4">
                <label class="form-label fw-bold">Stok Miktarı</label>
                <input asp-for="StockQuantity" type="number" class="form-control shadow-sm" value="0" min="0" />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Birim Fiyat (₺)</label>
                <input asp-for="Price" type="number" step="0.01" class="form-control shadow-sm" placeholder="0.00" required />
            </div>

            <div class="col-md-4">
                <label class="form-label fw-bold">Üretim Yılı</label>
                <input asp-for="Year" type="number" class="form-control shadow-sm" value="@DateTime.Now.Year" />
            </div>
        </div>

        <div class="mt-4 pt-3 border-top d-flex justify-content-end gap-2">
            <button type="button" class="btn btn-light px-4" data-bs-dismiss="modal">İptal</button>
            <button type="submit" class="btn btn-primary px-4 fw-bold shadow-sm">Ürünü Kaydet</button>
        </div>
    </form>
</div>