@model Wine_Spirits.Models.Product
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Ürün Sil";
    Layout = "_Layout";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm border-0">
                <div class="card-body p-5 text-center">
                    
                    <div class="mb-4 text-danger">
                        <i data-lucide="alert-triangle" style="width: 64px; height: 64px;"></i>
                    </div>

                    <h4 class="mb-3">Emin misiniz?</h4>
                    <p class="text-muted mb-4">
                        <strong>@(Model.ProductDefinition?.Name ?? "Tanımsız Ürün")</strong> ürününü silmek üzeresiniz. <br/>
                        Bu işlem geri alınamaz.
                    </p>
                    
                    <!-- Özet Bilgi -->
                    <div class="bg-light p-3 rounded mb-4 text-start">
                        <small class="text-muted d-block">Stok: @Model.StockQuantity @Model.Unit?.Name</small>
                        <small class="text-muted d-block">Tedarikçi: @Model.Supplier?.Name</small>
                    </div>

                    <form asp-action="Delete">
                        <input type="hidden" asp-for="Id" />
                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-danger py-2">
                                <i data-lucide="trash-2" class="me-1" style="width: 18px; vertical-align: text-bottom;"></i>
                                Evet, Sil
                            </button>
                            <a asp-action="Index" class="btn btn-link text-decoration-none text-muted">
                                <i data-lucide="arrow-left" class="me-1" style="width: 18px; vertical-align: text-bottom;"></i>
                                İptal Et ve Dön
                            </a>
                        </div>
                    </form>

                </div>
            </div>
        </div>
    </div>
</div>


