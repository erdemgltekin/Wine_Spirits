@using Wine_Spirits.Models.ViewModels
@model ProductsIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Ürün Envanteri";
    var stats = Model?.Stats ?? new ProductStats();
}

@section Styles {
    <link rel="stylesheet" href="~/css/product/product.css" asp-append-version="true" />
}

<div class="ws-main-container p-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark m-0">Ürün Envanteri</h2>
            <p class="text-muted small mb-0">Premium envanter yönetimi ve stok takibi.</p>
        </div>
        <button type="button" class="ws-btn-main shadow-sm" id="btnCreateNew">
            <i data-lucide="plus"></i> Yeni Ürün Ekle
        </button>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="ws-stat-card-v2 shadow-sm">
                <div class="ws-stat-icon-box bg-indigo-50"><i data-lucide="package"></i></div>
                <div><small class="text-muted d-block">Toplam Ürün</small><span class="fw-bold h5">@stats.TotalProducts</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ws-stat-card-v2 shadow-sm">
                <div class="ws-stat-icon-box bg-rose-50"><i data-lucide="alert-triangle"></i></div>
                <div><small class="text-muted d-block">Kritik Stok</small><span class="fw-bold h5">@stats.CriticalStockCount</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ws-stat-card-v2 shadow-sm">
                <div class="ws-stat-icon-box bg-emerald-50"><i data-lucide="banknote"></i></div>
                <div><small class="text-muted d-block">Envanter Değeri</small><span class="fw-bold h5">@stats.TotalInventoryValue.ToString("C0")</span></div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="ws-stat-card-v2 shadow-sm">
                <div class="ws-stat-icon-box bg-amber-50"><i data-lucide="layers"></i></div>
                <div><small class="text-muted d-block">Kategoriler</small><span class="fw-bold h5">@stats.CategoryCount</span></div>
            </div>
        </div>
    </div>

    <div class="ws-filter-container shadow-sm">
        <div class="ws-filter-item flex-grow-1">
            <i data-lucide="search"></i>
            <input type="text" id="inventorySearch" class="ws-filter-el" placeholder="Ürün veya kod ara...">
        </div>

        <div class="ws-filter-item">
            <i data-lucide="calendar"></i>
            <input type="text" id="dateFilter" class="ws-filter-el" placeholder="Tarih Aralığı" readonly>
        </div>

        <div class="dropdown">
            <button class="ws-btn-filter-action" type="button" data-bs-toggle="dropdown" id="categoryDropdownBtn">
                <i data-lucide="tag"></i> <span id="selectedCategoryText">Kategori</span>
                <i data-lucide="chevron-down" class="ms-2 opacity-50 size-14"></i>
            </button>
            <ul class="dropdown-menu shadow border-0" id="filterCategoryMenu">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="ProductManager.filterCategory('', 'Tüm Kategoriler')">Tüm Kategoriler</a></li>
            </ul>
        </div>

        <div class="dropdown">
            <button class="ws-btn-filter-action" type="button" data-bs-toggle="dropdown">
                <i data-lucide="box"></i> <span id="selectedStockText">Stok Durumu</span>
                <i data-lucide="chevron-down" class="ms-2 opacity-50 size-14"></i>
            </button>
            <ul class="dropdown-menu shadow border-0">
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="ProductManager.filterStock('', 'Stok Durumu')">Tüm Stoklar</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="ProductManager.filterStock('in-stock', 'Stokta Var')">Stokta Var</a></li>
                <li><a class="dropdown-item" href="javascript:void(0)" onclick="ProductManager.filterStock('critical', 'Kritik Stok')">Kritik Stok</a></li>
            </ul>
        </div>

        <div class="dropdown">
            <button class="ws-btn-filter-action" type="button" data-bs-toggle="dropdown">
                <i data-lucide="sliders-horizontal"></i> Sırala
            </button>
            <ul class="dropdown-menu dropdown-menu-end shadow border-0">
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="ProductManager.sort('name-asc')"><i data-lucide="sort-asc" class="me-2 size-18"></i> İsim (A-Z)</a></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="ProductManager.sort('price-desc')"><i data-lucide="trending-up" class="me-2 size-18"></i> En Yüksek Fiyat</a></li>
                <li><hr class="dropdown-divider"></li>
                <li><a class="dropdown-item py-2" href="javascript:void(0)" onclick="ProductManager.sort('stock-desc')"><i data-lucide="package" class="me-2 size-18"></i> Stok (Azalan)</a></li>
            </ul>
        </div>
    </div>

    <div class="ws-table-wrapper">
        <table class="ws-table-premium">
            <thead>
                <tr>
                    <th class="ps-4">KOD</th>
                    <th>ÜRÜN ADI</th>
                    <th>KATEGORİ</th>
                    <th>TEDARİKÇİ</th>
                    <th>FİYAT</th>
                    <th>STOK</th>
                    <th>DURUM</th>
                    <th class="text-end pe-4">İŞLEMLER</th>
                </tr>
            </thead>
            <tbody id="productsTableBody">
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="productModal" tabindex="-1" aria-hidden="true">
    <div id="globalModalDialog" class="modal-dialog modal-dialog-centered ws-modal-md">
        <div class="modal-content border-0 shadow-lg ws-modal-custom">
            <div id="productModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="https://cdn.jsdelivr.net/npm/flatpickr/dist/l10n/tr.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/product/product.js" asp-append-version="true"></script>

    <script>
        $(document).ready(function() {
            if (typeof ProductManager !== 'undefined' && ProductManager.init) {
                ProductManager.init();
            }
            // Lucide ikonlarını başlat
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }
        });
    </script>
}