@using Wine_Spirits.Models.ViewModels
@model Wine_Spirits.Models.ViewModels.ProductsIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Ürünler";
    Layout = "_Layout";
    var stats = Model?.Stats ?? new ProductStats();
    var fmtMoney = new Func<decimal, string>(val => val.ToString("C2", new System.Globalization.CultureInfo("tr-TR")));
}

@section Styles {
    <link rel="stylesheet" href="~/css/pages/product.css" asp-append-version="true" />
}

<div class="ws-product-container">
    <div class="ws-page-header mb-4">
        <div>
            <h2 class="ws-page-title">Ürün Envanteri</h2>
            <p class="ws-page-subtitle">Tüm ürünlerinizi premium bir arayüzle yönetin.</p>
        </div>
        <button type="button" class="ws-btn-primary shadow-sm" id="btnCreateNew">
            <i data-lucide="plus-circle" class="ws-icon-16"></i> Yeni Ürün Ekle
        </button>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "totalProducts", Label = "Toplam Ürün", Value = stats.TotalProducts.ToString(), Icon = "package", IconClass = "bg-indigo-50 text-indigo-600" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "criticalStock", Label = "Kritik Stok", Value = stats.CriticalStockCount.ToString(), Icon = "alert-triangle", IconClass = "bg-rose-50 text-rose-600" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "inventoryValue", Label = "Envanter Değeri", Value = fmtMoney(stats.TotalInventoryValue), Icon = "banknote", IconClass = "bg-emerald-50 text-emerald-600" }' />
        </div>
        <div class="col-xl-3 col-sm-6">
            <partial name="Partials/_StatCard" model='new StatCardViewModel { StatKey = "categoryCount", Label = "Kategoriler", Value = stats.CategoryCount.ToString(), Icon = "layers", IconClass = "bg-amber-50 text-amber-600" }' />
        </div>
    </div>

    <div class="ws-filter-container">
        <div class="row g-3 align-items-center">
            <div class="col-lg-3 col-md-12">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="search"></i></span>
                    <input type="text" class="ws-input-control" placeholder="Ürün adı veya barkod..." id="inventorySearch">
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="layers"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterCategory">
                        <option value="">Kategoriler</option>
                        <option>Şarap</option>
                        <option>Bira</option>
                        <option>Sert Alkol</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-4">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="tag"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterBrand">
                        <option value="">Tüm Markalar</option>
                        <option>Chateau Reserve</option>
                        <option>Vintage Selection</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-3 col-md-4">
                <div class="ws-input-group">
                    <span class="ws-input-icon"><i data-lucide="alert-circle"></i></span>
                    <select class="ws-input-control ws-select-control" id="filterStockStatus">
                        <option value="">Stok Durumu</option>
                        <option value="safe">Yeterli Stok</option>
                        <option value="critical">Kritik Stok (< 10)</option>
                    </select>
                </div>
            </div>
            <div class="col-lg-2 col-md-12">
                <div class="dropdown">
                    <button class="ws-btn-modern-filter dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="d-flex align-items-center gap-2">
                            <i data-lucide="sliders-horizontal" class="ws-icon-18"></i> Filtrele / Sırala
                        </span>
                        <i data-lucide="chevron-down" class="ws-icon-16 opacity-50"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm border-0 mt-2">
                        <li><h6 class="dropdown-header">Sıralama</h6></li>
                        <li><a class="dropdown-item active" href="#" data-sort="name-asc">A'dan Z'ye</a></li>
                        <li><a class="dropdown-item" href="#" data-sort="name-desc">Z'den A'ya</a></li>
                        <li><hr class="dropdown-divider"></li>
                        <li><a class="dropdown-item" href="#" data-sort="stock-desc">En Yüksek Stok</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <div class="ws-table-card">
        <div class="table-responsive">
            <table class="table ws-custom-table align-middle">
                <thead>
                    <tr>
                        <th class="ps-4">GÖRSEL</th>
                        <th>BARKOD</th>
                        <th>ÜRÜN ADI</th>
                        <th>KATEGORİ</th>
                        <th>STOK</th>
                        <th>BİRİM</th>
                        <th>DURUM</th>
                        <th class="text-end pe-4">İŞLEMLER</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody">
                    @* Static rows for now, but following the clean pattern *@
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/pages/product.js" asp-append-version="true"></script>
}