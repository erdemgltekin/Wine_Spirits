@model IEnumerable<Wine_Spirits.Models.Product>
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Ürün Envanteri";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/products-custom.css" asp-append-version="true" />
}

<div class="container-fluid py-4">
    <!-- Header Area: Search & Action -->
    <div class="inventory-header">
        <div class="row align-items-center g-3">
            <div class="col-md-4">
                <h1 class="h4 mb-1 fw-bold text-dark">Envanter Yönetimi</h1>
                <p class="text-muted small mb-0">Ürün stoklarını ve kategorilerini buradan yönetin.</p>
            </div>
            <div class="col-md-5">
                <div class="search-container">
                    <i data-lucide="search"></i>
                    <input type="text" id="inventorySearch" class="form-control search-input" placeholder="Ürün adı veya tedarikçi ara..." autocomplete="off">
                </div>
            </div>
            <div class="col-md-3 text-md-end">
                <a asp-action="Create" class="ws-btn ws-btn-primary shadow-sm">
                    <i data-lucide="plus"></i> Yeni Ürün Ekle
                </a>
            </div>
        </div>

        <!-- Category Filters (Populated by JS) -->
        <div id="filterPillsContainer" class="filter-pills">
            <div class="filter-pill active">Yükleniyor...</div>
        </div>
    </div>

    <!-- Inventory Table Container -->
    <div class="products-table-v2">
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead>
                    <tr>
                        <th>Ürün Bilgisi</th>
                        <th>Kategori</th>
                        <th>Menşei</th>
                        <th>Birim Fiyat</th>
                        <th>Stok Durumu</th>
                        <th class="text-end">İşlemler</th>
                    </tr>
                </thead>
                <tbody id="productsTableBody">
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status"></div>
                            <div class="text-muted small mt-2">Envanter yükleniyor...</div>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/products-manager.js" asp-append-version="true"></script>
}
