@model Wine_Spirits.Models.ViewModels.ProductsIndexViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Ürün Envanteri";
    Layout = "_Layout";
    var stats = Model?.Stats ?? new Wine_Spirits.Models.ViewModels.ProductStats();
}

@section Styles {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/flatpickr/dist/flatpickr.min.css">
    <link rel="stylesheet" href="~/css/products-custom.css" asp-append-version="true" />
}

<div class="ws-inventory-wrapper">
    @* Dashboard Kartları - Orijinal Mimari *@
    <div class="ws-stats-container">
        <div class="ws-stat-col"><ws-stat-card label="Toplam Ürün" value="0" icon="package" ws-stat="totalProducts" /></div>
        <div class="ws-stat-col"><ws-stat-card label="Kritik Stok" value="0" icon="alert-triangle" ws-stat="criticalStock" /></div>
        <div class="ws-stat-col"><ws-stat-card label="Envanter Değeri" value="₺0,00" icon="banknote" ws-stat="inventoryValue" /></div>
        <div class="ws-stat-col"><ws-stat-card label="Kategori" value="0" icon="layers" ws-stat="categoryCount" /></div>
    </div>

    <div class="ws-action-bar">
        <div class="ws-search-wrapper">
            <i data-lucide="search"></i>
            <input type="text" id="inventorySearch" class="ws-search-input" placeholder="Ürün adı veya koduna göre ara...">
        </div>
        <div class="ws-filters-group">
            <div class="ws-date-wrapper">
                <i data-lucide="calendar"></i>
                <input type="text" id="dateRangeFilter" class="ws-date-input" placeholder="Tarih Seçin">
            </div>
            <button type="button" class="btn btn-primary d-flex align-items-center gap-2 px-4" id="btnCreateNew">
                <i data-lucide="plus-circle"></i> Yeni Ürün
            </button>
        </div>
    </div>

    <div class="card border-0 shadow-sm overflow-hidden">
        <table class="table align-middle mb-0">
            <thead class="bg-light">
                <tr>
                    <th class="ps-4">Ürün Kodu</th>
                    <th>Ürün Bilgisi</th>
                    <th>Kategori</th>
                    <th>Menşei</th>
                    <th>Fiyat</th>
                    <th>Stok</th>
                    <th class="text-end pe-4">İşlem</th>
                </tr>
            </thead>
            <tbody id="productsTableBody">
                <tr><td colspan="7" class="text-center py-5">Veriler senkronize ediliyor...</td></tr>
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="productModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content ws-modal-content">
            <div id="productModalBody"></div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/flatpickr"></script>
    <script src="~/js/products-manager.js" asp-append-version="true"></script>
}