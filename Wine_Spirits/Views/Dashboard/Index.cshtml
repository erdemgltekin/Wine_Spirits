@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "_Layout";
}

@section Styles {
    @* Tek dosyada topladığımız yeni CSS *@
    <link rel="stylesheet" href="~/css/dashboard/dashboard.css" asp-append-version="true" />
}

<div class="dashboard-v2-container mt-4">

    @* --- HEADER: Başlık ve Sağa Yaslı Butonlar --- *@
    <div class="ws-dashboard-header">
        <div class="ws-page-title-area">
            <h2 class="fw-bold mb-1">Genel Bakış</h2>
            <p class="text-muted small mb-0">İşletmenizin performansını anlık olarak takip edin.</p>
            <div id="lastUpdated" class="text-muted mt-1" style="font-size: 11px;">
                <i data-lucide="clock" style="width:12px;"></i> Veriler yükleniyor...
            </div>
        </div>

        <div class="d-flex align-items-center gap-3">
            <button class="btn btn-outline-success d-flex align-items-center gap-2" onclick="GlobalUI.openModal('/Stock/Entry')">
                <i data-lucide="plus-circle" style="width:18px;"></i> Stok Girişi
            </button>
            <button class="btn btn-primary d-flex align-items-center gap-2 shadow-sm" onclick="GlobalUI.openModal('/Orders/Create')">
                <i data-lucide="shopping-cart" style="width:18px;"></i> Yeni Sipariş
            </button>
        </div>
    </div>

    @* --- DÖNEM FİLTRELERİ --- *@
    <div class="ws-filter-group mb-4">
        <button class="btn btn-primary" data-range="all" onclick="DashboardManager.changeRange('all')">Tümü</button>
        <button class="btn btn-outline-secondary" data-range="today" onclick="DashboardManager.changeRange('today')">Bugün</button>
        <button class="btn btn-outline-secondary" data-range="month" onclick="DashboardManager.changeRange('month')">Bu Ay</button>
    </div>

    @* --- İSTATİSTİK KARTLARI (ws-stat-card Tag Helper yapınıza uygun) --- *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card p-4 shadow-sm" ws-stat="totalProducts">
                <div class="ws-stat-icon-wrapper bg-indigo-50 text-indigo-600">
                    <i data-lucide="layers"></i>
                </div>
                <div class="text-muted small fw-medium">Toplam Ürün</div>
                <div class="h4 fw-bold mb-0 mt-1">...</div>
            </div>
        </div>
        <div class="col-xl-3 col-sm-6">
            <div class="ws-stat-card p-4 shadow-sm" ws-stat="totalStock">
                <div class="ws-stat-icon-wrapper bg-emerald-50 text-emerald-600">
                    <i data-lucide="box"></i>
                </div>
                <div class="text-muted small fw-medium">Toplam Stok</div>
                <div class="h4 fw-bold mb-0 mt-1">...</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ws-stat-card p-4 shadow-sm" ws-stat="monthlySales">
                <div class="ws-stat-icon-wrapper bg-blue-50 text-blue-600">
                    <i data-lucide="trending-up"></i>
                </div>
                <div class="text-muted small fw-medium">Dönem Cirosu</div>
                <div class="h4 fw-bold mb-0 mt-1">...</div>
            </div>
        </div>
        <div class="col-xl-3 col-md-6">
            <div class="ws-stat-card p-4 shadow-sm" ws-stat="totalCiro">
                <div class="ws-stat-icon-wrapper bg-rose-50 text-rose-600">
                    <i data-lucide="banknote"></i>
                </div>
                <div class="text-muted small fw-medium">Toplam Ciro</div>
                <div class="h4 fw-bold mb-0 mt-1">...</div>
            </div>
        </div>
    </div>

    @* --- GRAFİKLER --- *@
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="ws-card p-4 shadow-sm h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h6 class="fw-bold mb-0">Performans Analizi</h6>
                    <i data-lucide="more-horizontal" class="text-muted cursor-pointer"></i>
                </div>
                <div style="height: 320px;"><canvas id="premiumSalesChart"></canvas></div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ws-card p-4 shadow-sm h-100">
                <h6 class="fw-bold mb-4 text-center">Kategori Dağılımı</h6>
                <div style="height: 280px;"><canvas id="categoryChart"></canvas></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script src="~/js/dashboard/dashboard.js" asp-append-version="true"></script>
}