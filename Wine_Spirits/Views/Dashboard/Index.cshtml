@model Wine_Spirits.Models.ViewModels.DashboardViewModel
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers

@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "_Layout";
}

<!-- Dashboard V2 Wrapper -->
<div class="dashboard-v2-container mt-4">

<!-- Sayfa Başlığı -->
<div class="d-flex justify-content-between align-items-center mb-5 pb-2 border-bottom">
    <div>
        <h1 class="h3 fw-bold text-dark mb-1">Genel Bakış</h1>
        <p class="text-muted small mb-0">İşletmenizin performansını ve operasyonlarını buradan yönetin.</p>
    </div>
    <div class="d-flex gap-2">
        <a href="/Orders/Create" class="btn btn-indigo px-4 py-2 shadow-sm">
            <i data-lucide="shopping-cart" class="me-2" style="width:18px;"></i> Yeni Sipariş
        </a>
        <a href="/StockMovements/Create?type=Giriş" class="btn btn-white border px-4 py-2 shadow-sm" data-drawer="true" data-title="Stok Giriş">
            <i data-lucide="plus-circle" class="me-2 text-success" style="width:18px;"></i> Stok Girişi
        </a>
        <div class="dropdown ms-2">
            <button class="btn btn-white border shadow-sm px-3 py-2" type="button">
                <i data-lucide="calendar" class="me-1" style="width:16px;"></i> Filtre <i data-lucide="chevron-down" class="ms-1" style="width:14px;"></i>
            </button>
        </div>
    </div>
</div>

<!-- Stats Grid V2 -->
<div class="row g-4 mb-5">
    <!-- Toplam Ürün -->
    <div class="col-xl-3 col-sm-6">
        <div class="card card-premium shadow-sm border-0 stat-card">
            <div class="card-body p-0 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="category-accent bg-indigo-50 text-indigo-600">
                        <i data-lucide="layers"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small fw-medium mb-1">Toplam Ürün</div>
                    <div class="h4 fw-bold mb-0">@Model.TotalProducts</div>
                    <div class="text-xs text-muted mt-1">Aktif Ürün Sayısı</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Toplam Stok -->
    <div class="col-xl-3 col-sm-6">
        <div class="card card-premium shadow-sm border-0 stat-card">
            <div class="card-body p-0 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="category-accent bg-emerald-50 text-emerald-600">
                        <i data-lucide="box"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small fw-medium mb-1">Toplam Stok</div>
                    <div class="h4 fw-bold mb-0">@Model.TotalStock.ToString("N0")</div>
                    <div class="text-xs text-muted mt-1">Güncel Envanter</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Aylık Satış Trendi -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-premium shadow-sm border-0 stat-card">
            <div class="card-body p-0 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="category-accent bg-blue-50 text-blue-600">
                        <i data-lucide="trending-up"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small fw-medium mb-1">Ciro (Bu Ay)</div>
                    <div class="h4 fw-bold mb-0 text-indigo-700">₺@Model.MonthlySales.LastOrDefault().ToString("N2")</div>
                    <div class="text-xs text-muted mt-1">Performans Analizi</div>
                </div>
            </div>
        </div>
    </div>

    <!-- Envanter Değeri -->
    <div class="col-xl-3 col-md-6">
        <div class="card card-premium shadow-sm border-0 stat-card">
            <div class="card-body p-0 d-flex flex-column justify-content-between">
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div class="category-accent bg-rose-50 text-rose-600">
                        <i data-lucide="banknote"></i>
                    </div>
                </div>
                <div>
                    <div class="text-muted small fw-medium mb-1">Toplam Ciro (Genel)</div>
                    <div class="h4 fw-bold mb-0 text-dark">₺@Model.TotalInventoryValue.ToString("N2")</div>
                    <div class="text-xs text-muted mt-1">Nihai Portfolyo Değeri</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (Model.CriticalStockProducts.Any())
{
    <!-- ... mevcut kritik stok paneli ... -->
}

<div class="row g-4 mb-5">
    <!-- Ana Premium Satış Grafiği -->
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center border-bottom">
                <div>
                    <h6 class="card-title mb-1 fw-bold">Aylık Performans Analizi</h6>
                    <p class="text-xs text-muted mb-0">Satış ve Brüt Kâr Trendi</p>
                </div>
            </div>
            <div class="card-body p-4 position-relative">
                <div class="chart-container-locked" style="height: 300px;">
                    <canvas id="premiumSalesChart" class="@(!Model.MonthlySales.Any(s => s > 0) ? "chart-faded" : "")"></canvas>
                </div>
            </div>
        </div>
    </div>

    <!-- Yan Analizler (Küçültülmüş) -->
    <div class="col-lg-4">
        <div class="card border-0 shadow-sm mb-4" style="height: calc(50% - 12px);">
            <div class="card-header bg-white py-2 border-0">
                <h6 class="card-title mb-0 fw-bold small">Ürün Gamı Dağılımı</h6>
            </div>
            <div class="card-body p-3">
                <div style="height: 140px;">
                    <canvas id="categoryChart"></canvas>
                </div>
            </div>
        </div>
        <div class="card border-0 shadow-sm" style="height: calc(50% - 12px);">
            <div class="card-header bg-white py-2 border-0">
                <h6 class="card-title mb-0 fw-bold small">Coğrafi Analiz</h6>
            </div>
            <div class="card-body p-3">
                <div style="height: 140px;">
                    <canvas id="countryChart"></canvas>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-4 mb-5">
    <!-- Stok Trendi ve Son Siparişler -->
    <div class="col-lg-12">
        <div class="card border-0 shadow-sm mb-4">
            <div class="card-header bg-white py-3 border-bottom">
                <h6 class="card-title mb-1 fw-bold">Envanter Hareket Trendi</h6>
                <p class="text-xs text-muted mb-0">Son 10 Günlük Net Stok Değişimi</p>
            </div>
            <div class="card-body p-4">
                <div class="chart-container-locked" style="height: 180px;">
                    <canvas id="stockTrendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Son Siparişler Tablosu (Premium Badges) -->
        <div class="card border-0 shadow-sm" style="border-radius: 20px;">
            <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-4">
                <div>
                    <h5 class="card-title mb-1 fw-bold text-dark h6">Son Siparişler</h5>
                    <p class="text-xs text-muted mb-0">Sistem üzerinden gerçekleşen en son satış operasyonları</p>
                </div>
                <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-light border px-3">
                    Tüm Siparişler <i data-lucide="arrow-right" class="ms-1" style="width: 14px;"></i>
                </a>
            </div>
            <div class="table-responsive border-0">
                <table class="table table-hover align-middle mb-0">
                    <thead class="bg-white">
                        <tr>
                            <th class="ps-4">Sipariş No</th>
                            <th>Müşteri</th>
                            <th>Ürün</th>
                            <th>Miktar</th>
                            <th>Durum</th>
                            <th>Tutar</th>
                            <th class="pe-4 text-end">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Model.RecentOrderItems.Any())
                        {
                            var random = new Random();
                            var statuses = new[] { "Hazırlanıyor", "Kargoda", "Teslim Edildi", "İptal" };
                            var statusClasses = new[] { "badge-status-pending", "badge-status-completed", "badge-status-completed", "badge-status-canceled" };
                            // Not: completed status is used for blue too in site.css, let's fix that or use it as is.
                            // Better yet, use specific classes for each simulated status.

                            @foreach (var item in Model.RecentOrderItems)
                            {
                                var statusIndex = random.Next(statuses.Length);
                                var status = statuses[statusIndex];
                                var indicatorClass = status switch {
                                    "Hazırlanıyor" => "pending",
                                    "Kargoda" => "shipping",
                                    "Teslim Edildi" => "completed",
                                    "İptal" => "canceled",
                                    _ => "pending"
                                };

                                <tr style="border-bottom: 1px solid #f1f5f9;">
                                    <td class="ps-4">
                                        <span class="fw-bold text-dark">#@item.Order.Id.ToString().Substring(0, 8).ToUpper()</span>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="bg-light rounded-circle p-2 me-2 d-flex align-items-center justify-content-center" style="width: 32px; height: 32px;">
                                                <span class="text-xs fw-bold text-indigo-600">@item.Order.Customer.Name[0]@item.Order.Customer.Lastname[0]</span>
                                            </div>
                                            <div>
                                                <div class="fw-semibold text-dark small">@item.Order.Customer.Name @item.Order.Customer.Lastname</div>
                                                <div class="text-xs text-muted">@item.Order.Customer.Email</div>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="small text-dark">@item.Product.ProductDefinition.Name</div>
                                    </td>
                                    <td class="small">@item.Quantity @item.Product.Unit?.Name</td>
                                    <td>
                                        @{
                                            var statusClass = item.Order.Id.GetHashCode() % 4; // Simülasyon yerine gerçek statü eklenebilir
                                            var statusColor = statusClass == 0 ? "pending" : (statusClass == 1 ? "shipping" : "completed");
                                            var statusText = statusClass == 0 ? "Hazırlanıyor" : (statusClass == 1 ? "Kargoda" : "Teslim Edildi");
                                        }
                                        <span class="status-indicator @statusColor"></span>
                                        <span class="small text-dark fw-medium">@statusText</span>
                                    </td>
                                    <td>
                                        <span class="fw-bold text-indigo-600">₺@item.TotalPrice.ToString("N2")</span>
                                    </td>
                                    <td class="pe-4 text-end">
                                        <a href="/Orders/Details/@item.OrderId" class="btn btn-sm btn-white border px-3">Detay</a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted small">Henüz sipariş kaydı bulunmuyor.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div> <!-- container-fluid end -->

@section Scripts {
    <!-- Chart.js Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- Dashboard Grafik Mantığı -->
    <script src="~/js/dashboard-charts.js" asp-append-version="true"></script>
    <!-- Dashboard Aktivite Mantığı -->
    <script src="~/js/dashboard-activity.js" asp-append-version="true"></script>
    <!-- Dashboard Premium Mantığı -->
    <script src="~/js/dashboard-premium.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Parasal değerleri formatla (₺ TRY)
            if (typeof formatCurrency === 'function') {
                document.querySelectorAll('.js-format-currency').forEach(el => {
                    const val = parseFloat(el.getAttribute('data-value') || el.textContent.replace(/[^0-9.-]+/g,""));
                    if (!isNaN(val)) el.textContent = formatCurrency(val);
                });
            }

            // Dashboard verilerini JSON olarak JS nesnesine aktarıyoruz.
            const dashboardData = {
                categoryLabels: @Html.Raw(Json.Serialize(Model.CategoryLabels)),
                categoryValues: @Html.Raw(Json.Serialize(Model.CategoryValues)),
                countryLabels: @Html.Raw(Json.Serialize(Model.CountryLabels)),
                countryValues: @Html.Raw(Json.Serialize(Model.CountryValues)),
                // Premium Veriler
                monthlyLabels: @Html.Raw(Json.Serialize(Model.MonthlyLabels)),
                monthlySales: @Html.Raw(Json.Serialize(Model.MonthlySales)),
                monthlyProfit: @Html.Raw(Json.Serialize(Model.MonthlyProfit)),
                categoryColors: @Html.Raw(Json.Serialize(Model.CategoryColors)),
                stockTrendLabels: @Html.Raw(Json.Serialize(Model.StockTrendLabels)),
                stockTrendValues: @Html.Raw(Json.Serialize(Model.StockTrendValues))
            };

            // dashboard-charts.js içindeki DashboardManager'ı başlatıyoruz.
            if (typeof DashboardManager !== 'undefined') {
                DashboardManager.init(dashboardData);
            }

            // dashboard-premium.js içindeki DashboardPremium'u başlatıyoruz.
            if (typeof DashboardPremium !== 'undefined') {
                DashboardPremium.init(dashboardData);
            }

            // dashboard-activity.js içindeki DashboardActivity'yi başlatıyoruz.
            if (typeof DashboardActivity !== 'undefined') {
                DashboardActivity.init();
            }
            
            // Lucide ikonlarını canlandırıyoruz.
            if (typeof lucide !== 'undefined') {
                lucide.createIcons();
            }

            // Bootstrap tooltips başlat
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
}
