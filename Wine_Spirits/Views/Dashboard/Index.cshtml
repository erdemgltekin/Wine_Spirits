@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    ViewData["Title"] = "Yönetim Paneli";
    Layout = "_Layout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard/dashboard.css" asp-append-version="true" />
    @* Yeni Aksiyon Butonları CSS *@
    <link rel="stylesheet" href="~/css/dashboard/dashboard-actions.css" asp-append-version="true" />
}

<div class="dashboard-v2-container mt-4">

    @* Page Header + Son Güncelleme + Aksiyon Butonları *@
    <ws-page-header title="Genel Bakış" subtitle="İşletmenizin tüm operasyonlarını tek bir ekrandan izleyin ve yönetin.">
        <div class="dashboard-actions-container">
            <span id="lastUpdated" class="text-muted small d-none d-md-inline me-2">
                <i data-lucide="clock" style="width:14px;height:14px;" class="me-1"></i>Son Güncelleme: --:--
            </span>
            
            @* Yeni Sipariş Butonu - Primary Style *@
            <a asp-controller="Orders" asp-action="Create" class="ws-btn-modern ws-btn-primary-modern shadow-sm">
                <i data-lucide="shopping-cart"></i> Yeni Sipariş
            </a>
            
            @* Stok Girişi Butonu - Outline Success Style *@
            <a asp-controller="StockMovement" asp-action="Index" asp-route-type="Giriş" class="ws-btn-modern ws-btn-outline-success-modern shadow-sm">
                <i data-lucide="plus-circle"></i> Stok Girişi
            </a>
        </div>
    </ws-page-header>

    @* ────────────────────────────────────
       TARİH FİLTRE BUTONLARI
       ──────────────────────────────────── *@
    <div class="d-flex align-items-center gap-2 mb-4">
        <span class="text-muted small fw-medium me-1">Dönem:</span>
        <button class="btn btn-sm btn-primary active" data-range="all" onclick="DashboardManager.changeRange('all')">Tümü</button>
        <button class="btn btn-sm btn-outline-secondary" data-range="today" onclick="DashboardManager.changeRange('today')">Bugün</button>
        <button class="btn btn-sm btn-outline-secondary" data-range="week" onclick="DashboardManager.changeRange('week')">Bu Hafta</button>
        <button class="btn btn-sm btn-outline-secondary" data-range="month" onclick="DashboardManager.changeRange('month')">Bu Ay</button>
        <button class="btn btn-sm btn-outline-secondary" data-range="year" onclick="DashboardManager.changeRange('year')">Bu Yıl</button>
    </div>

    @* ────────────────────────────────────
       İSTATİSTİK KARTLARI
       ws-stat → JS setStat → .h4.textContent
       ──────────────────────────────────── *@
    <div class="row g-4 mb-4">
        <div class="col-xl-3 col-sm-6">
            <ws-stat-card label="Toplam Ürün" value="..." icon="layers"
                          icon-class="bg-indigo-50 text-indigo-600" ws-stat="totalProducts" />
        </div>
        <div class="col-xl-3 col-sm-6">
            <ws-stat-card label="Toplam Stok" value="..." icon="box"
                          icon-class="bg-emerald-50 text-emerald-600" ws-stat="totalStock" />
        </div>
        <div class="col-xl-3 col-md-6">
            <ws-stat-card label="Ciro (Dönem)" value="..." icon="trending-up"
                          icon-class="bg-blue-50 text-blue-600" ws-stat="monthlySales" />
        </div>
        <div class="col-xl-3 col-md-6">
            <ws-stat-card label="Toplam Ciro" value="..." icon="banknote"
                          icon-class="bg-rose-50 text-rose-600" ws-stat="totalCiro" />
        </div>
    </div>

    @* ────────────────────────────────────
       GRAFİKLER
       ──────────────────────────────────── *@
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            <div class="ws-card border-0 shadow-sm">
                <div class="card-header bg-white py-3 border-bottom">
                    <h6 class="card-title mb-0 fw-bold">Aylık Performans Analizi</h6>
                </div>
                <div class="card-body p-3">
                    <div class="ws-chart-main">
                        <canvas id="premiumSalesChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="ws-card border-0 shadow-sm">
                <div class="card-header bg-white py-2 border-0">
                    <h6 class="card-title mb-0 fw-bold small">Ürün Gamı Dağılımı</h6>
                </div>
                <div class="card-body p-3">
                    <div class="ws-chart-small">
                        <canvas id="categoryChart"></canvas>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* ────────────────────────────────────
       SON SİPARİŞLER + EXCEL EXPORT
       ──────────────────────────────────── *@
    <div class="row g-4 mb-5">
        <div class="col-12">
            <div class="ws-card border-0 shadow-sm">
                <div class="card-header bg-white border-bottom d-flex justify-content-between align-items-center py-3">
                    <h6 class="card-title mb-0 fw-bold">Son Siparişler</h6>
                    <div class="d-flex gap-2">
                        <button class="btn btn-sm btn-outline-success" onclick="DashboardManager.exportToExcel()" title="Excel olarak indir">
                            <i data-lucide="download" style="width:14px;height:14px;"></i> Excel
                        </button>
                        <a asp-controller="Orders" asp-action="Index" class="btn btn-sm btn-outline-secondary">
                            Tüm Siparişler <i data-lucide="arrow-right"></i>
                        </a>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table align-middle mb-0" id="ordersTable">
                        <thead>
                            <tr>
                                <th>No</th>
                                <th>Müşteri</th>
                                <th>Ürün</th>
                                <th>Miktar</th>
                                <th>Durum</th>
                                <th>Tutar</th>
                                <th class="text-end">İşlem</th>
                            </tr>
                        </thead>
                        <tbody id="ordersTableBody">
                            <tr><td colspan="7" class="text-center py-5 text-muted">Veriler yükleniyor...</td></tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @* Grafik kütüphanesi *@
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
    @* 1. Grafik ayarlarını içeren dosya *@
    <script src="~/js/dashboard/dashboard-charts.js" asp-append-version="true"></script>
    @* 2. Tablo verilerini ve istatistikleri çeken dosya *@
    <script src="~/js/dashboard/dashboard-activity.js" asp-append-version="true"></script>
    @* 3. Yeni Aksiyon Butonları JS *@
    <script src="~/js/dashboard/dashboard-actions.js" asp-append-version="true"></script>
}
