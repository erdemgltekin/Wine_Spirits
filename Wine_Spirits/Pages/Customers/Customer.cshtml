@page
@model Wine_Spirits.Pages.Customers.CustomerModel
@{
    ViewData["Title"] = "Müşteriler";
}
<h1>@ViewData["Title"]</h1>

<div class="container-fluid">
    <!-- Add Product -->
    <div class="d-flex justify-content-end">
        <a asp-page="Create" class="btn btn-primary">
            <i data-lucide="users" class="bi bi-person-plus me-1"></i>
            Yeni Müşteri Ekle
        </a>
    </div>
    <!-- Search Box -->
    <div class="card">
        <div class="d-flex gap-3">
            <div class="search-input flex-grow-1">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" class="form-control" id="searchInput" placeholder="Müşteri Ara (Müşteri Kodu,Ad,E-posta,Telefon)..." />
            </div>
        </div>
    </div>
    <!-- Customer List-->
    <div class="table-container">
        <table class="table table-stripped table-hover">
            <thead>
                <tr>
                    <th>MÜŞTERİ KODU</th>
                    <th>MÜŞTERİ ADI</th>
                    <th>İLETİŞİM</th>
                    <th>ADRES</th>
                    <th>VERGİ BİLGİLERİ</th>
                    <th>SİPARİŞ/HARCAMA</th>
                    <th>DURUM</th>
                </tr>
            <tbody>
                <tr>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                    <td></td>
                </tr>
            </tbody>
        </table>
    </div>
 </div>
